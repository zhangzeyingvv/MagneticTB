Notebook[{Cell[CellGroupData[{Cell["readHR", "ObjectName"], Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["readHR[file]"], "InlineFormula"], "  ", "读取 Wannier90 HR 文件，返回晶格平移和实空间 hopping 矩阵。"}], "Usage"], Cell["Wannier90 HR 文件中每个晶格平移 R 都对应一个实空间 hopping 矩阵 H(R)。它的行、列顺序就是写出该文件时采用的 Wannier 轨道顺序。", "Notes"], Cell["在返回这些矩阵之前，readHR 会检查文件头、简并度、平移向量、轨道编号和复矩阵元。格式错误或内容不完整的文件会被拒绝。", "Notes"], Cell["把 readHR 返回的 Association 交给 buildBlochHamiltonian 即可恢复 H(k)。需要反复计算时，可以定义 h[k_List] := buildBlochHamiltonian[hrData,k]。", "Notes"], Cell["随后可用 ncell 只保留指定实空间范围内的平移。", "Notes"], Cell[BoxData[GridBox[{{Cell["      ", "TableRowIcon"], "\"prec\"", "10^-10", Cell["非负数值阈值，用于在解析后 Chop 掉矩阵实部和虚部中的小量。", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"ncell\"", "All", Cell["All 保留全部平移；非负整数 n 只保留最大平移分量绝对值不超过 n 的晶胞。", "TableText"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxDividers -> {"Rows" -> {{False}}}, GridBoxSpacings -> {"Columns" -> {Offset[0.27999999999999997], {Offset[0.7]}, Offset[0.27999999999999997]}, "Rows" -> {Offset[0.2], {Offset[0.8]}, Offset[0.2]}}]], "3ColumnTableMod"]}, Open]], Cell[CellGroupData[{Cell["范例初始化", "ExamplesInitializationSection"], Cell[BoxData["Needs[\"MagneticTB`\"]"], "ExampleInitialization"]}, Open]], Cell[CellGroupData[{Cell["基本范例", "PrimaryExamplesSection"], Cell["用 hop 写出石墨烯 HR 文件，再用 readHR 读回、恢复 H(k)，并显示 Gamma 点的 Hamiltonian：", "ExampleText"], Cell[BoxData["grapheneOperations = msgop[gray[191]];\ninit[\n  lattice -> {\n    {a, 0, 0},\n    {-a/2, Sqrt[3] a/2, 0},\n    {0, 0, c}\n  },\n  lattpar -> {a -> 1, c -> 3},\n  wyckoffposition -> {\n    {{1/3, 2/3, 0}, {0, 0, 0}}\n  },\n  symminformation -> grapheneOperations,\n  basisFunctions -> {{\"pz\"}},\n  InitialBondShells -> 3,\n  GenerateSymmetryGroup -> False\n];\nScan[symham, {1, 2, 3}];\nhrFile = FileNameJoin[{$TemporaryDirectory, \"graphene_hr.dat\"}];\nhop[{1, 2, 3}, {e1 -> 0.05, r1 -> 0.02, t1 -> 0.5}, \"hrExport\" -> hrFile, \"wcc\" -> Automatic];\nhrData = readHR[hrFile];\nhrHamiltonian[k_List] := buildBlochHamiltonian[hrData, k];\nMatrixForm@hrHamiltonian[{0, 0, 0}]"], "Input"], Cell[BoxData[TagBox[RowBox[{"(", "⁠", GridBox[{{"0.17`", "1.5`"}, {"1.5`", "0.17`"}}, RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> Center], "⁠", ")"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]], "Output"]}, Open]], Cell[CellGroupData[{Cell["更多范例", "ExtendedExamplesSection", CellTags -> "ExtendedExamples"], Cell[CellGroupData[{Cell["选项", "ExampleSection"], Cell[CellGroupData[{Cell["prec", "ExampleSubsection"], Cell["\"prec\" -> 10^-12 把低于该阈值的对称性生成 hopping 元截为零；10^-13 的非 onsite hopping 变成精确零：", "ExampleText"], Cell[BoxData["tinyHRFile = FileNameJoin[{$TemporaryDirectory, \"graphene_tiny_hr.dat\"}];\nhop[\n  {1,2,3}, {e1 -> 1., r1 -> 10^-13, t1 -> 10^-13},\n  \"hrExport\" -> tinyHRFile, \"wcc\" -> Automatic\n];\ntinyHRData = readHR[tinyHRFile, \"prec\" -> 10^-12];\nMatrixForm@First@Pick[\n  tinyHRData[\"HoppingMatrices\"],\n  tinyHRData[\"Translations\"],\n  Except[{0,0,0}]\n]"], "Input"], Cell[BoxData[TagBox[RowBox[{"(", "⁠", GridBox[{{"0", "0"}, {"0", "0"}}, RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> Center], "⁠", ")"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]], "Output"]}, Open]], Cell[CellGroupData[{Cell["ncell", "ExampleSubsection"], Cell["\"ncell\" -> 0 在完整 HR 文件解析并验证后只保留 onsite 平移：", "ExampleText"], Cell[BoxData["readHR[hrFile, \"ncell\" -> 0][\"Translations\"]"], "Input"], Cell[BoxData[RowBox[{"{", RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], "}"}]], "Output"]}, Open]]}, Open]]}, Open]], Cell[CellGroupData[{Cell["相关函数", "SeeAlsoSection"], Cell[TextData[{ButtonBox["hop", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/hop"], " ▪ ", ButtonBox["symham", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/symham"]}], "SeeAlso"]}, Open]], Cell[CellGroupData[{Cell["相关指南", "MoreAboutSection"], Cell[TextData[{ButtonBox["MagneticTB", BaseStyle -> "Lin