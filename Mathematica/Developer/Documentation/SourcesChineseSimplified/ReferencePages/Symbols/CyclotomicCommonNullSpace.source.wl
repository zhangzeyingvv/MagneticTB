Notebook[{Cell[CellGroupData[{Cell["CyclotomicCommonNullSpace", "ObjectName"], Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["CyclotomicCommonNullSpace[{matrix1,matrix2,...}]"], "InlineFormula"], "  ", "接受普通精确 Wolfram Language 矩阵，并返回其公共零空间的行基。"}], "Usage"], Cell["这是普通精确矩阵的主入口。若返回列表为 rows，则 Transpose[rows] 是列基矩阵，并且每个输入块 Ai 都精确满足 Ai . Transpose[rows] == 0。", "Notes"], Cell["支持的标量输入包括精确整数和有理数、I、精确有理数的平方根、用有理角 Exp、Sin 或 Cos 写出的单位根、Conjugate，以及这些表达式的精确和、积与受支持幂。机器数、符号参数以及一般立方根等不受支持的代数数会返回 Failure。", "Notes"], Cell["所有矩阵必须具有相同列数。空约束必须指定 CoordinateDimension，因为此时没有矩阵可供推断列数。", "Notes"], Cell["函数编译一个公共精确域，并调用生产用迭代公共核算法。它不使用内置 NullSpace 或 RowReduce，也绝不会改用浮点、SVD、堆叠约束或其他 fallback。", "Notes"], Cell[BoxData[GridBox[{{Cell["      ", "TableRowIcon"], "\"CoordinateDimension\"", "Automatic", Cell["向量坐标数。Automatic 从非空输入推断公共列数；约束列表为空时必须显式给出非负整数。", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"MaxCyclotomicDegree\"", "128", Cell["精确分圆域次数的正整数上限。超过上限时返回 Failure，而不使用近似算术。", "TableText"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxDividers -> {"Rows" -> {{False}}}, GridBoxSpacings -> {"Columns" -> {Offset[0.27999999999999997], {Offset[0.7]}, Offset[0.27999999999999997]}, "Rows" -> {Offset[0.2], {Offset[0.8]}, Offset[0.2]}}]], "3ColumnTableMod"]}, Open]], Cell[CellGroupData[{Cell["范例初始化", "ExamplesInitializationSection"], Cell[BoxData["Needs[\"MagneticTB`\"]"], "ExampleInitialization"]}, Open]], Cell[CellGroupData[{Cell["基本范例", "PrimaryExamplesSection"], Cell["求两个普通精确约束块的公共零空间，其中含三个相互独立的平方根。显示的两个残差矩阵都精确为零：", "ExampleText"], Cell[BoxData["constraintBlocks = {\n  {\n    {1, 0, 0, -Sqrt[2], 0},\n    {0, 1, 0, -Sqrt[3], 0}\n  },\n  {{0, 0, 1, -Sqrt[5], 0}}\n};\ncommonRows = CyclotomicCommonNullSpace[constraintBlocks];\n{\n  MatrixForm[commonRows],\n  MatrixForm /@ (# . Transpose[commonRows] & /@ constraintBlocks)\n}"], "Input"], Cell[BoxData[RowBox[{"{", RowBox[{TagBox[RowBox[{"(", "⁠", GridBox[{{SqrtBox["2"], SqrtBox["3"], SqrtBox["5"], "1", "0"}, {"0", "0", "0", "0", "1"}},