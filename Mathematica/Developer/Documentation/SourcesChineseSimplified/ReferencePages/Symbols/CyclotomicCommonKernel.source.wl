], ",", RowBox[{"", RowBox[{RowBox[{"\"iteration_nullities\"", "", RowBox[{"{", RowBox[{"3", ",", "2", ",", "1"}], "}"}]}], ",", RowBox[{"\"rank\"", "", "2"}], ",", RowBox[{"\"nullity\"", "", "1"}], ",", RowBox[{"\"exact_residual_verified\"", "", "True"}]}], ""}]}], "}"}]], "Output"]}, Open]], Cell[CellGroupData[{Cell["更多范例", "ExtendedExamplesSection", CellTags -> "ExtendedExamples"], Cell[CellGroupData[{Cell["属性和关系", "ExampleSection"], Cell["没有约束块时，每个坐标都是自由的。行基为单位矩阵，iteration_nullities 只含初始维数：", "ExampleText"], Cell[BoxData["emptyCompiled = CompileCyclotomicMatrices[<|\n  \"coordinate_dimension\" -> 3,\n  \"constraints\" -> {}\n|>];\nemptyResult = CyclotomicCommonKernel[emptyCompiled];\nemptyRows = RestoreCyclotomicExpression[\n  emptyResult[\"nullspace_rows\"]\n];\n{\n  MatrixForm@Partition[\n    emptyRows[\"entries\"], emptyRows[\"columns\"]\n  ],\n  KeyTake[emptyResult, {\"iteration_nullities\", \"rank\", \"nullity\"}]\n}"], "Input"], Cell[BoxData[RowBox[{"{", RowBox[{TagBox[RowBox[{"(", "⁠", GridBox[{{"1", "0", "0"}, {"0", "1", "0"}, {"0", "0", "1"}}, RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> Center], "⁠", ")"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]], ",", RowBox[{"", RowBox[{RowBox[{"\"iteration_nullities\"", "", RowBox[{"{", "3", "}"}]}], ",", RowBox[{"\"rank\"", "", "0"}], ",", RowBox[{"\"nullity\"", "", "3"}]}], ""}]}], "}"}]], "Output"], Cell["坐标维数为零的问题，其秩与零度均为零，并保留一个 0×0 基矩阵：", "ExampleText"], Cell[BoxData["zeroCompiled = CompileCyclotomicMatrices[<|\n  \"coordinate_dimension\" -> 0,\n  \"constraints\" -> {}\n|>];\nzeroResult = CyclotomicCommonKernel[zeroCompiled];\n{\n  KeyTake[zeroResult, {\"iteration_nullities\", \"rank\", \"nullity\"}],\n  KeyTake[\n    RestoreCyclotomicExpression[zeroResult[\"basis_matrix\"]],\n    {\"rows\", \"columns\", \"entries\"}\n  ]\n}"], "Input"], Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"", RowBox[{RowBox[{"\"iteration_nullities\"", "", RowBox[{"{", "0", "}"}]