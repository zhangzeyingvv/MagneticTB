Notebook[{Cell[CellGroupData[{Cell["compareBand", "ObjectName"], Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["compareBand[path,npoint,H,rules,referenceBands]"], "InlineFormula"], "  ", "沿带标签的路径叠加数值紧束缚能带与输入的参考能带。"}], "Usage"], Cell["path 是非空列表，每段含数值三分量倒空间分数坐标端点及其标签；npoint 必须为正整数。", "Notes"], Cell["referenceBands 使用 vaspEig 记录格式，必须按同一线段顺序恰好包含 Length[path] npoint 条记录；紧束缚曲线包含每段的两个端点。", "Notes"], Cell["rules 可以是规则列表或 Association。应用 rules，并把每个路径动量乘以 2 Pi 后，H 必须成为数值方阵。", "Notes"], Cell["返回 Labeled 图：紧束缚能带为紫色，参考能带为蓝色；plotRange 只改变可见能量区间。", "Notes"], Cell["H、path、npoint、rules 或 referenceBands 格式错误、记录数不一致或 H 仍非数值时，compareBand 给出消息并返回 $Failed；函数不会修补输入，也不会改用近似结果。", "Notes"], Cell[BoxData[GridBox[{{Cell["      ", "TableRowIcon"], "plotRange", "All", Cell["All 显示完整叠加图；{emin,emax} 只限制可见能量区间。", "TableText"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxDividers -> {"Rows" -> {{False}}}, GridBoxSpacings -> {"Columns" -> {Offset[0.27999999999999997], {Offset[0.7]}, Offset[0.27999999999999997]}, "Rows" -> {Offset[0.2], {Offset[0.8]}, Offset[0.2]}}]], "3ColumnTableMod"]}, Open]], Cell[CellGroupData[{Cell["范例初始化", "ExamplesInitializationSection"], Cell[BoxData["Needs[\"MagneticTB`\"]"], "ExampleInitialization"]}, Open]], Cell[CellGroupData[{Cell["基本范例", "PrimaryExamplesSection"], Cell["读取 VASP 能带，并用对称性生成模型：", "ExampleText"], Cell[BoxData["eigenvalFile = FileNameJoin[{NotebookDirectory[], \"EIGENVAL\"}];\nvaspBands = vaspEig[eigenvalFile, -0.0072, 1, 21, 23];\n\ninit[\n  lattice -> {\n    {a, 0, 0},\n    {-a/2, Sqrt[3] a/2, 0},\n    {0, 0, c}\n  },\n  lattpar -> {a -> 1, c -> 10},\n  wyckoffposition -> {{{2/3, 1/3, 0}, {0, 0, 0}}},\n  symminformation -> Take[msgop[gray[156]], 6],\n  basisFunctions -> {{\"dz2\", \"dxy\", \"dx2-y2\"}},\n  InitialBondShells -> 3\n];\nfittingHamiltonian = symham[1] + symham[2];\nfittingPath = {\n  {{{0, 0, 0}, {1/2, 0, 0}}, {\"\\[CapitalGamma]\", \"M\"}},\n  {{{1/2, 0, 0}, {1/3, 1/3, 0}}, {\"M\", \"K\"}},\n  {{{1/3, 1/3, 0}, {0, 0, 0}}, {\"K\", \"\\[CapitalGamma]\"}}\n};\ninitialRules = {\n  e1 -> 0.915, e2 -> 0.685,\n  t1 -> 0.1, t2 -> 0.09, t3 -> 0.1,\n  t4 -> -0.38, t5 -> 0.34, t6 -> 0.245,\n  t7 -> 0.565, t8 -> 0.305, t9 -> 0.365\n};"], "Input"], Cell["先拟合最近邻模型，再加入第二近邻 hopping，并重新拟合全部 90 条记录：", "ExampleText"], Cell[BoxData["nearestFit = fittingTB[\n  fittingHamiltonian, vaspBands,\n  Range[Length[vaspBands]], initialRules\n];\nsecondNeighborHamiltonian = fittingHamiltonian + symham[3];\nsecondNeighborInitialRules = Join[\n  nearestFit[\"FittedParams\"],\n  Thread[{r1, r2, r3, r4, r5, r6, r7, r8, r9, r10} -> 0.]\n];\nfitResult = fittingTB[\n  secondNeighborHamiltonian, vaspBands,\n  Range[Length[vaspBands]], secondNeighborInitialRules\n];"], "Input"], Cell["在 -1.5 至 3 eV 范围内同时显示选取的三条 VASP 能带和拟合后的第二近邻模型：", "ExampleText"], Cell[BoxData["compareBand[\n  fittingPath, 30, secondNeighborHamiltonian,\n  fitResult[\"FittedParams\"], vaspBands,\n  plotRange -> {-1.5, 3}\n]"], "Input"], Cell[BoxData[TemplateBox[{GraphicsBox[{{{}, InterpretationBox[{TagBox[{{{}, {}, TagBox[{Hue[0.67, 0.6, 0.6], Directive[PointSize[NCache[1/90, 0.011111111111111112]], AbsoluteThickness[2], RGBColor[0.5, 0, 0.5]], LineBox[{{0., -0.29911857783477225}, {1., -0.3042363453144741}, {2., -0.3194144078122972}, {3., -0.34428790174814966}, {4., -0.37836539364898003}, {5., -0.4210272412893823}, {6., -0.4715116517809293}, {7., -0.528894736165324}, {8., -0.5920719973019232}, {9., -0.6597486597123272}, {10., -0.7304450167983902}, {11., -0.8025206564374989}, {12., -0.8742184103780919}, {13., -0.943725754190128}, {14., -1.0092488071128962}, {15., -1.0690925203203872}, {16., -1.1217402637945288}, {17., -1.1659266800393215}, {18., -1.2006990195310574}, {19., -1.2254638042863841}, {20., -1.2400172325697225}, {21., -1.244558990829027}, {22., -1.239689926523356}, {23., -1.2263942784215833}, {24., -1.206006840086991}, {25., -1.1801646111584785}, {26., -1.1507413874631263}, {27., -1.1197628383497698}, {28., -1.0892997539563225}, {29., -1.061339408816