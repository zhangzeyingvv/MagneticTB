Notebook[{Cell[CellGroupData[{Cell["plotSurfaceSpectrum", "ObjectName"], Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["plotSurfaceSpectrum[data,path,{emin,emax}]"], "InlineFormula"], "  ", "plotSurfaceSpectrum 沿二维表面动量路径与均匀能量网格绘制半无限体系的 -Im Tr[Gsurface]/Pi。晶胞轴 1、2 张成表面，轴 3 为堆垛方向；每个网格点都调用现有主层 decimation，不收敛时明确失败。MomentumSubdivisions、EnergyPoints、CellMatrix、Broadening、Tolerance、MaxIterations、Surface 与 HermiticityTolerance 控制数值计算，其余选项控制密度图。Output -> \"Data\" 返回动量路径、能量、谱权重和 Graphics。"}], "Usage"], Cell["data 是 surfaceGreenFunction 接受的数值 hopping Association。晶胞轴 1、2 张成表面，轴 3 是半无限堆垛方向。", "Notes"], Cell["path 可以是显式表面动量点，也可以是相连并带标签的二维线段。图中数值是在均匀能量网格上计算的 -Im Tr[Gsurface]/Pi。", "Notes"], Cell["每个网格点都使用与 surfaceSpectralFunction 相同的主层消元与收敛检查；不收敛会明确报告，不会被隐藏。", "Notes"], Cell["在 P4 Chern 例中，transformHoppings 把原来的第二个面内方向移到晶胞轴 3；于是轴 1 是守恒边缘动量，轴 3 取半无限。灰群 P4 四带例直接使用其保存的晶胞，同样令轴 3 为堆垛方向。两幅图分别显示一条穿越能隙的手征分支和一对反向传播的表面态分支。", "Notes"], Cell["Output -> \"Data\" 返回 SurfaceMomentumPath、PathCoordinate、边界标签、Energies、SpectralWeight、Broadening、Surface 与 Graphics。", "Notes"], Cell["当 hopping 数据、路径、有序能量范围、表面选项、消元控制或显示选项非法，或者某个网格点不收敛时，plotSurfaceSpectrum 发出消息并返回 $Failed；它不会修补输入、静默缩小网格或切换到近似 fallback。", "Notes"], Cell[BoxData[GridBox[{{Cell["      ", "TableRowIcon"], "\"MomentumSubdivisions\"", "60", Cell["每段带标签表面动量线段中的正整数区间数。", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"EnergyPoints\"", "201", Cell["均匀能量采样点数，至少为 2。", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"CellMatrix\"", "Automatic", Cell["Automatic 保留 hopping 晶胞；非奇异 3×3 整数矩阵先定义表面晶胞。", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"Broadening\"", "10^-3", Cell["推迟能量的正虚部展宽。", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"Tolerance\"", "10^-10", Cell["主层消元的正相对耦合容差。", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"MaxIterations\"", "200", Cell["正的消元迭代次数上限。", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"Surface\"", "\"Positive\"", Cell["晶胞轴 3 正向或负向终止面。", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"HermiticityTolerance\"", "10^-9", Cell["hopping 与主层厄米性的非负容差。", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"Output\"", "\"Graphics\"", Cell["Graphics 返回密度图；Data 还返回采样路径、能量、谱权重与 Graphics。", "TableText"]}, {Cell["      ", "TableRowIcon"], "ColorFunction", "\"SolarColors\"", Cell["传给 ListDensityPlot 的配色方案或颜色函数。", "TableText"]}, {Cell["      ", "TableRowIcon"], "ColorFunctionScaling", "True", Cell["ListDensityPlot 在应用 ColorFunction 前是否缩放数值。", "TableText"]}, {Cell["      ", "TableRowIcon"], "PlotLegends", "Automatic", Cell["传给 ListDensityPlot 的图例设置。", "TableText"]}, {Cell["      ", "TableRowIcon"], "PlotRange", "All", Cell["传给 ListDensityPlot 的显示范围。", "TableText"]}, {Cell["      ", "TableRowIcon"], "InterpolationOrder", "1", Cell["谱采样网格使用 0 阶或 1 阶插值。", "TableText"]}, {Cell["      ", "TableRowIcon"], "Mesh", "None", Cell["传给 ListDensityPlot 的网格线设置。", "TableText"]}, {Cell["      ", "TableRowIcon"], "FrameLabel", "Automatic", Cell["两个边框标签；Automatic 使用表面 k 路径与能量。", "TableText"]}, {Cell["      ", "TableRowIcon"], "FontSize", "18", Cell["边框刻度与标签的正字号。", "TableText"]}, {Cell["      ", "TableRowIcon"], "FontFamily", "\"Times\"", Cell["边框刻度与标签的字体族。", "TableText"]}, {Cell["      ", "TableRowIcon"], "AspectRatio", "1/GoldenRatio", Cell["密度图的高宽比。", "TableText"]}, {Cell["      ", "TableRowIcon"], "ImageSize", "Large", Cell["最终 Graphics 图像尺寸。", "TableText"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxDividers -> {"Rows" -> {{False}}}, GridBoxSpacings -> {"Columns" -> {Offset[0.27999999999999997], {Offset[0.7]}, Offset[0.27999999999999997]}, "Rows" -> {Offset[0.2], {Offset[0.8]}, Offset[0.2]}}]], "3ColumnTableMod"]}, Open]], Cell[CellGroupData[{Cell["范例初始化", "ExamplesInitializationSection"], Cell[BoxData["Needs[\"MagneticTB`\"]"], "ExampleInitialization"]}, Open]], Cell[CellGroupData[{Cell["基本范例", "PrimaryExamplesSection"], Cell["由对称性生成的 P4 Chern 绝缘体有一条穿越体能隙的手征边缘分支：", "ExampleText"], Cell[BoxData["chernOperations = msgop[bnsdict[{75,1}]];\ninit[\n  lattice -> {{a,0,0},{0,a,0},