Notebook[{Cell[CellGroupData[{Cell["plotRealSpaceWavefunction", "ObjectName"], Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["plotRealSpaceWavefunction[data,state]"], "InlineFormula"], "  ", "plotRealSpaceWavefunction 把有限体系态映射到 buildRealSpaceHamiltonian[...,\"Output\"->\"Data\"] 返回的矩阵对齐 BasisRecords。球体体积表示概率；Aggregation -> \"Atom\" 合并同一笛卡尔位置的轨道，\"Orbital\" 保留每个矩阵基态。PhaseColoring 可显示每个聚合记录的代表复相位。输入必须含完整位置元数据，态向量长度必须等于 Dimension 且范数非零；图形固定隐藏坐标轴和盒框，并采用 Orthographic 平行投影。"}], "Usage"], Cell["data 必须是 buildRealSpaceHamiltonian[...,\"Output\"->\"Data\"] 的返回值，并且 PositionDataAvailable -> True，含完整 BasisRecords、数值 Lattice 与 WannierCenters 元数据。", "Notes"], Cell["state 是有限数值向量，长度必须等于 data[\"Dimension\"]。球体体积表示概率；Atom 聚合合并同一笛卡尔位置的全部基态，Orbital 聚合保留矩阵基的顺序。", "Notes"], Cell["PhaseColoring 使用每个聚合记录中振幅最大基态的相位；Weight 始终是该记录内各振幅模平方之和。", "Notes"], Cell["Graphics3D 结果固定采用 Axes -> False、Boxed -> False 与 Orthographic 平行投影。Output -> \"Data\" 返回归一化振幅、SiteRecords、可见记录数、最大权重和 Graphics。", "Notes"], Cell["第二个例子用灰群 75 和 symham 直接构造二维 C4 呼吸方格高阶拓扑绝缘体。当 |s1/t1| = 0.2 < 1 时，把一个角轨道投影到有限体系中绝对能量最低的四态子空间，从而选出可重现的代表性角模。该图显示角局域性，但本身不计算四极矩拓扑不变量。", "Notes"], Cell["当有限体系数据缺少位置元数据、态向量长度错误或范数为零、聚合或显示选项非法，或者颜色函数不返回颜色时，plotRealSpaceWavefunction 发出消息并返回 $Failed；它不会修补输入、静默缩小网格或切换到近似 fallback。", "Notes"], Cell[BoxData[GridBox[{{Cell["      ", "TableRowIcon"], "\"Aggregation\"", "\"Atom\"", Cell["Atom 合并同一笛卡尔位置的基态；Orbital 保留每个矩阵基态。", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"Normalize\"", "True", Cell["计算概率前是否归一化输入态。", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"WeightThreshold\"", "10^-8", Cell["显示波函数球体所用的非负概率阈值。", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"PositionTolerance\"", "10^-8", Cell["仅供 Atom 聚合使用的正笛卡尔距离容差。", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"PhaseColoring\"", "False", Cell["是否按代表性复相位而不是概率给可见球体着色。", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"ShowAllSites\"", "True", Cell["是否为每条格点记录绘制浅色背景球。", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"ShowSiteLabels\"", "False", Cell["是否在每条格点记录旁绘制格点编号。", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"AtomRadius\"", "Automatic", Cell["Automatic 取最短晶格矢量长度的 0.055 倍；正数显式设置背景格点半径。", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"WavefunctionScale\"", "Automatic", Cell["Automatic 取最短晶格矢量长度的 0.22 倍；正数显式设置波函数球体最大半径。", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"Output\"", "\"Graphics\"", Cell["Graphics 返回实空间图；Data 还返回振幅、格点记录、权重与 Graphics。", "TableText"]}, {Cell["      ", "TableRowIcon"], "ColorFunction", "Automatic", Cell["Automatic 使用 SolarColors；PhaseColoring 为 False 时，也可用命名 ColorData 色表或颜色函数表示概率。", "TableText"]}, {Cell["      ", "TableRowIcon"], "FontSize", "12", Cell["正的格点标签字号。", "TableText"]}, {Cell["      ", "TableRowIcon"], "ViewPoint", "Automatic", Cell["Graphics3D 视点；投影保持正交，坐标轴与盒框保持隐藏。", "TableText"]}, {Cell["      ", "TableRowIcon"], "ImageSize", "Large", Cell["最终 Graphics3D 图像尺寸。", "TableText"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxDividers -> {"Rows" -> {{False}}}, GridBoxSpacings -> {"Columns" -> {Offset[0.27999999999999997], {Offset[0.7]}, Offset[0.27999999999999997]}, "Rows" -> {Offset[0.2], {Offset[0.8]}, Offset[0.2]}}]], "3ColumnTableMod"]}, Open]], Cell[CellGroupData[{Cell["范例初始化", "ExamplesInitializationSection"], Cell[BoxData["Needs[\"MagneticTB`\"]"], "ExampleInitialization"]}, Open]], Cell[CellGroupData[{Cell["基本范例", "PrimaryExamplesSection"], Cell["绘制三格点 L 形有限体系中波函数的概率与复相位：", "ExampleText"], Cell[BoxData["cubicOperations = msgop[gray[221]];\ninit[\n  lattice -> {{a,0,0},{0,a,0},{0,0,a}},\n  lattpar -> {a -> 1},\n  wyckoffposition -> {{{0,0,0},{0,0,0}}},\n  symminformation -> cubicOperations,\n  basisFunctions -> {{\"s\"}},\n  InitialBondShells -> 2,\n  GenerateSymmetryGroup -> False\n];\ncubicHamiltonian = symham[1] + symham[2];\ncubicData = hoppingData[{1,2},{e1 -> 0.,t1 -> 1.}];\nplotPropertySquare = cubicData;\nplotPropertyLCells = {{0,0,0},{1,0,0},{0,1,0}};\nplotPropertyLSystem = buildRealSpaceHamiltonian[\n  plotPropertySquare, plotPropertyLCells, \"Output\" -> \"Data\"\n];\nplotPropertyLState = {1,I,-1};\nplotRealSpaceWavefunction[\n  plotPropertyLSystem, plotPropertyLState,\n  \"PhaseColoring\" -> True,\n  \"ShowSiteLabels\" -> True,\n  ViewPoint -> {2,-2,1}\n]"], "Input"], Cell[BoxData[Graphics3DBox[{{Directive[GrayLevel[0.72], Opacity[0.45]], SphereBox[{{0., 0., 0.}, {1., 0., 0.}, {0., 1., 0.}}, 0.055]}, {{Hue[0, 0.85, 0.9], Specularity[GrayLevel[1], 25], SphereBox[{0., 0., 0.}, 0.22]}, {Hue[0.25, 0.85, 0.9], Specularity[GrayLevel[1], 25], SphereBox[{1., 0., 0.}, 0.22]}, {Hue[NCache[1/2, 0.5], 0.85, 0.9], Specularity[GrayLevel[1], 25], SphereBox[{0., 1., 0.}, 0.22]}}, {Text3DBox[FormBox[StyleBox["1", GrayLevel[0], FontSize -> 12, StripOnInput -> False], TraditionalForm], {0., 0., 0.077}], Text3DBox[FormBox[StyleBox["2", GrayLevel[0], FontSize -> 12, StripOnInput -> False], TraditionalForm], {1., 0., 0.077}], Text3DBox[FormBox[StyleBox["3", GrayLevel[0], FontSize -> 12, StripOnInput -> False], TraditionalForm], {0., 1., 0.077}]}}, Axes -> False, Boxed -> False, ViewProjection -> "Orthographic", ViewPoint -> {2, -2, 1}, Lighting -> "Neutral", PlotRange -> All, PlotRangePadding -> Scaled[0.08], SphericalRegion -> True, ImageSize -> Large]], "Output"], Cell["绘制由对称性生成的二维 C4 高阶拓扑绝缘体的代表性角局域态：", "ExampleText"], Cell[BoxData["hotiOperations = msgop[gray[75]];\ninit[\n  lattice -> {{1,0,0},{0,1,0},{0,0,10}},\n  lattpar -> {},\n  wyckoffposition -> {{{1/5,1/5,0},{0,0,0}}},\n  symminformation -> hotiOperations,\n  basisFunctions -> {{\"s\"}},\n  InitialBondShells -> 4,\n  GenerateSymmetryGroup -> False\n];\nsymham[2];\nsymham[4];\nhotiData = hoppingData[{2,4},{t1 -> 1.,s1 -> 0.2}];\nhotiFinite = buildRealSpaceHamiltonian[\n  hotiData,{6,6,1},\"Output\" -> \"Data\"\n];\n{hotiEnergies,hotiStates} = Eigensystem[\n  N@Normal@hotiFinite[\"Hamiltonian\"]\n];\nhotiCornerSubspace = hotiStates[[Ordering[Abs[hotiEnergies],4]]];\nhotiPositions = Lookup[\n  hotiFinite[\"BasisRecords\"],\"CartesianPositi