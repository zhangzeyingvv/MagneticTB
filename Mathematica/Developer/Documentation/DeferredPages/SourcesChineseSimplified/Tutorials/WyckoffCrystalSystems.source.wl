Notebook[{Cell["七晶系 Wyckoff 数据库模型", "Title"], Cell["下面十个例子覆盖七个晶系。每个代表位置都直接从 MagneticTB 自带的磁性 Wyckoff 数据库读取。同一个轨道分别用两种方式描述：DirectProduct 使用完整局域基底上的作用；Induced 从一个参考点的位置稳定子群表示出发。两种方式都给出完整 init 输入、Hamiltonian、对称矩阵和能带。", "Text"], Cell["磁 Wyckoff 约定遵循 S. V. Gallego 等人在 \"Magnetic symmetry in the Bilbao Crystallographic Server,\" Journal of Applied Crystallography 45, 1236-1247 (2012)，https://doi.org/10.1107/S0021889812042185 中说明的 BNS 磁群表。随包数据库是这里实际执行的数据源；该文献说明了相应的磁 Wyckoff 数据约定。", "Text"], Cell["三斜晶系 — BNS 1.3-a", "Section"], Cell["对这个 Wyckoff 位置，幺正子群只生成代表点本身，第二个格点由一个反幺正操作生成。下面的位置直接读取自磁性 Wyckoff 数据库，先用于 DirectProduct 模式，再用于 Induced 模式。", "Text"], Cell["DirectProduct 表示", "Subsection"], Cell[BoxData["Needs[\"MagneticTB`\"];\nwyckoffDirect1PackageRoot = DirectoryName@DirectoryName@FindFile[\"MagneticTB`\"];\nwyckoffDirect1Database = Import[\n  FileNameJoin[{wyckoffDirect1PackageRoot, \"Data\", \"wyckoffMSG.mx\"}]\n];\nwyckoffDirect1LetterName[value_] := If[\n  StringQ[value], value, SymbolName[Unevaluated[value]]\n];\nwyckoffDirect1Entry = SelectFirst[\n  wyckoffDirect1Database[{1, 3}],\n  wyckoffDirect1LetterName[#[[3]]] === \"a\" &\n];\nwyckoffDirect1Seed = wyckoffDirect1Entry[[4, 1]] /. {\n  x -> 1/7, y -> 2/11, z -> 3/13,\n  mx -> 1/5, my -> 2/7, mz -> 3/11\n};\nwyckoffDirect1Operations = msgop[typeIV[{1, 3}]];\ninit[\n  lattice -> {{a, 0, 0}, {b*Cos[gamma], b*Sin[gamma], 0}, \n   {c*Cos[beta], c*(Cos[alpha] - Cos[beta]*Cos[gamma])*\n     Csc[gamma], c*Sqrt[1 - Cos[alpha]^2 - Cos[beta]^2 + \n       2*Cos[alpha]*Cos[beta]*Cos[gamma] - Cos[gamma]^2]*\n     Csc[gamma]}},\n  lattpar -> {a -> 1, b -> 6/5, c -> 7/5, alpha -> Pi/2, beta -> Pi/3, \n   gamma -> Pi/4},\n  wyckoffposition -> {wyckoffDirect1Seed},\n  symminformation -> wyckoffDirect1Operations,\n  basisFunctions -> {{\"s\"}},\n  InitialBondShells -> 2,\n  GenerateSymmetryGroup -> False,\n  RepresentationMode -> \"DirectProduct\"\n];\nwyckoffDirect1Path = {\n  {{{0, 0, 0}, {1/2, 0, 0}}, {\"G\", \"X\"}},\n  {{{1/2, 0, 0}, {1/2, 1/2, 0}}, {\"X\", \"M\"}},\n  {{{1/2, 1/2, 0}, {0, 0, 0}}, {\"M\", \"G\"}}\n};"], "Input"], Cell[BoxData["wyckoffDirect1Seed"], "Input"], Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{FractionBox["1", "7"], ",", FractionBox["2", "11"], ",", FractionBox["3", "13"]}], "}"}], ",", RowBox[{"{", RowBox[{FractionBox["1", "5"], ",", FractionBox["2", "7"], ",", FractionBox["3", "11"]}], "}"}]}], "}"}]], "Output"], Cell[BoxData["orbitalTable[]"], "Input"], Cell[BoxData[TagBox[GridBox[{{TemplateBox[{"\"Hamiltonian dimension = \"", "2", "\"; representation mode = \"", "\"DirectProduct\""}, "RowDefault"], "", "", "", "", "", "", "", "", "", "", ""}, {"\"H index\"", "\"Site\"", "\"Wyckoff orbit\"", "\"Atom\"", "\"Fractional position\"", "\"Cartesian position\"", "\"Local orbital\"", "\"Input basis\"", "\"Actual basis state\"", "\"Spin structure\"", "\"Spin state\"", "\"Transport operation\""}, {"1", "1", "1", "1", RowBox[{"{", RowBox[{FractionBox["1", "7"], ",", FractionBox["2", "11"], ",", FractionBox["3", "13"]}], "}"}], RowBox[{"{", RowBox[{RowBox[{FractionBox["277", "910"], "+", FractionBox[RowBox[{"6", " ", SqrtBox["2"]}], "55"]}], ",", RowBox[{RowBox[{"-", FractionBox["21", "130"]}], "+", FractionBox[RowBox[{"6", " ", SqrtBox["2"]}], "55"]}], ",", FractionBox["21", RowBox[{"65", " ", SqrtBox["2"]}]]}], "}"}], "1", "\"s\"", "1", "\"Spinless\"", "None", "None"}, {"2", "2", "1", "2", RowBox[{"{", RowBox[{FractionBox["1", "7"], ",", FractionBox["2", "11"], ",", FractionBox["19", "26"]}], "}"}], RowBox[{"{", RowBox[{RowBox[{FractionBox["1191", "1820"], "+", FractionBox[RowBox[{"6", " ", SqrtBox["2"]}], "55"]}], ",", RowBox[{RowBox[{"-", FractionBox["133", "260"]}], "+", FractionBox[RowBox[{"6", " ", SqrtBox["2"]}], "55"]}], ",", FractionBox["133", RowBox[{"130", " ", SqrtBox["2"]}]]}], "}"}], "1", "\"s\"", "1", "\"Spinless\"", "None", "None"}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, GridBoxFrame -> {"Columns" -> {{True}