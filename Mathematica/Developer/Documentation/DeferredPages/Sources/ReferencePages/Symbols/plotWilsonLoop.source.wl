Notebook[{Cell[CellGroupData[{Cell["plotWilsonLoop", "ObjectName"], Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["plotWilsonLoop[H,centers,occupied,start,end,parameterPath]"], "InlineFormula"], "  ", "plots Wilson-loop branches while translating one reciprocal-lattice-closed loop along a parameter path."}], "Usage"], Cell["start and end have the same momentum-coordinate dimension, and end-start must be 2 Pi times an integer reciprocal vector. centers contains one fractional orbital center per Hamiltonian basis state.", "Notes"], Cell["parameterPath may be an explicit ordered list of distinct momentum offsets or connected labeled segments {{{p1,p2},{label1,label2}},...}. Labeled segments use ParameterSubdivisions intervals per segment.", "Notes"], Cell["Every sample calls wilsonLoop with forward occupied-subspace links, SVD unitarization, and orbital-center endpoint sewing. The plot introduces no gauge, gap, or numerical fallback.", "Notes"], Cell["The symmetry-generated P4 Chern example has one occupied band whose Wilson phase winds once over a full transverse Brillouin zone. The gray-P4 Z2 example has two occupied bands; their Wannier-center branches exchange partners between the two time-reversal-invariant endpoints of half the zone. plotWilsonLoop displays this flow but does not return a Z2 integer.", "Notes"], Cell["The default return is Graphics. Output -> \"Data\" returns ParameterPath, PathCoordinate, boundary labels, PhaseConvention, Values, BranchCount, and the same Graphics.", "Notes"], Cell["plotWilsonLoop returns $Failed and issues a message when the loop or parameter path is malformed, a translated Wilson loop fails its Hermiticity/gap/covariance/overlap checks, or an option is invalid. It does not repair the input, reduce the grid silently, or switch to an approximate fallback.", "Notes"], Cell[BoxData[GridBox[{{Cell["      ", "TableRowIcon"], "\"ParameterSubdivisions\"", "60", Cell["Positive number of intervals per labeled parameter-path segment.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"LoopSubdivisions\"", "50", Cell["Positive number of forward links in every translated Wilson loop.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"HermitianTolerance\"", "10^-10", Cell["Nonnegative Hamiltonian Hermiticity and Wilson-unitarity tolerance.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"GapTolerance\"", "10^-9", Cell["Nonnegative minimum direct gap for a partially occupied subspace.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"CovarianceTolerance\"", "10^-8", Cell["Nonnegative endpoint sewing-covariance tolerance.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"OverlapTolerance\"", "10^-10", Cell["Nonnegative lower bound for occupied-link singular values.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"PhaseConvention\"", "\"PhaseOverPi\"", Cell["PhaseOverPi gives phases on [-1,1]; WannierCenters gives centers modulo one.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"Output\"", "\"Graphics\"", Cell["Graphics returns the branch plot; Data also returns the sampled path, values, labels, and Graphics.", "TableText"]}, {Cell["      ", "TableRowIcon"], "yTicks", "Automatic", Cell["Automatic, None, numeric positions, or standard vertical tick specifications.", "TableText"]}, {Cell["      ", "TableRowIcon"], "Joined", "False", Cell["Whether sampled points in each Wilson branch are connected.", "TableText"]}, {Cell["      ", "TableRowIcon"], "PlotMarkers", "Automatic", Cell["Marker specification passed to ListPlot.", "TableText"]}, {Cell["      ", "TableRowIcon"], "PlotStyle", "Black", Cell["Style or list of styles passed to ListPlot.", "TableText"]}, {Cell["      ", "TableRowIcon"], "PlotRange", "Automatic", Cell["Displayed x/y range; Automatic uses the full path and the selected phase convention.", "TableText"]}, {Cell["      ", "TableRowIcon"], "GridLines", "Automatic", Cell["Grid-line specification; Automatic marks path boundaries and reference phases.", "TableText"]}, {Cell["      ", "TableRowIcon"], "FrameLabel", "Automatic", Cell["Two frame labels; Automatic names the parameter path and phase convention.", "TableText"]}, {Cell["      ", "TableRowIcon"], "FontSize", "18", Cell["Positive size for ticks, path labels, and frame labels.", "TableText"]}, {Cell["      ", "TableRowIcon"], "FontFamily", "\"Times\"", Cell["Font family for ticks, path labels, and frame labels.", "TableText"]}, {Cell["      ", "TableRowIcon"], "ImageSize", "Large", Cell["Final Graphics image size.", "TableText"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxDividers -> {"Rows" -> {{False}}}, GridBoxSpacings -> {"Columns" -> {Offset[0.27999999999999997], {Offset[0.7]}, Offset[0.27999999999999997]}, "Rows" -> {Offset[0.2], {Offset[0.8]}, Offset[0.2]}}]], "3ColumnTableMod"]}, Open]], Cell[CellGroupData[{Cell["Examples Initialization", "ExamplesInitializationSection"], Cell[BoxData["Needs[\"MagneticTB`\"]"], "ExampleInitialization"]}, Open]], Cell[CellGroupData[{Cell["Basic Examples", "PrimaryExamplesSection"], Cell["The occupied band of the symmetry-generated P4 Chern insulator has one Wilson branch that winds once across the transverse Brillouin zone:", "ExampleText"], Cell[BoxData["chernOperations = msgop[bnsdict[{75,1}]];\ninit[\n  lattice -> {{a,0,0},{0,a,0},{0,0,c}},\n  lattpar -> {a -> 1,c -> 5},\n  wyckoffposition -> {{{0,0,0},{0,0,1}}},\n  symminformation -> chernOperations,\n  basisFunctions -> {{\"s\",x + I y}},\n  InitialBondShells -> 2,\n  GenerateSymmetryGroup -> False\n];\nchernMatrix = symham[1] + symham[2];\nchernRules = {\n  e1 -> -1.,e2 -> 1.,t1 -> 0.5,\n  t2 -> 0.5,t3 -> -0.5,t4 -> 0.\n};\nchernData = hoppingData[{1,2},chernRules];\nchernHamiltonian[{qx_?NumericQ,qy_?NumericQ}] := N[\n  chernMatrix /. chernRules /.\n    {kx -> qx,ky -> qy,kz -> 0}\n];\nchernCenters = chernData[\"WannierCenters\"][[All,1 ;; 2]];\nchernWilsonPath = {\n  {{{0,-Pi},{0,0}},{\"-Pi\",\"0\"}},\n  {{{0,0},{0,Pi}},{\"0\",\"Pi\"}}\n};\nplotWilsonLoop[\n  ch