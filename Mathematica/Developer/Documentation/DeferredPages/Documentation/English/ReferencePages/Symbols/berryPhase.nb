Notebook[{Cell[CellGroupData[{Cell["berryPhase", "ObjectName"], Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["berryPhase[h,wcc,occ,path]"], "InlineFormula"], " \:2028", "computes the total gauge-invariant occupied-subspace Berry phase along an explicitly sampled closed path."}], "Usage"], Cell["path is an ordered list of momentum points. Its endpoint may equal the start or differ by 2 Pi times an integer reciprocal vector; orbital centers provide the closure sewing matrix.", "Notes"], Cell["The default phase is in radians on the principal Arg branch. The algorithm uses the same SVD-unitarized forward links and strict covariance checks as wilsonLoop.", "Notes"], Cell["berryPhase returns $Failed and issues a message when the sampled path is open, centers or occupied count are invalid, H is non-Hermitian or gapless, endpoint covariance fails, a link is singular, or an option is invalid. It does not repair the input or switch to an approximate fallback.", "Notes"], Cell[BoxData[GridBox[{{Cell["      ", "TableRowIcon"], "\"HermitianTolerance\"", "10^-10", Cell["Nonnegative Hamiltonian Hermiticity and Wilson unitarity tolerance.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"GapTolerance\"", "10^-9", Cell["Nonnegative minimum direct-gap threshold.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"CovarianceTolerance\"", "10^-8", Cell["Nonnegative endpoint sewing-covariance tolerance.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"OverlapTolerance\"", "10^-10", Cell["Nonnegative lower bound for occupied-link singular values.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"Output\"", "\"Phase\"", Cell["Phase, PhaseOverPi, WilsonDeterminant, or Data.", "TableText"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxDividers -> {"Rows" -> {{False}}}, GridBoxSpacings -> {"Columns" -> {Offset[0.27999999999999997], {Offset[0.7]}, Offset[0.27999999999999997]}, "Rows" -> {Offset[0.2], {Offset[0.8]}, Offset[0.2]}}]], "3ColumnTableMod"]}, Open]], Cell[CellGroupData[{Cell["Examples Initialization", "ExamplesInitializationSection"], Cell[BoxData["Needs[\"MagneticTB`\"]"], "ExampleInitialization"]}, Open]], Cell[CellGroupData[{Cell["Basic Examples", "PrimaryExamplesSection"], Cell["Sample one reciprocal loop of the atomic band explicitly. Its Berry phase is Pi/2:", "ExampleText"], Cell[BoxData["Clear[atomicHamiltonian];\natomicHamiltonian[{q_?NumericQ}] := {{0.}};\natomicCenters = {{1/4}};\natomicPath = Subdivide[{0.}, {2 Pi}, 20];\nberryPhase[atomicHamiltonian, atomicCenters, 1, atomicPath]"], "Input"], Cell[BoxData["1.5707963267948966`"], "Output"]}, Open]], Cell[CellGroupData[{Cell["More Examples", "ExtendedExamplesSection", CellTags -> "ExtendedExamples"], Cell[CellGroupData[{Cell["Options", "ExampleSection"], Cell[CellGroupData[{Cell["HermitianTolerance", "ExampleSubsection"], Cell["\"HermitianTolerance\" - uses a stricter Hamiltonian and final Wilson-matrix tolerance.", "ExampleText"], Cell[BoxData["Clear[atomicHamiltonian];\natomicHamiltonian[{q_?NumericQ}] := {{0.}};\natomicCenters = {{1/4}};\natomicPath=Subdivide[{0.},{2 Pi},12];\nberryPhase[atomicHamiltonian, atomicCenters, 1, atomicPath, \"HermitianTolerance\" -> 10^-12]"], "Input"], Cell[BoxData["1.5707963267948966`"], "Output"]}, Open]], Cell[CellGroupData[{Cell["GapTolerance", "ExampleSubsection"], Cell["\"GapTolerance\" - sets the minimum direct gap for a partially occupied space.", "ExampleText"], Cell[BoxData["Clear[atomicHamiltonian];\natomicHamiltonian[{q_?NumericQ}] := {{0.}};\natomicCenters = {{1/4}};\natomicPath=Subdivide[{0.},{2 Pi},12];\nberryPhase[atomicHamiltonian, atomicCenters, 1, atomicPath, \"GapTolerance\" -> 10^-12]"], "Input"], Cell[BoxData["1.5707963267948966`"], "Output"]}, Open]], Cell[CellGroupData[{Cell["CovarianceTolerance", "ExampleSubsection"], Cell["\"CovarianceTolerance\" - sets the endpoint sewing-covariance threshold.", "ExampleText"], Cell[BoxData["Clear[atomicHamiltonian];\natomicHamiltonian[{q_?NumericQ}] := {{0.}};\natomicCenters = {{1/4}};\natomicPath=Subdivide[{0.},{2 Pi},12];\nberryPhase[atomicHamiltonian, atomicCenters, 1, atomicPath, \"CovarianceTolerance\" -> 10^-10]"], "Input"], Cell[BoxData["1.5707963267948966`"], "Output"]}, Open]], Cell[CellGroupData[{Cell["OverlapTolerance", "ExampleSubsection"], Cell["\"OverlapTolerance\" - sets the occupied-link singular-value threshold.", "ExampleText"], Cell[BoxData["Clear[atomicHamiltonian];\natomicHamiltonian[{q_?NumericQ}] := {{0.}};\natomicCenters = {{1/4}};\natomicPath=Subdivide[{0.},{2 Pi},12];\nberryPhase[atomicHamiltonian, atomicCenters, 1, atomicPath, \"OverlapTolerance\" -> 10^-12]"], "Input"], Cell[BoxData["1.5707963267948966`"], "Output"]}, Open]], Cell[CellGroupData[{Cell["Output", "ExampleSubsection"], Cell["\"Output\" - returns phase, Wilson determinant, residuals, minimum gap, and closure data together.", "ExampleText"], Cell[BoxData["Clear[atomicHamiltonian];\natomicHamiltonian[{q_?NumericQ}] := {{0.}};\natomicCenters = {{1/4}};\natomicPath=Subdivide[{0.},{2 Pi},12];\nKeyTake[berryPhase[atomicHamiltonian, atomicCenters, 1, atomicPath, \"Output\" -> \"Data\"], {\"Phase\",\"PhaseOverPi\",\"WilsonDeterminant\",\"ClosureVector\",\"EndpointCovarianceResidual\"}]"], "Input"], Cell[BoxData[RowBox[{"\:f113", RowBox[{RowBox[{"\"Phase\"", "\:f522", "1.5707963267948966`"}], ",", RowBox[{"\"PhaseOverPi\"", "\:f522", "0.5`"}], ",", RowBox[{"\"WilsonDeterminant\"", "\:f522", RowBox[{RowBox[{"0.`", "\:200a"}], "+", RowBox[{"1.`", " ", "\:f74e"}]}]}], ",", RowBox[{"\"ClosureVector\"", "\:f522", RowBox[{"{", "6.283185307179586`", "}"}]}], ",", RowBox[{"\"EndpointCovarianceResidual\"", "\:f522", "0.`"}]}], "\:f114"}]], "Output"]}, Open]]}, Open]]}, Open]], Cell[CellGroupData[{Cell["Related Functions", "SeeAlsoSection"], Cell[TextData[{ButtonBox["wilsonLoop", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/wilsonLoop"], " \:25aa ", ButtonBox["berryCurvature", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/berryC