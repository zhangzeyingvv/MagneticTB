Notebook[{Cell[CellGroupData[{Cell["findGaplessPoints", "ObjectName"], Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["findGaplessPoints[H,occupied]"], "InlineFormula"], " \:2028", "searches a periodic Brillouin zone for zeros of the direct gap between bands occupied and occupied+1."}], "Usage"], Cell["The function first samples an eigenvalue-only periodic grid, keeps a bounded number of low-gap seeds, and refines gap squared locally. CandidateCount is a cap, so the result does not claim mathematical completeness.", "Notes"], Cell["H may be a numerical momentum function or a symbolic matrix. Output -> \"Data\" reports seeds, failed refinements, minimum gap, points, and CompletenessGuaranteed -> False.", "Notes"], Cell["findGaplessPoints returns $Failed and issues a message when the Brillouin zone, grid, occupation, Hamiltonian, refinement controls, momentum symbols, or Output form is invalid. It does not repair the input or switch to an approximate fallback.", "Notes"], Cell[BoxData[GridBox[{{Cell["      ", "TableRowIcon"], "\"BrillouinZone\"", "{{-Pi,Pi},{-Pi,Pi},{-Pi,Pi}}", Cell["One to three ordered finite intervals.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"GridSize\"", "15", Cell["Integer at least two, or one such integer per momentum dimension.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"CandidateCount\"", "32", Cell["Positive cap on grid seeds sent to local refinement.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"GapTolerance\"", "10^-7", Cell["Nonnegative final direct-gap threshold for accepting a point.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"MergeTolerance\"", "10^-4", Cell["Nonnegative periodic distance used to merge duplicate refined points.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"HermitianTolerance\"", "10^-10", Cell["Nonnegative Hamiltonian Hermiticity tolerance.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"MaxIterations\"", "500", Cell["Positive local-refinement iteration limit.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"RefinementMethod\"", "\"PrincipalAxis\"", Cell["PrincipalAxis or QuasiNewton for local minimization of gap squared.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"MomentumSymbols\"", "{kx,ky,kz}", Cell["Distinct variables used when H is a symbolic matrix.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"Output\"", "\"Points\"", Cell["Points or a diagnostic Data Association.", "TableText"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxDividers -> {"Rows" -> {{False}}}, GridBoxSpacings -> {"Columns" -> {Offset[0.27999999999999997], {Offset[0.7]}, Offset[0.27999999999999997]}, "Rows" -> {Offset[0.2], {Offset[0.8]}, Offset[0.2]}}]], "3ColumnTableMod"]}, Open]], Cell[CellGroupData[{Cell["Examples Initialization", "ExamplesInitializationSection"], Cell[BoxData["Needs[\"MagneticTB`\"]"], "ExampleInitialization"]}, Open]], Cell[CellGroupData[{Cell["Basic Examples", "PrimaryExamplesSection"], Cell["A constant gapped one-dimensional two-band model has no gapless points:", "ExampleText"], Cell[BoxData["Clear[gappedOneDimensional];\ngappedOneDimensional[{q_?NumericQ}] := {{-1., 0.}, {0., 1.}};\nfindGaplessPoints[gappedOneDimensional, 1, \"BrillouinZone\" -> {{-Pi,Pi}}, \"GridSize\" -> 2, \"CandidateCount\" -> 1]"], "Input"], Cell[BoxData[RowBox[{"{", "}"}]], "Output"]}, Open]], Cell[CellGroupData[{Cell["More Examples", "ExtendedExamplesSection", CellTags -> "ExtendedExamples"], Cell[CellGroupData[{Cell["Options", "ExampleSection"], Cell[CellGroupData[{Cell["BrillouinZone", "ExampleSubsection"], Cell["\"BrillouinZone\" - sets the explicit one-dimensional periodic search interval.", "ExampleText"], Cell[BoxData["Clear[gappedOneDimensional];\ngappedOneDimensional[{q_?NumericQ}] := {{-1., 0.}, {0., 1.}};\nfindGaplessPoints[gappedOneDimensional,1,\"BrillouinZone\"->{{-1,1}},\"GridSize\"->2,\"CandidateCount\"->1]"], "Input"], Cell[BoxData[RowBox[{"{", "}"}]], "Output"]}, Open]], Cell[CellGroupData[{Cell["GridSize", "ExampleSubsection"], Cell["\"GridSize\" - uses four periodic samples in the one-dimensional zone.", "ExampleText"], Cell[BoxData["Clear[gappedOneDimensional];\ngappedOneDimensional[{q_?NumericQ}] := {{-1., 0.}, {0., 1.}};\nfindGaplessPoints[gappedOneDimensional,1,\"BrillouinZone\"->{{-Pi,Pi}},\"GridSize\"->4,\"CandidateCount\"->1]"], "Input"], Cell[BoxData[RowBox[{"{", "}"}]], "Output"]}, Open]], Cell[CellGroupData[{Cell["CandidateCount", "ExampleSubsection"], Cell["\"CandidateCount\" - caps the refinement seed list at one record.", "ExampleText"], Cell[BoxData["Clear[gappedOneDimensional];\ngappedOneDimensional[{q_?NumericQ}] := {{-1., 0.}, {0., 1.}};\nfindGaplessPoints[gappedOneDimensional,1,\"BrillouinZone\"->{{-Pi,Pi}},\"GridSize\"->2,\"CandidateCount\"->1]"], "Input"], Cell[BoxData[RowBox[{"{", "}"}]], "Output"]}, Open]], Cell[CellGroupData[{Cell["GapTolerance", "ExampleSubsection"], Cell["\"GapTolerance\" - sets the final gap threshold for accepting refined points.", "ExampleText"], Cell[BoxData["Clear[gappedOneDimensional];\ngappedOneDimensional[{q_?NumericQ}] := {{-1., 0.}, {0., 1.}};\nfindGaplessPoints[gappedOneDimensional,1,\"BrillouinZone\"->{{-Pi,Pi}},\"GridSize\"->2,\"CandidateCount\"->1,\"GapTolerance\"->10^-6]"], "Input"], Cell[BoxData[RowBox[{"{", "}"}]], "Output"]}, Open]], Cell[CellGroupData[{Cell["MergeTolerance", "ExampleSubsection"], Cell["\"MergeTolerance\" - sets the periodic distance used to merge duplicate accepted points.", "ExampleText"], Cell[BoxData["Clear[gappedOneDimensional];\ngappedOneDimensional[{q_?NumericQ}] := {{-1., 0.}, {0., 1.}};\nfindGaplessPoints[gappedOneDimensional,1,\"BrillouinZone\"->{{-Pi,Pi}},\"GridSize\"->2,\"CandidateCount\"->1,\"MergeTolerance\"->10^-3]"], "Input"], Cell[BoxData[RowBox[{"{", "}"}]], "Output"]}, Open]], Cell[CellGroupData[{Cell["HermitianTolerance", "ExampleSubsection"], Cell["\"HermitianTolerance\" - uses a stricter Hamiltonian residual threshold.", "ExampleText"], Cell[BoxData["Clear[gappedOneDimensional];\ngappedOneDimensional[{q_?NumericQ}] := {{-1., 0.}, {0., 1.}};\nfindGaplessPoints[gappedOneDimensional,1,\"BrillouinZone\"->{{-Pi,Pi}},\"GridSize\"->2,\"CandidateCount\"->1,\"HermitianTolerance\"->10^-12]"], "Input"], Cell[BoxData[RowBox[{"{", "}"}]], "Output"]}, Open]], Cell[CellGroupData[{Cell["MaxIterations", "ExampleSubsection"], Cell["\"MaxIterations\" - sets a short explicit local-refinement limit for this constant gapped model.", "ExampleText"], Cell[BoxData["Clear[gappedOneDimensional];\ngappedOneDimensional[{q_?NumericQ}] := {{-1., 0.}, {0., 1.}};\nfindGaplessPoints[gappedOneDimensional,1,\"BrillouinZone\"->{{-Pi,Pi}},\"GridSize\"->2,\"CandidateCount\"->1,\"MaxIterations\"->20]"], "Input"], Cell[BoxData[RowBox[{"{", "}"}]], "Output"]}, Open]], Cell[CellGroupData[{Cell["RefinementMethod", "ExampleSubsection"], Cell["\"RefinementMethod\" - uses QuasiNewton instead of PrincipalAxis for gap-squared refinement.", "ExampleText"], Cell[BoxData["Clear[gappedOneDimensional];\ngappedOneDimensional[{q_?NumericQ}] := {{-1., 0.}, {0., 1.}};\nfindGaplessPoints[gappedOneDimensional,1,\"BrillouinZone\"->{{-Pi,Pi}},\"GridSize\"->2,\"CandidateCount\"->1,\"RefinementMethod\"->\"QuasiNewton\"]"], "Input"], Cell[BoxData[RowBox[{"{", "}"}]], "Output"]}, Open]], Cell[CellGroupData[{Cell["MomentumSymbols", "ExampleSubsection"], Cell["\"MomentumSymbols\" - maps a symbolic matrix to the single search coordinate.", "ExampleText"], Cell[BoxData["q=.;\nfindGaplessPoints[{{-1,0},{0,1}},1,\"BrillouinZone\"->{{-Pi,Pi}},\"GridSize\"->2,\"CandidateCount\"->1,\"MomentumSymbols\"->{q}]"], "Input"], Cell[BoxData[RowBox[{"{", "}"}]], "Output"]}, Open]], Cell[CellGroupData[{Cell["Output", "ExampleSubsection"], Cell["\"Output\" - returns the bounded-search diagnostics and explicitly records that completeness is not guaranteed.", "ExampleText"], Cell[BoxData["Clear[gappedOneDimensional];\ngappedOneDimensional[{q_?NumericQ}] := {{-1., 0.}, {0., 1.}};\nKeyTake[findGaplessPoints[gappedOneDimensional,1,\"BrillouinZone\"->{{-Pi,Pi}},\"GridSize\"->2,\"CandidateCount\"->1,\"Output\"->\"Data\"], {\"Points\",\"GridSize\",\"SeedCount\",\"MinimumGap\",\"RefinementMethod\",\"CompletenessGuaranteed\"}]"], "Input"], Cell[BoxData[RowBox[{"\:f113", RowBox[{RowBox[{"\"Points\"", "\:f522", RowBox[{"{", "}"}]}], ",", RowBox[{"\"GridSize\"", "\:f522", RowBox[{"{", "2", "}"}]}], ",", RowBox[{"\"SeedCount\"", "\:f522", "1"}], ",", RowBox[{"\"MinimumGap\"", "\:f522", "2.`"}], ",", RowBox[{"\"RefinementMethod\"", "\:f522", "\"PrincipalAxis\""}], ",", RowBox[{"\"CompletenessGuaranteed\"", "\:f522", "False"}]}], "\:f114"}]], "Output"]}, Open]]}, Open]]}, Open]], Cell[CellGroupData[{Cell["Related Functions", "SeeAlsoSection"], Cell[TextData[{ButtonBox["pointChernNumber", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/pointChernNumber"], " \:25aa ", ButtonBox["berryCurvature", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/berryCurvature"]}], "SeeAlso"]}, Open]], Cell[CellGroupData[{Cell["Related Guides", "MoreAboutSection"], Cell[TextData[{ButtonBox["MagneticTB", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/guide/MagneticTB"]}], "MoreAbout"]}, Open]], Cell[CellGroupData[{Cell["Related Tutorials", "TutorialsSection"], Cell[TextData[{ButtonBox["Real-space Hamiltonians, surfaces, and topology", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/tutorial/RealSpaceAndTopology"]}], "Tutorials"]}, Open]], Cell[CellGroupData[{Cell["History", "HistorySection"], Cell[TextData[{"New in: ", Cell["2.0.0", "HistoryData", CellTags -> "New"], " | Modified in: ", Cell[" ", "HistoryData", CellTags -> "Modified"], " | Obsolete in: ", Cell[" ", "HistoryData", CellTags -> "Obsolete"]}], "History"]}, Closed]], Cell[CellGroupData[{Cell["Categorization", "CategorizationSection"], Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], Cell["MagneticTB", "Categorization", CellLabel -> "Paclet Name"], Cell["MagneticTB`", "Categorization", CellLabel -> "Context"], 