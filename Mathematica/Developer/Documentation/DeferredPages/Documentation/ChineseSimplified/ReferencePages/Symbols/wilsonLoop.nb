5, r2 -> 0, r6 -> 0.5,\n  s4 -> -0.38, s8 -> 0, t1 -> 0, t15 -> 0.735,\n  t7 -> 0.05, t9 -> 0.015\n};\nweylHamiltonian[q_List] := N[\n  weylBlock /. weylParameters /.\n    Thread[{kx,ky,kz} -> q]\n];\nweylCenters = {{0,0,0},{0,0,1/2}};\nchernSlice[{qx_?NumericQ,qy_?NumericQ}] :=\n  weylHamiltonian[{qx,qy,0.25}];\nchernCenters = weylCenters[[All,1 ;; 2]];\nchernParameterPath = {\n  {{{0,-Pi},{0,0}},{\"-Pi\",\"0\"}},\n  {{{0,0},{0,Pi}},{\"0\",\"Pi\"}}\n};"], "Input"], Cell["\:5728\:8be5 Chern \:5207\:7247\:4e0a\:8ba1\:7b97\:5355\:5360\:636e\:5e26 Wilson \:73af\:ff1a", "ExampleText"], Cell[BoxData["wilsonLoop[chernSlice, chernCenters, 1, {0,0}, {2 Pi,0}]"], "Input"], Cell[BoxData[RowBox[{"{", RowBox[{"-", "0.6475929082745643`"}], "}"}]], "Output"], Cell["\:5f53\:95ed\:73af\:6a2a\:5411\:5e73\:79fb\:7a7f\:8fc7 Brillouin \:533a\:65f6\:ff0c\:7ed8\:5236 Wilson \:76f8\:4f4d\:8c31\:6d41\:ff1a", "ExampleText"], Cell[BoxData["plotWilsonLoop[\n  chernSlice, chernCenters, 1,\n  {0,0}, {2 Pi,0}, chernParameterPath,\n  \"ParameterSubdivisions\" -> 24,\n  \"LoopSubdivisions\" -> 40\n]"], "Input"], Cell[BoxData[GraphicsBox[{{}, InterpretationBox[{TagBox[{{TagBox[{Directive[PointSize[0.012833333333333334], AbsoluteThickness[2], FontFamily -> "Times", FontSize -> 18, GrayLevel[0]], GeometricTransformationBox[InsetBox[BoxData[FormBox[StyleBox[GraphicsBox[{EdgeForm[], DiskBox[{0, 0}]}, PlotRangePadding -> Scaled[0.15]], GraphicsBoxOptions -> {DefaultBaseStyle -> Directive[PointSize[0.012833333333333334], AbsoluteThickness[2], FontFamily -> "Times", FontSize -> 18, GrayLevel[0]]}, StripOnInput -> False], TraditionalForm]], {0., 0.}, Automatic, Offset[10.976]], {{{0., 0.28507037300288685}}, {{0.041666666666666664, -0.4796668286107383}}, {{0.08333333333333333, -0.7326317743359937}}, {{0.125, -0.8127871974431762}}, {{0.16666666666666666, -0.8475681986901316}}, {{0.20833333333333331, -0.8647889570850866}}, {{0.25, -0.8731661952881333}}, {{0.29166666666666663, -0.8760030704129741}}, {{0.333333