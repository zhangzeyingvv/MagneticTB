(*core*)


(*set input data*)
init::usage = "init[opts] initializes a MagneticTB model from lattice, Wyckoff-position, symmetry, and basis-function data and prepares the requested bond shells."
initfromrep::usage = "initfromrep[opts] initializes a model from a complete closed finite group and complete program-generated representation data. It accepts no basisFunctions and performs no finite-group generation. An optional single pure-internal C_infty entry is removed before atom and bond compilation; its final per-site D(theta) matrices are supplied through repinformation and differentiated to one Hermitian generator."
unsymham ::usage = "unsymham[n] builds the unconstrained symbolic Hamiltonian for bond shell n from the current native model."
symham ::usage = "symham[n] constructs the symmetry-constrained Hamiltonian for bond shell n. Set \"Hermitian\"->False to keep reverse hoppings independent; the default is True."
