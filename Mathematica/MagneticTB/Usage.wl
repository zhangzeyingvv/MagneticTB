lattice::usage = "Options for init"
wyckoffposition::usage = "Options for init"
symminformation::usage = "symminformation is an init option. The traditional list of {label,R,t,\"F\"|\"T\"} records remains the ordinary magnetic-group format. A discrete spin-space group uses the Association label-><|\"space\"->{R,t},\"spin\"->{S,0|1}|>. With GenerateSymmetryGroup->True either format supplies generators; with False it supplies the complete group. Only initfromrep additionally accepts one C_infty Association entry carrying \"continuous\"->theta; its space action must be exactly the identity and it is never included in the finite group, atom positions, or bond orbits."
basisFunctions::usage = "Options for init"
repinformation::usage = "repinformation is the required program-generated representation input for initfromrep. The legacy finite-only form is unchanged. With one internal C_infty use <|\"Discrete\"->oldFiniteData,\"Continuous\"-><|\"SiteMatrices\"->orbitBySiteDThetaMatrices|>|>; m is encoded by the supplied exact D(theta), and no basis-function inference is performed."
orbitalLabels::usage = "orbitalLabels supplies optional display-only local orbital labels for initfromrep; Automatic generates orb1, orb2, and so on from representation dimensions."
lattpar::usage = "Options for init"
debugQ::usage = "debugQ is a Boolean init and initfromrep compatibility option. It does not enable hidden fallback algorithms or change the physical model."
InitialBondShells::usage = "InitialBondShells is an init option specifying how many complete bond shells are prepared. symham only evaluates shells prepared by init; request a larger value and rerun init when more shells are needed."
GenerateSymmetryGroup::usage = "GenerateSymmetryGroup is an init option. False (default) uses the supplied records directly as the complete group without an input-stage closure check; True expands symminformation with the existing GenerateGroup function."
RepresentationMode::usage = "RepresentationMode is an init option with value \"DirectProduct\" or \"Induced\"."
CurrentModelSession::usage = "CurrentModelSession[] returns the current native in-memory model session created by init or initfromrep."
CompileMagneticTBInput::usage = "CompileMagneticTBInput[input] compiles ordinary magnetic-group list input or discrete spin-space-group dictionary input into a canonical model, verified representation data, and static directed-bond orbits without legacy globals. GenerateSymmetryGroup controls generator expansion."
brokenSymmetryInitRules::usage = "brokenSymmetryInitRules[generators] returns a complete list of init option rules for the subgroup generated by current symmetry-operation indices or labels. It closes the subgroup and splits current Wyckoff orbits without dropping atoms; use init@@rules explicitly to install the returned model. Use {} for the identity-only subgroup."
symmetrizationHRInit::usage = "symmetrizationHRInit[opts] returns native <|\"wcc\",\"DR\",\"symmetry\"|> data for HR symmetrization using the traditional string options."


(* ::Subsubsection:: *)
(*Plot*)


(*Plot*)
bandManipulate::usage = "bandManipulate[path,npoint,H] creates an interactive band plot for Hamiltonian H along path, with sliders for its symbolic parameters."
plotRange::usage = "plotRange is the public bandplot option that sets the displayed vertical energy range; its default is All."
yTicks::usage = "yTicks is a bandplot/showband option accepting Automatic, None, numeric tick positions, or standard tick specifications."

bandplot ::usage="bandplot[path,npoint,H,rules] plots numerical bands after applying parameter rules. path may be Automatic after init. Use plotRange, yTicks, FontSize, and FontFamily to control the display."
showband::usage = "showband[path,npoint,H,rules] is the presentation-oriented alias of bandplot. After init, showband[npoint,H,rules] automatically uses the conventional path of the current lattice."
banddata::usage = "banddata[path,npoint,H,rules,file] exports numerical band eigenvalues along path to file."
standardKPath::usage = "standardKPath[] returns a conventional high-symmetry path in reciprocal fractional coordinates for the current standardized lattice, including the 25 Brillouin-zone variations of the 14 three-dimensional Bravais lattices. Display labels follow the Bradley-Cracknell convention when available and otherwise retain the Setyawan-Curtarolo label."
showCrystalStructure::usage = "showCrystalStructure[] draws the current primitive cell and atoms; atoms carrying nonzero magnetic moments are marked by arrows."
showBrillouinZone::usage = "showBrillouinZone[] draws the first Brillouin zone and overlays the automatically selected conventional high-symmetry k path."
plotWilsonLoop::usage = "plotWilsonLoop[H,centers,occupied,start,end,parameterPath] plots Wilson-loop phase branches while translating the closed loop start->end along an explicit offset path or connected labeled path. Use \"PhaseConvention\"->\"WannierCenters\" for centers modulo one and \"Output\"->\"Data\" for sampled values."
plotSurfaceSpectrum::usage = "plotSurfaceSpectrum[data,path,{emin,emax}] plots the semi-infinite surface spectral weight -Im Tr[Gsurface]/Pi along a two-dimensional surface-momentum path using the hopping-based surface Green function. Use \"Output\"->\"Data\" for the sampled energy-momentum grid."
plotBerryCurvature2D::usage = "plotBerryCurvature2D[H,centers,occupied,{{u1,u2},{v1,v2}}] samples the existing Wilson-plaquette berryCurvature on an oriented momentum plane and returns a signed density plot. Directions selects the two coordinates, FixedCoordinates selects the slice, and Output->\"Data\" returns the sampled curvature grid."
plotBerryCurvature3D::usage = "plotBerryCurvature3D[H,centers,occupied,{{k1min,k1max},{k2min,k2max},{k3min,k3max}}] plots the Berry-curvature vector field with components {F23,F31,F12}. Arrow direction shows orientation, while length and color show magnitude; Output->\"Data\" returns the complete vector grid."
plotRealSpaceWavefunction::usage = "plotRealSpaceWavefunction[data,state] maps a finite-system wavefunction onto the BasisRecords returned by buildRealSpaceHamiltonian[...,\"Output\"->\"Data\"]. Orbitals at the same atomic position are combined by default; sphere volume represents probability and PhaseColoring optionally displays the representative complex phase."
showSymmetryRepresentations::usage = "showSymmetryRepresentations[] displays the cached full representation matrices for the symmetry generators. Use All, one operation index, or a list of indices to select other prepared operations."
orbitalTable::usage = "orbitalTable[] returns a Grid displaying the fixed Hamiltonian orbital numbering prepared by init, including Wyckoff orbit, equivalent atom, fractional and Cartesian positions, input and actual basis states, and extensible spin-state metadata. It never evaluates symham or mutates the model session."
showHamiltonianBasis::usage = "showHamiltonianBasis[] displays the Hamiltonian basis order prepared by init or initfromrep, including site, Wyckoff orbit, equivalent atom, position, and local orbital. Function-basis induced mode shows the transformed basis state; explicit-representation induced mode shows abstract orbital labels with transport provenance. showHamiltonianBasis[i,j] identifies the row (bra) and column (ket) basis states of H[[i,j]]."
showHoppingParameters::usage = "showHoppingParameters[n] displays the representative real-space hopping matrix elements from which each independent parameter of cached symham[n] originates. showHoppingParameters[n,p] displays every symmetry-propagated real-space occurrence of parameter p. It never evaluates symham implicitly."


