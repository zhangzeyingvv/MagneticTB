(* ::Subsubsection:: *)
(*Utilities*)


symhamII::usage = "symhamII[H] rewrites a Bloch Hamiltonian from convention I to convention II. The string option \"wcc\" supplies explicit orbital centers; its default None uses centers prepared by init."
showbonds ::usage = "showbonds[n] displays the cached bond length and directed bonds for the (n-1)-th neighbour shell prepared by init. It never extends the bond search."
GenerateGroup::usage = "GenerateGroup[generators,identity,multiply] generates a finite group with the supplied multiplication function. SameTest selects the group-element equality predicate and defaults to SameQ."
getGenerator::usage = "getGenerator[group,identity,multiply] is a deprecated compatibility wrapper that greedily finds generators using the canonical abstract-group module. SameTest defaults to SameQ."
showMSGWyckoff::usage = "showMSGWyckoff[group] displays the complete magnetic Wyckoff table for a database group."


msgop::usage = "msgop[group] returns the magnetic-space-group operations for a magnetic group specified by a MagneticTB database identifier such as gray[n], typeI[n], typeIII[n], or typeIV[n]."
mlgop::usage = "mlgop[group] returns ordered magnetic layer-group operations from the bundled database."
mrgop::usage = "mrgop[group] returns ordered magnetic rod-group operations from the bundled database."
texOutput ::usage =""


(* ::Subsubsection:: *)
(*Fitting*)


bandManipulateEig::usage = "bandManipulateEig[H,referenceBands] opens an interactive overlay of the eigenvalues of H and numeric reference bands such as the output of vaspEig."
fittingTB::usage = "fittingTB[H,eigenvalueData,kRange,initialRules] fits an affine-linear tight-binding Hamiltonian by minimizing selected TB-reference band residuals with a finite-difference Levenberg-Marquardt algorithm. kRange retains its legacy meaning as 1-based record indices. EnergyWindow selects reference energies inclusively; KPointNeighborhood selects a periodic minimum-image radius or component range around a fractional reciprocal coordinate; BandSelection selects 1-based reference positions; and ResidualWeights supplies a nonnegative record-by-band weight matrix. Selectors are intersected. Sorted model eigenvalue j is paired with reference position j. The result reports UsedKPointCount, UsedKPointIndices, ResidualCount, the effective band selection, convergence diagnostics, objective values, and a ComparisonPlot. The default options preserve the legacy all-record/all-band behavior."
vaspEig::usage = "vaspEig[file,efermi,spin,startBand,endBand] reads selected bands from a VASP EIGENVAL file and returns {{kx,ky,kz},{energy1,...}} records shifted by efermi."
compareBand::usage = "compareBand[path,npoint,H,rules,referenceBands] overlays tight-binding bands from H with supplied reference eigenvalues. plotRange controls the displayed energy interval."
EndPackage[]
