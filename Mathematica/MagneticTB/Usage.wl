pointMatrix  ::usage = "pointMatrix[operations,basis,lattice] compiles exact unitary point-operation matrices with the traditional input form."
tokpathvasp ::usage = ""


realham2d ::usage=""



(* ::Subsubsection:: *)
(*IO*)


(*
Interface
*)
hop::usage = "hop[n,rules] exports cached real-space hopping matrices for shells 1 through n in wannier90_hr.dat format, while hop[{n1,n2,...},rules] exports selected solved shells. hop[ham,rules] remains available as a separate converter for hand-written exponential H(k); \"wcc\" defaults to Automatic, which uses centers from the current model session when available and otherwise uses zero centers."
readHR::usage = "readHR[file] strictly reads a complete wannier90_hr.dat file and returns structured real-space H(R) data. Set \"ncell\"->n only when an explicit cell cutoff is desired."


(* ::Subsubsection:: *)
(*Real-space hopping and surfaces*)


hoppingData::usage = "hoppingData[n,rules] returns numeric real-space hopping blocks H(R) for cached symham shells 1 through n; hoppingData[{n1,n2,...},rules] selects explicit cached shells. It reads the real-space shell cache directly and never reconstructs hopping from H(k)."
transformHoppings::usage = "transformHoppings[data,T] transforms hopping blocks H(R) to the cell whose direct-lattice row vectors are T times the old lattice. T must be a nonsingular 3 by 3 integer matrix; exact Smith decomposition determines all cell representatives without a spatial cutoff."
buildBlochHamiltonian::usage = "buildBlochHamiltonian[data,{k1,k2,k3}] constructs the fully three-dimensionally periodic Bloch Hamiltonian directly from hopping blocks H(R). CellMatrix->T first creates the exact integer supercell, so the returned matrix has Abs[Det[T]] times the original orbital dimension and k is expressed in the supercell reciprocal fractional basis."
buildRealSpaceHamiltonian::usage = "buildRealSpaceHamiltonian[data,{n1,n2,n3}] builds a sparse rectangular finite Hamiltonian from hopping blocks H(R). The second argument may instead be any nonempty duplicate-free list of integer cell coordinates, producing an arbitrary open-boundary shape. Output->\"Data\" includes matrix-aligned BasisRecords for real-space plotting."
buildSlabHamiltonian::usage = "buildSlabHamiltonian[data,{n1,n2,n3},k] builds a hopping-based hybrid-space Hamiltonian with continuous crystal momentum k along PeriodicDirections and finite open cells along the remaining directions. The default PeriodicDirections->{1,2} gives a slab normal to axis 3; one periodic direction gives a ribbon or rod."
surfaceGreenFunction::usage = "surfaceGreenFunction[data,{k1,k2},energy] computes the retarded semi-infinite surface Green function directly from hopping blocks H(R) using principal-layer decimation. The first two cell axes span the surface and the third is the stacking direction; CellMatrix may transform the cell first."
surfaceSpectralFunction::usage = "surfaceSpectralFunction[data,{k1,k2},energy] returns -Im Tr[Gsurface]/Pi from the hopping-based semi-infinite surface Green function."
pointChernNumber::usage = "pointChernNumber[H,occupied,k0,r] computes the integer Chern charge enclosed by an oriented cube of radius r around the three-dimensional momentum point k0. H may be a numeric-momentum function H[k] or a matrix using kx, ky, kz; the occupied subspace must remain gapped on the enclosing surface."
findGaplessPoints::usage = "findGaplessPoints[H,occupied] searches the periodic Brillouin zone for zeros of the direct gap between bands occupied and occupied+1 using a periodic eigenvalue-only grid followed by bounded local minimization of gap^2. CandidateCount caps the total refinement seeds; RefinementMethod selects \"PrincipalAxis\" (default) or \"QuasiNewton\". H may be a numeric-momentum function or a matrix using kx, ky, kz; use Output->\"Data\" for search diagnostics."


(* ::Subsubsection:: *)
(*Wilson*)


(*Wilson loop (testing)*)
wLoop ::usage = "init"
berryph ::usage = ""
z2path ::usage =""
wilsonLoop ::usage = "wilsonLoop[h,wcc,occ,start,end] computes the tight-binding Wilson-loop phases (in units of Pi) for an isolated occupied subspace along the forward reciprocal-lattice loop start to end. The implementation uses SVD-unitarized occupied-subspace links and the orbital-center sewing matrix. Use \"Output\"->\"WannierCenters\", \"Eigenvalues\", or \"Data\" for alternate results and diagnostics."
berryPhase::usage = "berryPhase[h,wcc,occ,path] computes the gauge-invariant total Berry phase in radians for an isolated occupied subspace along an explicitly sampled closed momentum path. The endpoint may differ from the start by a reciprocal-lattice vector; orbital-center sewing and SVD-unitarized links follow wilsonLoop conventions."
berryCurvature::usage = "berryCurvature[h,wcc,occ,k] computes the total occupied-subspace Berry curvature at k from the oriented Berry flux through a small Wilson plaquette. Directions selects the coordinate plane, StepSize controls the plaquette, and Output->\"Data\" returns diagnostics."
