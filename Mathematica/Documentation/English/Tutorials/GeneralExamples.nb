e, PlotRangePadding -> {{0, 0}, {Scaled[0.05], Scaled[0.05]}}, Ticks -> {Automatic, Automatic}}]], "Output"], Cell["Spinful MoS2 and two explicit basis orders", "Subsection"], Cell["For the spinful onsite Hamiltonian, first place all spin-up orbitals before the spin-down orbitals. Specify the reduced symmetry in init before calculating the Hamiltonian:", "Text"], Cell[BoxData["moS2SpinAOperations = msgop[gray[187]];\ninit[\n  lattice -> {\n    {a, 0, 0},\n    {-a/2, Sqrt[3] a/2, 0},\n    {0, 0, c}\n  },\n  lattpar -> {a -> 1, c -> 4},\n  wyckoffposition -> {{{0, 0, 0}, {0, 0, 0}}},\n  symminformation -> moS2SpinAOperations,\n  basisFunctions -> {{\"dz2up\", \"dxyup\", \"dx2-y2up\", \"dz2dn\", \"dxydn\", \"dx2-y2dn\"}},\n  InitialBondShells -> 1,\n  GenerateSymmetryGroup -> False\n];\nmoS2SpinARules = brokenSymmetryInitRules[{9, 11, 13}];\ninit @@ moS2SpinARules;\nmoS2SpinAHamiltonian = symham[1];"], "Input"], Cell[BoxData["orbitalTable[]"], "Input"], Cell[BoxData[TagBox[GridBox[{{TemplateBox[{"\"Hamiltonian dimension = \"", "6", "\"; representation mode = \"", "\"DirectProduct\""}, "RowDefault"], "\:f3ba", "\:f3ba", "\:f3ba", "\:f3ba", "\:f3ba", "\:f3ba", "\:f3ba", "\:f3ba", "\:f3ba", "\:f3ba", "\:f3ba"}, {"\"H index\"", "\"Site\"", "\"Wyckoff orbit\"", "\"Atom\"", "\"Fractional position\"", "\"Cartesian position\"", "\"Local orbital\"", "\"Input basis\"", "\"Actual basis state\"", "\"Spin structure\"", "\"Spin state\"", "\"Transport operation\""}, {"1", "1", "1", "1", RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], "1", "\"dz2up\"", RowBox[{"{", RowBox[{RowBox[{RowBox[{"-", SuperscriptBox["x", "2"]}], "-", SuperscriptBox["y", "2"], "+", RowBox[{"2", " ", SuperscriptBox["z", "2"]}]}], ",", "0"}], "}"}], "\"FactorizedSpinor\"", RowBox[{"{", RowBox[{"1", ",", "0"}], "}"}], "None"}, {"2", "1", "1", "1", RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], "2", "\"dxyup\"", RowBox[{"{", RowBox[{RowBox[{"2", " ", "x", " ", "y"}], ",", "0"}], "}"}], "\"FactorizedSpinor\"", RowBox[{"{", RowBox[{"1", ",", "0"}], "}"}], "None"}, {"3", "1", "1", "1", RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], "3", "\"dx2-y2up\"", RowBox[{"{", RowBox[{RowBox[{SuperscriptBox["x", "2"], "-", SuperscriptBox["y", "2"]}], ",", "0"}], "}"}], "\"FactorizedSpinor\"", RowBox[{"{", RowBox[{"1", ",", "0"}], "}"}], "None"}, {"4", "1", "1", "1", RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], "4", "\"dz2dn\"", RowBox[{"{", RowBox[{"0", ",", RowBox[{RowBox[{"-", SuperscriptBox["x", "2"]}], "-", SuperscriptBox["y", "2"], "+", RowBox[{"2", " ", SuperscriptBox["z", "2"]}]}]}], "}"}], "\"FactorizedSpinor\"", RowBox[{"{", RowBox[{"0", ",", "1"}], "}"}], "None"}, {"5", "1", "1", "1", RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], "5", "\"dxydn\"", RowBox[{"{", RowBox[{"0", ",", RowBox[{"2", " ", "x", " ", "y"}]}], "}"}], "\"FactorizedSpinor\"", RowBox[{"{", RowBox[{"0", ",", "1"}], "}"}], "None"}, {"6", "1", "1", "1", RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], "6", "\"dx2-y2dn\"", RowBox[{"{", RowBox[{"0", ",", RowBox[{SuperscriptBox["x", "2"], "-", SuperscriptBox["y", "2"]}]}], "}"}], "\"FactorizedSpinor\"", RowBox[{"{", RowBox[{"0", ",", "1"}], "}"}], "None"}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Grid"]], "Output"], Cell[BoxData["MatrixForm[moS2SpinAHamiltonian]"], "Input"], Cell[BoxData[TagBox[RowBox[{"(", "\:2060", GridBox[{{RowBox[{"-", "e3"}], "0", "0", "0", "0", "0"}, {"0", RowBox[{"-", "e2"}], RowBox[{RowBox[{"-", "\:f74e"}], " ", "e1"}], "0", "0", "0"}, {"0", RowBox[{"\:f74e", " ", "e1"}], RowBox[{"-", "e2"}], "0", "0", "0"}, {"0", "0", "0", RowBox[{"-", "e3"}], "0", "0"}, {"0", "0", "0", "0", RowBox[{"-", "e2"}], RowBox[{"\:f74e", " ", "e1"}]}, {"0", "0", "0", "0", RowBox[{RowBox[{"-", "\:f74e"}], " ", "e1"}], RowBox[{"-", "e2"}]}}, RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> Center], "\:2060", ")"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]], "Output"], Cell["Alternatively, place the spin-up and spin-down states next to each other for each orbital. The order shown by orbitalTable is also the row and column order of the Hamiltonian:", "Text"], Cell[BoxData["moS2SpinBOperations = msgop[gray[187]];\ninit[\n  lattice -> {\n    {a, 0, 0},\n    {-a/2, Sqrt[3] a/2, 0},\n    {0, 0, c}\n  },\n  lattpar -> {a -> 1, c -> 4},\n  wyckoffposition -> {{{0, 0, 0}, {0, 0, 0}}},\n  symminformation -> moS2SpinBOperations,\n  basisFunctions -> {{\"dz2up\", \"dz2dn\", \"dxyup\", \"dxydn\", \"dx2-y2up\", \"dx2-y2dn\"}},\n  InitialBondShells -> 1,\n  GenerateSymmetryGroup -> False\n];\nmoS2SpinBRules = brokenSymmetryInitRules[{9, 11, 13}];\ninit @@ moS2SpinBRules;\nmoS2SpinBHamiltonian = symham[1];"], "Input"], Cell[BoxData["orbitalTable[]"], "Input"], Cell[BoxData[TagBox[GridBox[{{TemplateBox[{"\"Hamiltonian dimension = \"", "6", "\"; representation mode = \"", "\"DirectProduct\""}, "RowDefault"], "\:f3ba", "\:f3ba", "\:f3ba", "\:f3ba", "\:f3ba", "\:f3ba", "\:f3ba", "\:f3ba", "\:f3ba", "\:f3ba", "\:f3ba"}, {"\"H index\"", "\"Site\"", "\"Wyckoff orbit\"", "\"Atom\"", "\"Fractional position\"", "\"Cartesian position\"", "\"Local orbital\"", "\"Input basis\"", "\"Actual basis state\"", "\"Spin structure\"", "\"Spin state\"", "\"Transport operation\""}, {"1", "1", "1", "1", RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], "1", "\"dz2up\"", RowBox[{"{", RowBox[{RowBox[{RowBox[{"-", SuperscriptBox["x", "2"]}], "-", SuperscriptBox["y", "2"], "+", RowBox[{"2", " ", SuperscriptBox["z", "2"]}]}], ",", "0"}], "}"}], "\"FactorizedSpinor\"", RowBox[{"{", RowBox[{"1", ",", "0"}], "}"}], "None"}, {"2", "1", "1", "1", RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], "2", "\"dz2dn\"", RowBox[{"{", RowBox[{"0", ",", RowBox[{RowBox[{"-", SuperscriptBox["x", "2"]}], "-", SuperscriptBox["y", "2"], "+", RowBox[{"2", " ", SuperscriptBox["z", "2"]}]}]}], "}"}], "\"FactorizedSpinor\"", RowBox[{"{", RowBox[{"0", ",", "1"}], "}"}], "None"}, {"3", "1", "1", "1", RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], "3", "\"dxyup\"", RowBox[{"{", RowBox[{RowBox[{"2", " ", "x", " ", "y"}], ",", "0"}], "}"}], "\"FactorizedSpinor\"", RowBox[{"{", RowBox[{"1", ",", "0"}], "}"}], "None"}, {"4", "1", "1", "1", RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], "4", "\"dxydn\"", RowBox[{"{", RowBox[{"0", ",", RowBox[{"2", " ", "x", " ", "y"}]}], "}"}], "\"FactorizedSpinor\"", RowBox[{"{", RowBox[{"0", ",", "1"}], "}"}], "None"}, {"5", "1", "1", "1", RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], "5", "\"dx2-y2up\"", RowBox[{"{", RowBox[{RowBox[{SuperscriptBox["x", "2"], "-", SuperscriptBox["y", "2"]}], ",", "0"}], "}"}], "\"FactorizedSpinor\"", RowBox[{"{", RowBox[{"1", ",", "0"}], "}"}], "None"}, {"6", "1", "1", "1", RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], "6", "\"dx2-y2dn\"", RowBox[{"{", RowBox[{"0", ",", RowBox[{SuperscriptBox["x", "2"], "-", SuperscriptBox["y", "2"]}]}], "}"}], "\"FactorizedSpinor\"", RowBox[{"{", RowBox[{"0", ",", "1"}], "}"}], "None"}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Grid"]], "Output"], Cell[BoxData["MatrixForm[moS2SpinBHamiltonian]"], "Input"], Cell[BoxData[TagBox[RowBox[{"(", "\:2060", GridBox[{{RowBox[{"-", "e3"}], "0", "0", "0", "0", "0"}, {"0", RowBox[{"-", "e3"}], "0", "0", "0", "0"}, {"0", "0", RowBox[{"-", "e2"}], "0", RowBox[{RowBox[{"-", "\:f74e"}], " ", "e1"}], "0"}, {"0", "0", "0", RowBox[{"-", "e2"}], "0", RowBox[{"\:f74e", " ", "e1"}]}, {"0", "0", RowBox[{"\:f74e", " ", "e1"}], "0", RowBox[{"-", "e2"}], "0"}, {"0", "0", "0", RowBox[{RowBox[{"-", "\:f74e"}], " ", "e1"}], "0", RowBox[{"-", "e2"}]}}, RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> Center], "\:2060", ")"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]], "Output"], Cell["Magnetic C3 Weyl point and Chern diagnostic", "Section"], Cell["For magnetic space group 143.3, the local spinor pair gives a four-band Hamiltonian. As in the MagneticTB 1.0 example, select the two-band block with row and column indices {1,4}. The replacement c3OriginalParameterCoordinates puts its parameters in the 1.0 convention before numerical values are assigned.", "Text"], Cell["The parameters in this Weyl model and the following nodal-line and C4 models illustrate symmetry-allowed band structures. They are the values used in the MagneticTB 1.0 examples, not fitted parameters for a particular material.", "Text"], Cell[BoxData["c3Operations = msgop[bnsdict[{143, 3}]];\ninit[\n  lattice -> {\n    {Sqrt[3] a/2, -a/2, 0},\n    {0, a, 0},\n    {0, 0, c}\n  },\n  lattpar -> {a -> 1, c -> 2},\n  wyckoffposition -> {\n    {{0, 0, 0}, {0, 0, 1}}\n  },\n  symminformation -> c3Operations,\n  basisFunctions -> {{{x + I y, 0}, {0, x - I y}}},\n  InitialBondShells -> 4,\n  GenerateSymmetryGroup -> False\n];\nc3Full = Sum[symham[i], {i, {2, 3, 4}}];\nc3OriginalParameterCoordinates = {\n  r11 -> -r2, r15 -> -r10,\n  r3 -> -r6, r7 -> -r14,\n  s4 -> -s4,\n  t4 -> t1, t8 -> t9, t11 -> -t7\n};\nc3Hamiltonian =\n  c3Full[[{1, 4}, {1, 4}]] /.\n    c3OriginalParameterCoordinates;"], "Input"], Cell["The full two-band c3Hamiltonian is used for the band plot and Chern-number calculation below. To see its matrix elements more clearly, first display it on Gamma-A by setting kx=ky=0:", "Text"], Cell[BoxData["c3GammaAxisHamiltonian = FullSimplify[\n  c3Hamiltonian /. {kx -> 0, ky -> 0},\n  Element[kz, Reals]\n];\nMatrixForm[c3GammaAxisHamiltonian]"], "Input"], Cell[BoxData[TagBox[RowBox[{"(", "\:2060", GridBox[{{RowBox[{"6", " ", RowBox[{"(", RowBox[{"s8", "+", "t9"}], ")"}]}], RowBox[{RowBox[{"-", "2"}], " ", "\:f74e", " ", RowBox[{"(", RowBox[{RowBox[{"3", " ", "r10"}], "-", RowBox[{"3", " ", "r14"}], "+", RowBox[{"3", " ", "\:f74e", " ", "r2"}], "-", RowBox[{"3", " ", "\:f74e", " ", "r6"}], "+", "t15", "-", RowBox[{"\:f74e", " ", "t7"}]}], ")"}], " ", RowBox[{"Sin", "[", FractionBox["kz", "2"], "]"}]}]}, {RowBox[{"2", " ", "\:f74e", " ", RowBox[{"(", RowBox[{RowBox[{"3", " ", "r10"}], "-", RowBox[{"3", " ", "r14"}], "-", RowBox[{"3", " ", "\:f74e", " ", "r2"}], "+", RowBox[{"3", " ", "\:f74e", " ", "r6"}], "+", "t15", "+", RowBox[{"\:f74e", " ", "t7"}]}], ")"}], " ", RowBox[{"Sin", "[", FractionBox["kz", "2"], "]"}]}], RowBox[{"6", " ", RowBox[{"(", RowBox[{"s8", "+", "t9"}], ")"}]}]}}, RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> Center], "\:2060", ")"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]], "Output"], Cell[BoxData["c3Path = {\n  {{{0, 0, 0}, {1/2, 0, 0}}, {\"G\", \"M\"}},\n  {{{1/2, 0, 0}, {1/3, 1/3, 0}}, {\"M\", \"K\"}},\n  {{{1/3, 1/3, 0}, {0, 0, 0}}, {\"K\", \"G\"}},\n  {{{0, 0, 0}, {0, 0, 1/2}}, {\"G\", \"A\"}},\n  {{{0, 0, 1/2}, {1/2, 0, 1/2}}, {\"A\", \"L\"}},\n  {{{1/2, 0, 1/2}, {1/3, 1/3, 1/2}}, {\"L\", \"H\"}},\n  {{{1/3, 1/3, 1/2}, {0, 0, 1/2}}, {\"H\", \"A\"}},\n  {{{1/2, 0, 1/2}, {1/2, 0, 0}}, {\"L\", \"M\"}},\n  {{{1/3, 1/3, 0}, {1/3, 1/3, 1/2}}, {\"K\", \"H\"}}\n};\nc3Parameters = {\n  r10 -> -0.09, r14 -> 0.25, r2 -> 0, r6 -> 0.5,\n  s4 -> -0.38, s8 -> 0, t1 -> 0,\n  t15 -> 0.735, t7 -> 0.05, t9 -> 0.015\n};"], "Input"], Cell["Use the following command to adjust the parameters and view the bands:", "Text"], Cell[BoxData["bandManipulate[c3Path, 20, c3Hamiltonian]"], "Input"], Cell[BoxData["bandplot[c3Path, 200, c3Hamiltonian, c3Parameters]"], "Input"], Cell[BoxData[GraphicsBox[{{}, InterpretationBox[{TagBox[{{{}, {}, TagBox[{Hue[0.67, 0.6, 0.6], Directive[PointSize[NCache[1/180, 0.005555555555555556]], AbsoluteThickness[2], FontFamily -> "Times", FontSize -> 24, GrayLevel[0]], LineBox[{{0., 0.08999999999999989}, {1., 0.0899896525343097}, {2., 0.08994683466546707}, {3., 0.08985390554113225}, {4., 0.08969327153001116}, {5., 0.08944740794823881}, {6., 0.08909888071719374}, {7., 0.08863036793029429}, {8., 0.08802468130641587}, {9., 0.08726478750768206}, {10., 0.08633382929951743}, {11., 0.08521514653100538}, {12., 0.08389229691377513}, {13., 0.08234907657784026}, {14., 0.08056954038303545}, {15., 0.07853802196493997}, {16., 0.07623915349444223}, {17., 0.07365788513038324}, {18., 0.07077950414502554}, {19., 0.06758965370241705}, {20., 0.0640743512700687}, {21., 0.06022000664472778}, {22., 0.05601343957341472}, {23., 0.051441896951296584}, {24., 0.046493069578388}, {25., 0.041155108457516826}, {26., 0.03541664061644516}, {27., 0.029266784437510657}, {28., 0.022695164478650526}, {29., 0.015691925770170645}, {30., 0.00824774757215102}, {31., 0.00035385657791700553}, {32., -0.007997960450444097}, {33., -0.016815344627970935}, {34., -0.02610535348699139}, {35., -0.03587445012383714}, {36., -0.04612849296377913}, {37., -0.0568727261552385}, {38., -0.06811177060369364}, {39., -0.0798496156550706}, {40., -0.09208961143774558}, {41., -0.10483446187164142}, {42., -0.1180862183522231}, {43., -0.13184627411652391}, {44., -0.14611535929765745}, {45., -0.16089353667357267}, {46., -0.1761801981151201}, {47., -0.1919740617377981}, {48., -0.20827316976083557}, {49., -0.22507488707657