Notebook[{Cell[CellGroupData[{Cell["CyclotomicCommonNullSpace", "ObjectName"], Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["CyclotomicCommonNullSpace[{matrix1,matrix2,...}]"], "InlineFormula"], " \:2028", "accepts ordinary exact Wolfram Language matrices and returns a row basis for their common null space."}], "Usage"], Cell["This is the main entry for ordinary exact matrices. If rows is the returned list, Transpose[rows] is the column-basis matrix and every input block Ai satisfies Ai . Transpose[rows] == 0 exactly.", "Notes"], Cell["Supported scalar inputs include exact integers and rationals, I, square roots of exact rationals, roots of unity written with rational-angle Exp, Sin, or Cos, Conjugate, and exact sums, products, and supported powers of these expressions. Machine numbers, symbolic parameters, and unsupported algebraic numbers such as general cube roots return Failure.", "Notes"], Cell["All matrices must have the same column count. Empty constraints require CoordinateDimension because no matrix is available from which to infer that count.", "Notes"], Cell["The function compiles one exact field and calls the production iterative common-kernel algorithm. It does not use the built-in NullSpace or RowReduce and never changes to floating point, SVD, stacked constraints, or another fallback.", "Notes"], Cell[BoxData[GridBox[{{Cell["      ", "TableRowIcon"], "\"CoordinateDimension\"", "Automatic", Cell["Number of vector coordinates. Automatic infers the common column count from nonempty input; an explicit nonnegative integer is required when the constraint list is empty.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"MaxCyclotomicDegree\"", "128", Cell["Positive integer upper bound on the exact cyclotomic field degree. Exceeding the bound returns Failure instead of using approximate arithmetic.", "TableText"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxDividers -> {"Rows" -> {{False}}}, GridBoxSpacings -> {"Columns" -> {Offset[0.27999999999999997], {Offset[0.7]}, Offset[0.27999999999999997]}, "Rows" -> {Offset[0.2], {Offset[0.8]}, Offset[0.2]}}]], "3ColumnTableMod"]}, Open]], Cell[CellGroupData[{Cell["Examples Initialization", "ExamplesInitializationSection"], Cell[BoxData["Needs[\"MagneticTB`\"]"], "ExampleInitialization"]}, Open]], Cell[CellGroupData[{Cell["Basic Examples", "PrimaryExamplesSection"], Cell["Find the common null space of two ordinary exact constraint blocks containing three independent square roots. The two displayed residual matrices are exactly zero:", "ExampleText"], Cell[BoxData["constraintBlocks = {\n  {\n    {1, 0, 0, -Sqrt[2], 0},\n    {0, 1, 0, -Sqrt[3], 0}\n  },\n  {{0, 0, 1, -Sqrt[5], 0}}\n};\ncommonRows = CyclotomicCommonNullSpace[constraintBlocks];\n{\n  MatrixForm[commonRows],\n  MatrixForm /@ (# . Transpose[commonRows] & /@ constraintBlocks)\n}"], "Input"], Cell[BoxData[RowBox[{"{", RowBox[{TagBox[RowBox[{"(", "\:2060", GridBox[{{SqrtBox["2"], SqrtBox["3"], SqrtBox["5"], "1", "0"}, {"0", "0", "0", "0", "1"}}, RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> Center], "\:2060", ")"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]], ",", RowBox[{"{", RowBox[{TagBox[RowBox[{"(", "\:2060", GridBox[{{"0", "0"}, {"0", "0"}}, RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> Center], "\:2060", ")"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]], ",", TagBox[RowBox[{"(", "\:2060", GridBox[{{"0", "0"}}, RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> Center], "\:2060", ")"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]}], "}"}]}], "}"}]], "Output"]}, Open]], Cell[CellGroupData[{Cell["More Examples", "ExtendedExamplesSection", CellTags -> "ExtendedExamples"], Cell[CellGroupData[{Cell["Options", "ExampleSection"], Cell[CellGroupData[{Cell["CoordinateDimension", "ExampleSubsection"], Cell["CoordinateDimension fixes the vector space when the constraint list is empty. With three coordinates, the complete row basis is the identity:", "ExampleText"], Cell[BoxData["CyclotomicCommonNullSpace[\n  {},\n  \"CoordinateDimension\" -> 3\n]"], "Input"], Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]], "Output"]}, Open]], Cell[CellGroupData[{Cell["MaxCyclotomicDegree", "ExampleSubsection"], Cell["MaxCyclotomicDegree bounds the exact field degree, not a numerical tolerance. The fourth-root field has degree two, so limit two succeeds and limit one fails:", "ExampleText"], Cell[BoxData["{\n  CyclotomicCommonNullSpace[\n    {{{I, 1}}},\n    \"MaxCyclotomicDegree\" -> 2\n  ],\n  CyclotomicCommonNullSpace[\n    {{{I, 1}}},\n    \"MaxCyclotomicDegree\" -> 1\n  ][[1]]\n}"], "Input"], Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"{", RowBox[{"\:f74e", ",", "1"}], "}"}], "}"}], ",", "\"ConductorDegreeLimitExceeded\""}], "}"}]], "Output"]}, Open]]}, Open]], Cell[CellGroupData[{Cell["Properties & Relations", "ExampleSection"], Cell["For a zero-dimensional vector space, empty constraints return the unique empty row basis:", "ExampleText"], Cell[BoxData["CyclotomicCommonNullSpace[\n  {},\n  \"CoordinateDimension\" -> 0\n]"], "Input"], Cell[BoxData[RowBox[{"{", "}"}]], "Output"]}, Open]], Cell[CellGroupData[{Cell["Possible Issues", "ExampleSection"], Cell["Without a nonempty matrix or an explicit CoordinateDimension, the vector-space dimension is undefined:", "ExampleText"], Cell[BoxData["missingDimension = CyclotomicCommonNullSpace[{}];\n<|\"FailureTag\" -> missingDimension[[1]]|>"], "Input"], Cell[BoxData[RowBox[{"\:f113", RowBox[{"\"FailureTag\"", "\:f522", "\"CoordinateDimensionRequired\""}], "\:f114"}]], "Output"], Cell["All blocks must have the same number of columns:", "ExampleText"], Cell[BoxData["dimensionFailure = CyclotomicCommonNullSpace[{\n  {{1, 0}},\n  {{1, 0, 0}}\n}];\n<|\"FailureTag\" -> dimensionFailure[[1]]|>"], "Input"], Cell[BoxData[RowBox[{"\:f113", RowBox[{"\"FailureTag\"", "\:f522", "\"DimensionMismatch\""}], "\:f114"}]], "Output"], Cell["Machine numbers and unsupported exact algebraic expressions fail for different reasons; neither is approximated or sent to a numerical fallback:", "ExampleText"], Cell[BoxData["{\n  CyclotomicCommonNullSpace[{{{0.5}}}][[1]],\n  CyclotomicCommonNullSpace[{{{2^(1/3)}}}][[1]]\n}"], "Input"], Cell[BoxData[RowBox[{"{", RowBox[{"\"NonExactInput\"", ",", "\"UnsupportedScalarInput\""}], "}"}]], "Output"]}, Open]]}, Open]], Cell[CellGroupData[{Cell["Related Functions", "SeeAlsoSection"], Cell[TextData[{ButtonBox["CompileCyclotomicMatrices", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/CompileCyclotomicMatrices"], " \:25aa ", ButtonBox["CyclotomicCommonKernel", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/CyclotomicCommonKernel"], " \:25aa ", ButtonBox["CyclotomicNullSpace", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/CyclotomicNullSpace"], " \:25aa ", ButtonBox["RestoreCyclotomicExpression", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/RestoreCyclotomicExpression"]}], "SeeAlso"]}, Open]], Cell[CellGroupData[{Cell["Related Guides", "MoreAboutSection"], Cell[TextData[{ButtonBox["MagneticTB", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/guide/MagneticTB"]}], "MoreAbout"]}, Open]], Cell[CellGroupData[{Cell["Related Tutorials", "TutorialsSection"], Cell[TextData[{ButtonBox["Getting Started with MagneticTB", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/tutorial/GettingStarted"]}], "Tutorials"]}, Open]], Cell[CellGroupData[{Cell["History", "HistorySection"], Cell[TextData[{"New in: ", Cell["2.0.0", "HistoryData", CellTags -> "New"], " | Modified in: ", Cell[" ", "HistoryData", CellTags -> "Modified"], " | Obsolete in: ", Cell[" ", "HistoryData", CellTags -> "Obsolete"]}], "History"]}, Closed]], Cell[CellGroupData[{Cell["Categorization", "CategorizationSection"], Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], Cell["MagneticTB", "Categorization", CellLabel -> "Paclet Name"], Cell["MagneticTB`", "Categorization", CellLabel -> "Context"], Cell["MagneticTB/ref/CyclotomicCommonNullSpace", "Categorization", CellLabel -> "URI"]}, Closed]], Cell[CellGroupData[{Cell["Keywords", "KeywordsSection"], Cell["exact common null space", "Keywords"], Cell["ordinary matrices", "Keywords"], Cell["cyclotomic field", "Keywords"]}, Closed]]}, TaggingRules -> <|"Paclet" -> "MagneticTB"|>, WindowTitle -> "CyclotomicCommonNullSpace", StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "FunctionPageStylesExt.nb", CharacterEncoding -> "UTF-8"]]