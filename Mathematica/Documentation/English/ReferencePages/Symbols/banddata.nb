Notebook[{Cell[CellGroupData[{Cell["banddata", "ObjectName"], Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["banddata[path,npoint,H,rules,file]"], "InlineFormula"], " \:2028", "writes the numerical band energies of H along path to a data file."}], "Usage"], Cell["After applying rules, the function samples the same reciprocal-fractional path convention used by bandplot. Each sampled momentum occupies one row of the file, and each band occupies one column.", "Notes"], Cell["Use FileNameJoin rather than a machine-specific literal path in notebooks that will be shared.", "Notes"]}, Open]], Cell[CellGroupData[{Cell["Examples Initialization", "ExamplesInitializationSection"], Cell[BoxData["Needs[\"MagneticTB`\"]"], "ExampleInitialization"]}, Open]], Cell[CellGroupData[{Cell["Basic Examples", "PrimaryExamplesSection"], Cell["Initialize graphene, construct its Hamiltonian and reciprocal-space path, and choose a portable temporary CSV file:", "ExampleText"], Cell[BoxData["Needs[\"MagneticTB`\"];\ngrapheneOperations = msgop[gray[191]];\ninit[\n  lattice -> {\n    {a, 0, 0},\n    {-a/2, Sqrt[3] a/2, 0},\n    {0, 0, c}\n  },\n  lattpar -> {a -> 1, c -> 3},\n  wyckoffposition -> {\n    {{1/3, 2/3, 0}, {0, 0, 0}}\n  },\n  symminformation -> grapheneOperations,\n  basisFunctions -> {{\"pz\"}}\n];\ngrapheneHamiltonian = Sum[symham[i], {i, 3}];\ngraphenePath = {\n  {{{0, 0, 0}, {0, 1/2, 0}}, {\"G\", \"M\"}},\n  {{{0, 1/2, 0}, {1/3, 1/3, 0}}, {\"M\", \"K\"}},\n  {{{1/3, 1/3, 0}, {0, 0, 0}}, {\"K\", \"G\"}}\n};\ngrapheneBandFile = FileNameJoin[{$TemporaryDirectory, \"graphene-band.csv\"}];"], "Input"], Cell["Export the sampled band energies. Each row of the CSV file is one momentum point and each column is one band:", "ExampleText"], Cell[BoxData["banddata[graphenePath, 10, grapheneHamiltonian, {e1 -> 0.05, r1 -> 0.02, t1 -> 0.5}, grapheneBandFile];"], "Input"], Cell["Import the CSV file and plot the two graphene bands:", "ExampleText"], Cell[BoxData["grapheneBandEnergies = Import[grapheneBandFile, \"CSV\"];\nListPlot[Transpose[grapheneBandEnergies]]"], "Input"], Cell[BoxData[GraphicsBox[{{}, InterpretationBox[{TagBox[{TagBox[{RGBColor[0.368417, 0.506779, 0.709798], PointSize[0.011000000000000001], AbsoluteThickness[2], PointBox[CompressedData["\n1:eJxTTMoPSmViYGBQBGIQDQEf7D0eVomsc/+6HyrgcGJ537Y2ERifw8HDXbR0\nZ/UXKF/AIeN+xMS6+s9QvohDyC9GuxSVT1C+hIPF9t4jl4s+QPkyDp/91r6/\n/PkNlK/g0JK5+7bPqhdQvpLDK6F7Wh8LnkD5Kg5P9DN1uHgfQvlqDnH9h75q\nxNyH8jXQ+FoOVfn1xj2cML6Ow6rDVpNUhe5B+XoO09M2cHiU34HyDRy4KmNX\nm1rfgvINHUR27SswSrwO5Rs5tOeenj/n7WUo39hBgXlZhNCZ81C+iYNixsxr\nhxcdg/JNHS4FyKjyPtgB5Zs5vAKG5sOqFijfHI1v4bDKzZXVKOoklG/p0N+q\n0+KgdhPKt3KIznat2rbrEZRv7eAaeP5SUQcsvGwcQL7vP/QWyrd16HGQ/XdJ\n9iOUb+fgwDp/gclLWHzYO9RNNH4jaQGLPweHWef/l9QzQ+O3wcEBFv8A4nak\nTw==\n          "]]}, Annotation[#1, "Charting`Private`Tag#1"] & ], TagBox[{RGBColor[0.880722, 0.611041, 0.142051], PointSize[0.011000000000000001], AbsoluteThickness[2], PointBox[CompressedData["\n1:eJxTTMoPSmViYGBQBGIQDQEf7HfItb4O3PHLHirgsKD1l5F4KozP4eAzo3aV\ncf5PKF/AwWjlCfs/D79D+SIO/Fnv4wwufIXyJRykjBYVSYd8hvJlHBp1hYzX\nTvgA5Ss4lB/UNS/Ieg3lKzlkxcRXSPM/g/JVHPbEP37N/vEhlK/mEAx24AMo\nXwONr+VwUdxQoFIRxtdxCLJba35a8T6Ur+eQ9TbB5YPLXSjfwMGvdYHAzc23\noHxDh2kViwx2VlyH8o0cpFOnnHNccBnKN3b4+On7i1VF56B8E4fl38oeJKw8\nAuWbOvCGWiopC22B8s0cuETWuT+satkP4Zuj8S0cZEV+ywp2HYeqt3Q46Weq\n119xE8q3cmhc1bnm4dfHUL61A/eMhJQaO1h42TjIg6JL7iOUb+vgc/rIjI3e\nX6B8O4eM9z9+Of36BuXbO0i8O31oJTMs/hwcnhtU7a3xhMZvg4MDLP4BWcmW\nIg==\n          "]]}, Annotation[#1, "Charting`Private`Tag#2"] & ]}, {"WolframDynamicHighlight", Association["Label" -> {"XYLabel"}, "Ball" -> {"IndicatedBall"}]}], StyleBox[DynamicBox[(Charting`HighlightActionBox["DynamicHighlight", {}, #HighlightElements, #LayoutOptions, #Meta, Charting`HighlightActionFunction["DynamicHighlight", {{Annotation[{Directive[PointSize[0.011000000000000001], RGBColor[0.368417, 0.506779, 0.709798], AbsoluteThickness[2]], Point[CompressedData["\n1:eJxTTMoPSmViYGBQBGIQDQEf7D0eVomsc/+6HyrgcGJ537Y2ERif