Notebook[{Cell[CellGroupData[{Cell["readHR", "ObjectName"], Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["readHR[file]"], "InlineFormula"], " \:2028", "reads a Wannier90 HR file and returns its lattice translations and real-space hopping matrices."}], "Usage"], Cell["Each lattice translation R in a Wannier90 HR file is paired with a real-space hopping matrix H(R). Its row and column order is the Wannier-orbital order used when the file was written.", "Notes"], Cell["Before returning these matrices, readHR checks the file header, degeneracies, translation vectors, orbital indices, and complex matrix elements. A malformed or incomplete file is rejected.", "Notes"], Cell["Pass the returned Association to buildBlochHamiltonian to recover H(k). For repeated evaluation, define a function such as h[k_List] := buildBlochHamiltonian[hrData,k].", "Notes"], Cell["The ncell option may then keep only translations inside a chosen real-space box.", "Notes"], Cell[BoxData[GridBox[{{Cell["      ", "TableRowIcon"], "\"prec\"", "10^-10", Cell["Nonnegative numerical threshold used to Chop small real and imaginary matrix entries after parsing.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"ncell\"", "All", Cell["All keeps every translation; a nonnegative integer n keeps cells whose largest absolute translation component is at most n.", "TableText"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxDividers -> {"Rows" -> {{False}}}, GridBoxSpacings -> {"Columns" -> {Offset[0.27999999999999997], {Offset[0.7]}, Offset[0.27999999999999997]}, "Rows" -> {Offset[0.2], {Offset[0.8]}, Offset[0.2]}}]], "3ColumnTableMod"]}, Open]], Cell[CellGroupData[{Cell["Examples Initialization", "ExamplesInitializationSection"], Cell[BoxData["Needs[\"MagneticTB`\"]"], "ExampleInitialization"]}, Open]], Cell[CellGroupData[{Cell["Basic Examples", "PrimaryExamplesSection"], Cell["Create a graphene HR file with hop, read it back, reconstruct H(k), and display the Hamiltonian at the Gamma point:", "ExampleText"], Cell[BoxData["grapheneOperations = msgop[gray[191]];\ninit[\n  lattice -> {\n    {a, 0, 0},\n    {-a/2, Sqrt[3] a/2, 0},\n    {0, 0, c}\n  },\n  lattpar -> {a -> 1, c -> 3},\n  wyckoffposition -> {\n    {{1/3, 2/3, 0}, {0, 0, 0}}\n  },\n  symminformation -> grapheneOperations,\n  basisFunctions -> {{\"pz\"}}\n];\nScan[symham, {1, 2, 3}];\nhrFile = FileNameJoin[{$TemporaryDirectory, \"graphene_hr.dat\"}];\nhop[{1, 2, 3}, {e1 -> 0.05, r1 -> 0.02, t1 -> 0.5}, \"hrExport\" -> hrFile, \"wcc\" -> Automatic];\nhrData = readHR[hrFile];\nhrHamiltonian[k_List] := buildBlochHamiltonian[hrData, k];\nMatrixForm@hrHamiltonian[{0, 0, 0}]"], "Input"], Cell[BoxData[TagBox[RowBox[{"(", "\:2060", GridBox[{{"0.17`", "1.5`"}, {"1.5`", "0.17`"}}, RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> Center], "\:2060", ")"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]], "Output"]}, Open]], Cell[CellGroupData[{Cell["More Examples", "ExtendedExamplesSection", CellTags -> "ExtendedExamples"], Cell[CellGroupData[{Cell["Options", "ExampleSection"], Cell[CellGroupData[{Cell["prec", "ExampleSubsection"], Cell["\"prec\" -> 10^-12 chops symmetry-generated hopping entries below that threshold. The 10^-13 non-onsite hopping becomes an exact zero:", "ExampleText"], Cell[BoxData["tinyHRFile = FileNameJoin[{$TemporaryDirectory, \"graphene_tiny_hr.dat\"}];\nhop[\n  {1,2,3}, {e1 -> 1., r1 -> 10^-13, t1 -> 10^-13},\n  \"hrExport\" -> tinyHRFile, \"wcc\" -> Automatic\n];\ntinyHRData = readHR[tinyHRFile, \"prec\" -> 10^-12];\nMatrixForm@First@Pick[\n  tinyHRData[\"HoppingMatrices\"],\n  tinyHRData[\"Translations\"],\n  Except[{0,0,0}]\n]"], "Input"], Cell[BoxData[TagBox[RowBox[{"(", "\:2060", GridBox[{{"0"}}, RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> Center], "\:2060", ")"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]], "Output"]}, Open]], Cell[CellGroupData[{Cell["ncell", "ExampleSubsection"], Cell["\"ncell\" -> 0 keeps only the onsite translation after the complete HR file has been parsed and validated:", "ExampleText"], Cell[BoxData["readHR[hrFile, \"ncell\" -> 0][\"Translations\"]"], "Input"], Cell[BoxData[RowBox[{"{", RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], "}"}]], "Output"]}, Open]]}, Open]]}, Open]], Cell[CellGroupData[{Cell["Related Functions", "SeeAlsoSection"], Cell[TextData[{ButtonBox["hop", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/hop"], " \:25aa ", ButtonBox["symham", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/symham"]}], "SeeAlso"]}, Open]], Cell[CellGroupData[{Cell["Related Guides", "MoreAboutSection"], Cell[TextData[{ButtonBox["MagneticTB", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/guide/MagneticTB"]}], "MoreAbout"]}, Open]], Cell[CellGroupData[{Cell["Related Tutorials", "TutorialsSection"], Cell[TextData[{ButtonBox["Getting Started with MagneticTB", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/tutorial/GettingStarted"]}], "Tutorials"]}, Open]], Cell[CellGroupData[{Cell["History", "HistorySection"], Cell[TextData[{"New in: ", Cell["2.0.0", "HistoryData", CellTags -> "New"], " | Modified in: ", Cell[" ", "HistoryData", CellTags -> "Modified"], " | Obsolete in: ", Cell[" ", "HistoryData", CellTags -> "Obsolete"]}], "History"]}, Closed]], Cell[CellGroupData[{Cell["Categorization", "CategorizationSection"], Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], Cell["MagneticTB", "Categorization", CellLabel -> "Paclet Name"], Cell["MagneticTB`", "Categorization", CellLabel -> "Context"], Cell["MagneticTB/ref/readHR", "Categorization", CellLabel -> "URI"]}, Closed]], Cell[CellGroupData[{Cell["Keywords", "KeywordsSection"], Cell["Wannier90", "Keywords"], Cell["hr.dat", "Keywords"], Cell["import", "Keywords"], Cell["hopping matrices", "Keywords"]}, Closed]]}, TaggingRules -> <|"Paclet" -> "MagneticTB"|>, WindowTitle -> "readHR", StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "FunctionPageStylesExt.nb", CharacterEncoding -> "UTF-8"]]