Notebook[{Cell[CellGroupData[{Cell["hoppingData", "ObjectName"], Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["hoppingData[n,rules]"], "InlineFormula"], " \:2028", "returns numerical real-space hopping blocks for cached shells 1 through n."}], "Usage"], Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["hoppingData[{n1,n2,...},rules]"], "InlineFormula"], " \:2028", "returns numerical blocks for the explicitly selected cached shells."}], "Usage"], Cell["Call init and symham first. hoppingData reads the solved real-space shell cache directly; it never reconstructs hopping amplitudes by Fourier-inverting H(k).", "Notes"], Cell["The returned Association uses H(R)[a,b]=<0,a|H|R,b> and H(k)=Sum_R H(R) Exp[2 Pi I k.R]. Lattice and WannierCenters are included when the current model supplies them.", "Notes"], Cell["hoppingData returns $Failed and issues a message when the shell selection is invalid or unprepared, parameter values remain symbolic, the requested symham option combination was not cached, or cached real-space data are inconsistent. It does not repair the input or switch to an approximate fallback.", "Notes"], Cell[BoxData[GridBox[{{Cell["      ", "TableRowIcon"], "\"Hermitian\"", "True", Cell["Must match the Hermitian setting used when the selected shells were solved by symham.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"KernelMethod\"", "\"Iterative\"", Cell["Must match the exact common-kernel method used by symham.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"ValidationLevel\"", "\"Basic\"", Cell["Must match the validation level used by symham.", "TableText"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxDividers -> {"Rows" -> {{False}}}, GridBoxSpacings -> {"Columns" -> {Offset[0.27999999999999997], {Offset[0.7]}, Offset[0.27999999999999997]}, "Rows" -> {Offset[0.2], {Offset[0.8]}, Offset[0.2]}}]], "3ColumnTableMod"]}, Open]], Cell[CellGroupData[{Cell["Examples Initialization", "ExamplesInitializationSection"], Cell[BoxData["Needs[\"MagneticTB`\"]"], "ExampleInitialization"]}, Open]], Cell[CellGroupData[{Cell["Basic Examples", "PrimaryExamplesSection"], Cell["Solve the nearest-neighbor shell of a one-orbital cubic model and read its numerical real-space blocks from the cache:", "ExampleText"], Cell[BoxData["cubicOperations = msgop[gray[221]];\ninit[\n  lattice -> {{a, 0, 0}, {0, a, 0}, {0, 0, a}},\n  lattpar -> {a -> 1},\n  wyckoffposition -> {{{0, 0, 0}, {0, 0, 0}}},\n  symminformation -> cubicOperations,\n  basisFunctions -> {{\"s\"}},\n  InitialBondShells -> 2,\n  GenerateSymmetryGroup -> False\n];\nsymham[2];\nnearestHoppings = hoppingData[\n  {2},\n  {t1 -> 1}\n];\nGrid[\n  {\n    {\"Translations\", nearestHoppings[\"Translations\"]},\n    {\"HoppingMatrices\", nearestHoppings[\"HoppingMatrices\"]}\n  },\n  Frame -> All, Alignment -> Left\n]"], "Input"], Cell[BoxData[TagBox[GridBox[{{"\"Translations\"", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "0", ",", RowBox[{"-", "1"}]}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "}"}]}, {"\"HoppingMatrices\"", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"{", "1", "}"}], "}"}], ",", RowBox[{"{", RowBox[{"{", "1", "}"}], "}"}], ",", RowBox[{"{", RowBox[{"{", "1", "}"}], "}"}], ",", RowBox[{"{", RowBox[{"{", "1", "}"}], "}"}], ",", RowBox[{"{", RowBox[{"{", "1", "}"}], "}"}], ",", RowBox[{"{", RowBox[{"{", "1", "}"}], "}"}]}], "}"}]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Grid"]], "Output"]}, Open]], Cell[CellGroupData[{Cell["Related Functions", "SeeAlsoSection"], Cell[TextData[{ButtonBox["symham", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/symham"], " \:25aa ", ButtonBox["transformHoppings", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/transformHoppings"]}], "SeeAlso"]}, Open]], Cell[CellGroupData[{Cell["Related Guides", "MoreAboutSection"], Cell[TextData[{ButtonBox["MagneticTB", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/guide/MagneticTB"]}], "MoreAbout"]}, Open]], Cell[CellGroupData[{Cell["Related Tutorials", "TutorialsSection"], Cell[TextData[{}], "Tutorials"]}, Open]], Cell[CellGroupData[{Cell["History", "HistorySection"], Cell[TextData[{"New in: ", Cell["2.0.0", "HistoryData", CellTags -> "New"], " | Modified in: ", Cell[" ", "HistoryData", CellTags -> "Modified"], " | Obsolete in: ", Cell[" ", "HistoryData", CellTags -> "Obsolete"]}], "History"]}, Closed]], Cell[CellGroupData[{Cell["Categorization", "CategorizationSection"], Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], Cell["MagneticTB", "Categorization", CellLabel -> "Paclet Name"], Cell["MagneticTB`", "Categorization", CellLabel -> "Context"], Cell["MagneticTB/ref/hoppingData", "Categorization", CellLabel -> "URI"]}, Closed]], Cell[CellGroupData[{Cell["Keywords", "KeywordsSection"], Cell["real-space hopping", "Keywords"], Cell["shell cache", "Keywords"], Cell["Wannier90 convention", "Keywords"]}, Closed]]}, TaggingRules -> <|"Paclet" -> "MagneticTB"|>, WindowTitle -> "hoppingData", StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "FunctionPageStylesExt.nb", CharacterEncoding -> "UTF-8"]]