Notebook[{Cell[CellGroupData[{Cell["CyclotomicCommonKernel", "ObjectName"], Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["CyclotomicCommonKernel[compiled]"], "InlineFormula"], " \:2028", "finds the vectors annihilated by every exact constraint block in a compiled cyclotomic problem."}], "Usage"], Cell["compiled must be the complete Association returned by CompileCyclotomicMatrices. All blocks have the same coordinate dimension and exact field context.", "Notes"], Cell["The result stores the common basis by columns in \"basis_matrix\" and by rows in \"nullspace_rows\". iteration_nullities begins with the coordinate dimension and records the remaining nullity after each input block.", "Notes"], Cell["The method is the production iterative common-kernel algorithm. Every block is checked against the final exact basis. If any step or residual check fails, the function returns Failure; it never stacks all blocks as an automatic fallback and never uses floating point or SVD.", "Notes"]}, Open]], Cell[CellGroupData[{Cell["Examples Initialization", "ExamplesInitializationSection"], Cell[BoxData["Needs[\"MagneticTB`\"]"], "ExampleInitialization"]}, Open]], Cell[CellGroupData[{Cell["Basic Examples", "PrimaryExamplesSection"], Cell["The first constraint removes the first coordinate and the second removes the second. Their common kernel is therefore spanned by {0,0,1}:", "ExampleText"], Cell[BoxData["compiledCommon = CompileCyclotomicMatrices[<|\n  \"coordinate_dimension\" -> 3,\n  \"constraints\" -> {\n    {{1, 0, 0}},\n    {{0, 1, 0}}\n  }\n|>];\ncommonResult = CyclotomicCommonKernel[compiledCommon];\ncommonRows = RestoreCyclotomicExpression[\n  commonResult[\"nullspace_rows\"]\n];\ncommonBasis = RestoreCyclotomicExpression[\n  commonResult[\"basis_matrix\"]\n];\n{\n  MatrixForm@Partition[\n    commonRows[\"entries\"], commonRows[\"columns\"]\n  ],\n  MatrixForm@Partition[\n    commonBasis[\"entries\"], commonBasis[\"columns\"]\n  ],\n  KeyTake[\n    commonResult,\n    {\"iteration_nullities\", \"rank\", \"nullity\",\n      \"exact_residual_verified\"}\n  ]\n}"], "Input"], Cell[BoxData[RowBox[{"{", RowBox[{TagBox[RowBox[{"(", "\:2060", GridBox[{{"0", "0", "1"}}, RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> Center], "\:2060", ")"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]], ",", TagBox[RowBox[{"(", "\:2060", GridBox[{{"0"}, {"0"}, {"1"}}, RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> Center], "\:2060", ")"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]], ",", RowBox[{"\:f113", RowBox[{RowBox[{"\"iteration_nullities\"", "\:f522", RowBox[{"{", RowBox[{"3", ",", "2", ",", "1"}], "}"}]}], ",", RowBox[{"\"rank\"", "\:f522", "2"}], ",", RowBox[{"\"nullity\"", "\:f522", "1"}], ",", RowBox[{"\"exact_residual_verified\"", "\:f522", "True"}]}], "\:f114"}]}], "}"}]], "Output"]}, Open]], Cell[CellGroupData[{Cell["More Examples", "ExtendedExamplesSection", CellTags -> "ExtendedExamples"], Cell[CellGroupData[{Cell["Properties & Relations", "ExampleSection"], Cell["With no constraint blocks, every coordinate is free. The row basis is the identity and iteration_nullities contains only the initial dimension:", "ExampleText"], Cell[BoxData["emptyCompiled = CompileCyclotomicMatrices[<|\n  \"coordinate_dimension\" -> 3,\n  \"constraints\" -> {}\n|>];\nemptyResult = CyclotomicCommonKernel[emptyCompiled];\nemptyRows = RestoreCyclotomicExpression[\n  emptyResult[\"nullspace_rows\"]\n];\n{\n  MatrixForm@Partition[\n    emptyRows[\"entries\"], emptyRows[\"columns\"]\n  ],\n  KeyTake[emptyResult, {\"iteration_nullities\", \"rank\", \"nullity\"}]\n}"], "Input"], Cell[BoxData[RowBox[{"{", RowBox[{TagBox[RowBox[{"(", "\:2060", GridBox[{{"1", "0", "0"}, {"0", "1", "0"}, {"0", "0", "1"}}, RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> Center], "\:2060", ")"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]], ",", RowBox[{"\:f113", RowBox[{RowBox[{"\"iteration_nullities\"", "\:f522", RowBox[{"{", "3", "}"}]}], ",", RowBox[{"\"rank\"", "\:f522", "0"}], ",", RowBox[{"\"nullity\"", "\:f522", "3"}]}], "\:f114"}]}], "}"}]], "Output"], Cell["A problem with coordinate dimension zero has rank and nullity zero and retains a 0 by 0 basis matrix:", "ExampleText"], Cell[BoxData["zeroCompiled = CompileCyclotomicMatrices[<|\n  \"coordinate_dimension\" -> 0,\n  \"constraints\" -> {}\n|>];\nzeroResult = CyclotomicCommonKernel[zeroCompiled];\n{\n  KeyTake[zeroResult, {\"iteration_nullities\", \"rank\", \"nullity\"}],\n  KeyTake[\n    RestoreCyclotomicExpression[zeroResult[\"basis_matrix\"]],\n    {\"rows\", \"columns\", \"entries\"}\n  ]\n}"], "Input"], Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"\:f113", RowBox[{RowBox[{"\"iteration_nullities\"", "\:f522", RowBox[{"{", "0", "}"}]}], ",", RowBox[{"\"rank\"", "\:f522", "0"}], ",", RowBox[{"\"nullity\"", "\:f522", "0"}]}], "\:f114"}], ",", RowBox[{"\:f113", RowBox[{RowBox[{"\"rows\"", "\:f522", "0"}], ",", RowBox[{"\"columns\"", "\:f522", "0"}], ",", RowBox[{"\"entries\"", "\:f522", RowBox[{"{", "}"}]}]}], "\:f114"}]}], "}"}]], "Output"]}, Open]], Cell[CellGroupData[{Cell["Possible Issues", "ExampleSection"], Cell["The function accepts only a complete compiled problem. It does not infer missing context or dimensions from an arbitrary Association:", "ExampleText"], Cell[BoxData["commonFailure = CyclotomicCommonKernel[<||>];\n<|\"FailureTag\" -> commonFailure[[1]]|>"], "Input"], Cell[BoxData[RowBox[{"\:f113", RowBox[{"\"FailureTag\"", "\:f522", "\"MalformedSerialization\""}], "\:f114"}]], "Output"]}, Open]]}, Open]], Cell[CellGroupData[{Cell["Related Functions", "SeeAlsoSection"], Cell[TextData[{ButtonBox["CompileCyclotomicMatrices", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/CompileCyclotomicMatrices"], " \:25aa ", ButtonBox["CyclotomicNullSpace", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/CyclotomicNullSpace"], " \:25aa ", ButtonBox["Cyclotom