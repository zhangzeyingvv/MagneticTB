Notebook[{Cell[CellGroupData[{Cell["bandManipulate", "ObjectName"], 
     Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["bandManipulate[path, npoint, H]"], "InlineFormula"], " \:2028", 
        "draws the bands of H along path and provides sliders for the tight-binding parameters."}], "Usage"], 
     Cell["path is a list of reciprocal-fractional line segments and endpoint labels. npoint controls the sampling of \
each segment.", "Notes"], Cell["Every symbol in H other than kx, ky, and kz becomes an interactive parameter. The \
sliders start at zero, so the initial plot may show coincident flat bands when all Hamiltonian parameters vanish.", 
      "Notes"], Cell["Use standardKPath[] as the first argument when MagneticTB should choose the built-in conventional \
path from the current initialized lattice. bandManipulate receives the explicit path returned by standardKPath[].", 
      "Notes"], Cell["No energy shift is added. For a genuinely non-Hermitian Hamiltonian, choose explicitly whether to \
plot the real part, imaginary part, or complex spectrum before calling this function.", "Notes"]}, Open]], 
  Cell[CellGroupData[{Cell["Examples Initialization", "ExamplesInitializationSection"], 
     Cell[BoxData["Needs[\"MagneticTB`\"]"], "ExampleInitialization"]}, Open]], 
  Cell[CellGroupData[{Cell["Basic Examples", "PrimaryExamplesSection"], 
     Cell["Initialize graphene and construct the Hamiltonian before plotting:", "ExampleText"], 
     Cell[BoxData["Needs[\"MagneticTB`\"];\ngrapheneOperations = msgop[gray[191]];\ninit[\n  lattice -> {\n    {a, 0, \
0},\n    {-a/2, Sqrt[3] a/2, 0},\n    {0, 0, c}\n  },\n  lattpar -> {a -> 1, c -> 3},\n  wyckoffposition -> {\n    \
{{1/3, 2/3, 0}, {0, 0, 0}}\n  },\n  symminformation -> grapheneOperations,\n  basisFunctions -> \
{{\"pz\"}}\n];\ngrapheneOnsite = symham[1];\ngrapheneNearest = symham[2];\ngrapheneNextNearest = \
symham[3];\ngrapheneHamiltonian =\n  grapheneOnsite + grapheneNearest + grapheneNextNearest;\nMatrixForm[\n  \
FullSimplify[\n    ExpToTrig[grapheneHamiltonian],\n    Element[{kx, ky, kz}, Reals]\n  ]\n]"], "Input"], 
     Cell[BoxData[TagBox[RowBox[{"(", "\:2060", GridBox[{{RowBox[{"e1", "+", RowBox[{"2", " ", "r1", " ", 
                 RowBox[{"(", RowBox[{RowBox[{"Cos", "[", "kx", "]"}], "+", RowBox[{"Cos", "[", "ky", "]"}], "+", 
                     RowBox[{"Cos", "[", RowBox[{"kx", "+", "ky"}], "]"}]}], ")"}]}]}], 
             RowBox[{SuperscriptBox["\:f74d", RowBox[{RowBox[{"-", FractionBox["1", "3"]}], " ", "\:f74e", " ", 
                  RowBox[{"(", RowBox[{RowBox[{"2", " ", "kx"}], "+", "ky"}], ")"}]}]], " ", RowBox[
                {"(", RowBox[{"1", "+", SuperscriptBox["\:f74d", RowBox[{"\:f74e", " ", "kx"}]], "+", SuperscriptBox["\:f74d", 
                    RowBox[{"\:f74e", " ", RowBox[{"(", RowBox[{"kx", "+", "ky"}], ")"}]}]]}], ")"}], " ", "t1"}]}, 
            {RowBox[{SuperscriptBox["\:f74d", RowBox[{RowBox[{"-", FractionBox["1", "3"]}], " ", "\:f74e", " ", 
                  RowBox[{"(", RowBox[{"kx", "+", RowBox[{"2", " ", "ky"}]}], ")"}]}]], " ", RowBox[
                {"(", RowBox[{"1", "+", SuperscriptBox["\:f74d", RowBox[{"\:f74e", " ", "ky"}]], "+", SuperscriptBox["\:f74d", 
                    RowBox[{"\:f74e", " ", RowBox[{"(", RowBox[{"kx", "+", "ky"}], ")"}]}]]}], ")"}], " ", "t1"}], 
             RowBox[{"e1", "+", RowBox[{"2", " ", "r1", " ", RowBox[{"(", RowBox[{RowBox[{"Cos", "[", "kx", "]"}], "+", 
                     RowBox[{"Cos", "[", "ky", "]"}], "+", RowBox[{"Cos", "[", RowBox[{"kx", "+", "ky"}], "]"}]}], 
                   ")"}]}]}]}}, RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline, 
           ColumnAlignments -> Center], "\:2060", ")"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]], "Output"], 
     Cell["Define the G-M-K-G path in reciprocal fractional coordinates:", "ExampleText"], 
     Cell[BoxData["graphenePath = {\n  {{{0, 0, 0}, {0, 1/2, 0}}, {\"G\", \"M\"}},\n  {{{0, 1/2, 0}, {1/3, 1/3, 0}}, \
{\"M\", \"K\"}},\n  {{{1/3, 1/3, 0}, {0, 0, 0}}, {\"K\", \"G\"}}\n};"], "Input"], 
     Cell["Open the live interactive panel along the explicit G-M-K-G path. Its three sliders are the onsite, \
nearest-neighbour, and next-nearest-neighbour amplitudes; no hidden energy shift is added:", "ExampleText"], 
     Cell[BoxData["bandManipulate[graphenePath, 30, grapheneHamiltonian]"], "Input"], 
     Cell["Display the conventional path selected automatically from the initialized graphene lattice:", 
      "ExampleText"], Cell[BoxData["grapheneAutomaticPath = standardKPath[]"], "Input"], 
     Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", "0", 
                       ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{FractionBox["1", "2"], ",", "0", ",", "0"}], 
                     "}"}]}], "}"}], ",", RowBox[{"{", RowBox[{"\"\:0393\"", ",", "\"M\""}], "}"}]}], "}"}], ",", 
           RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{FractionBox["1", "2"], ",", "0", ",", "0"}], 
                     "}"}], ",", RowBox[{"{", RowBox[{FractionBox["1", "3"], ",", FractionBox["1", "3"], ",", "0"}], 
                     "}"}]}], "}"}], ",", RowBox[{"{", RowBox[{"\"M\"", ",", "\"K\""}], "}"}]}], "}"}], ",", 
           RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{FractionBox["1", "3"], ",", FractionBox["1", 
                        "3"], ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}], 
               ",", RowBox[{"{", RowBox[{"\"K\"", ",", "\"\:0393\""}], "}"}]}], "}"}], ",", 
           RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
                   RowBox[{"{", RowBox[{"0", ",", "0", ",", FractionBox["1", "2"]}], "}"}]}], "}"}], ",", RowBox[
                {"{", RowBox[{"\"\:0393\"", ",", "\"A\""}], "}"}]}], "}"}], ",", 
           RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", "0", ",", FractionBox["1", "2"]}], 
                     "}"}], ",", RowBox[{"{", RowBox[{FractionBox["1", "2"], ",", "0", ",", FractionBox["1", "2"]}], 
                     "}"}]}], "}"}], ",", RowBox[{"{", RowBox[{"\"A\"", ",", "\"L\""}], "}"}]}], "}"}], ",", 
           RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{FractionBox["1", "2"], ",", "0", ",", 
                       FractionBox["1", "2"]}], "}"}], ",", RowBox[{"{", RowBox[{FractionBox["1", "3"], ",", 
                       FractionBox["1", "3"], ",", FractionBox["1", "2"]}], "}"}]}], "}"}], ",", RowBox[
                {"{", RowBox[{"\"L\"", ",", "\"H\""}], "}"}]}], "}"}], ",", 
           RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{FractionBox["1", "3"], ",", FractionBox["1", 
                        "3"], ",", FractionBox["1", "2"]}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "0", ",", 
                       FractionBox["1", "2"]}], "}"}]}], "}"}], ",", RowBox[{"{", RowBox[{"\"H\"", ",", "\"A\""}], 
                 "}"}]}], "}"}], ",", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[
                      {FractionBox["1", "2"], ",", "0", ",", FractionBox["1", "2"]}], "}"}], ",", 
                   RowBox[{"{", RowBox[{FractionBox["1", "2"], ",", "0", ",", "0"}], "}"}]}], "}"}], ",", RowBox[
                {"{", RowBox[{"\"L\"", ",", "\"M\""}], "}"}]}], "}"}], ",", 
           RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{FractionBox["1", "3"], ",", FractionBox["1", 
                        "3"], ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{FractionBox["1", "3"], ",", FractionBox["1", 
                        "3"], ",", FractionBox["1", "2"]}], "}"}]}], "}"}], ",", RowBox[
                {"{", RowBox[{"\"K\"", ",", "\"H\""}], "}"}]}], "}"}]}], "}"}]], "Output"], 
     Cell["Use the automatically selected path to open the live Manipulate panel:", "ExampleText"], 
