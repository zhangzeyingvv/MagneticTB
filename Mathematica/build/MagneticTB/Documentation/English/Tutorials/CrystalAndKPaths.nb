Cell["\<\
The first Brillouin zone is a hexagonal prism, and the colored path is in its \
central plane. In this plot the fractional k points have been converted to \
Cartesian reciprocal coordinates using reciprocal vectors that include 2 Pi.\
\>", "TechNoteText",ExpressionUUID->"81f2320b-6fdd-49a6-8275-d4cf7ee40476"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Hamiltonian and bands", "TechNoteSection",ExpressionUUID->"6fa2d451-feea-43ec-a333-218d3c4d945c"],

Cell["\<\
Add symham[1] and symham[2] to keep onsite and nearest-neighbor terms. \
ComplexExpand and Simplify rewrite the paired exponentials as cosines for \
real k. The three rows and columns follow the site order given above:\
\>", "TechNoteText",ExpressionUUID->"e883beab-10ee-4937-b850-db3c05d35e12"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"kagomeHamiltonian", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"ComplexExpand", "[", 
     RowBox[{
      RowBox[{"symham", "[", "1", "]"}], " ", "+", " ", 
      RowBox[{"symham", "[", "2", "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"kagomeHamiltonian", " ", "//", " ", "MatrixForm"}]}], "Input",Expres\
sionUUID->"391c9f54-d5f5-4026-a91c-6afcbc58b2b2"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"e1", 
      RowBox[{"2", " ", "t1", " ", 
       RowBox[{"Cos", "[", 
        FractionBox[
         RowBox[{"kx", "+", "ky"}], "2"], "]"}]}], 
      RowBox[{"2", " ", "t1", " ", 
       RowBox[{"Cos", "[", 
        FractionBox["ky", "2"], "]"}]}]},
     {
      RowBox[{"2", " ", "t1", " ", 
       RowBox[{"Cos", "[", 
        FractionBox[
         RowBox[{"kx", "+", "ky"}], "2"], "]"}]}], "e1", 
      RowBox[{
       RowBox[{"-", "2"}], " ", "t1", " ", 
       RowBox[{"Cos", "[", 
        FractionBox["kx", "2"], "]"}]}]},
     {
      RowBox[{"2", " ", "t1", " ", 
       RowBox[{"Cos", "[", 
        FractionBox["ky", "2"], "]"}]}], 
      RowBox[{
       RowBox[{"-", "2"}], " ", "t1", " ", 
       RowBox[{"Cos", "[", 
        FractionBox["kx", "2"], "]"}]}], "e1"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",ExpressionUUID->"eadfefb9-6692-42e7-\
a747-20b9994a853e"]
}, Open  ]],

Cell["\<\
The common onsite energy is e1, and t1 is the nearest-neighbor hopping \
parameter. The relative minus sign in the (2,3) entry comes from the induced \
spinor basis used here. These terms contain no interlayer hopping, so the \
bands are independent of kz. This is an ideal kagome model, not a fit to a \
particular material.\
\>", "TechNoteText",ExpressionUUID->"d0f4a442-5caa-4083-a340-1a12ac5f76eb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"bandplot", "[", "\n", "  ", 
  RowBox[{
  "planePath", ",", " ", "60", ",", " ", "kagomeHamiltonian", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"e1", " ", "->", " ", "0"}], ",", " ", 
     RowBox[{"t1", " ", "->", " ", 
      RowBox[{"-", "1"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"ImageSize", " ", "->", " ", "400"}], ",", " ", 
   RowBox[{"FontSize", " ", "->", " ", "16"}]}], "\n", "]"}]], "Input",Express\
ionUUID->"998fe13c-2a5f-4e2e-8207-ae1176fe7ec8"],

