Cell[CellGroupData[{

Cell["Conventional path and first Brillouin zone", "TechNoteSection",ExpressionUUID->"2135e4e2-d86c-4dc7-b0d5-52f706cd1098"],

Cell["\<\
Use standardKPath to obtain the conventional path for this hexagonal lattice. \
The returned points are in reciprocal fractional coordinates. The function \
chooses a built-in path from the lattice metric; it does not calculate \
little-group irreducible representations.\
\>", "TechNoteText",ExpressionUUID->"88fbd0f1-45cf-4617-b779-7270d2eb62d8"],

