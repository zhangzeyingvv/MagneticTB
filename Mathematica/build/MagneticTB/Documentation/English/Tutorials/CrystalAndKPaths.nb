Cell[CellGroupData[{

Cell["Crystal structure, Brillouin zone, and k paths", "TechNoteTitle",ExpressionUUID->"b55ea49d-80ae-4c15-8a70-4f75d97665dd"],

Cell[TextData[ButtonBox["MagneticTB help home",
 BaseStyle->"Link",
 ButtonData->"paclet:MagneticTB/guide/MagneticTB"]], "TechNoteText",Expression\
UUID->"437b5cd4-aee3-444f-bbf7-142f59bb2344"],

Cell["\<\
Use a kagome antiferromagnet to draw the crystal structure, its magnetic \
moments, and the first Brillouin zone. The three in-plane moments are 120 \
degrees apart. After setting up this model, we obtain a k path and use it to \
plot the three bands.\
\>", "TechNoteText",ExpressionUUID->"daaa6acb-270c-4a55-99de-cf8e0d32b6b3"],

Cell[CellGroupData[{

Cell["Initialize the model", "TechNoteSection",ExpressionUUID->"da0095cb-88ef-411f-96ce-454450ddf032"],

Cell["\<\
Choose magnetic space group 191.239, P6'/m'mm', with a = 1 and c = 4. One \
representative atom generates {1/2,0,0}, {0,1/2,0}, and {1/2,1/2,0}, in this \
order. Their moments in the lattice-vector basis are {1,0,0}, {0,1,0}, and \
{-1,-1,0}. In Cartesian coordinates, these are unit vectors 120 degrees apart \
and their sum is zero.\
\>", "TechNoteText",ExpressionUUID->"0f17f902-b3b4-43f4-b4b3-6984477798df"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<MagneticTB`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "0", ",", " ", "0"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"a", "/", "2"}]}], ",", " ", "0"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "c"}], "}"}]}], "\n", "  ", 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"c", " ", "->", " ", "4"}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "2"}], ",", " ", "0", ",", " ", "0"}], "}"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "}"}]}],
     ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", 
     RowBox[{"msgop", "[", 
      RowBox[{"typeIII", "[", 
       RowBox[{"{", 
        RowBox[{"191", ",", " ", "239"}], "}"}], "]"}], "]"}]}], ",", "\n", 
    "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], "/", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], "}"}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"RepresentationMode", " ", "->", " ", "\"\<Induced\>\""}]}], "\n",
    "]"}], ";"}]}], "Input",ExpressionUUID->"11581c29-9a96-40cd-853d-\
6e74a4e1bad9"],

Cell["\<\
Here {1,-1}/Sqrt[2] is one spinor at the representative site, not two \
independent basis states. Induced generates its counterparts at the other two \
sites. There is one state per site, giving a three-band Hamiltonian; keeping \
both spin states on every site would instead give six basis states.\
\>", "TechNoteText",ExpressionUUID->"481b8318-d7a1-48d7-bb7a-59d14e974187"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Crystal structure", "TechNoteSection",ExpressionUUID->"e94a4dfd-a9b0-4f1c-89bc-95424970a031"],

Cell["\<\
Draw 2 by 2 primitive cells. The picture contains twelve atoms and twelve red \
magnetic-moment arrows. MomentScale changes the arrow length. The gray lines \
mark cell edges, not hopping bonds. The default view uses an orthographic \
projection.\
\>", "TechNoteText",ExpressionUUID->"9e6361a1-ddbe-4312-a919-cc292644430d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"showCrystalStructure", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"\"\<CellRange\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<MomentScale\>\"", " ", "->", " ", "0.3"}], ",", "\n", "  ", 
   RowBox[{"ImageSize", " ", "->", " ", "400"}]}], "\n", "]"}]], "Input",Expre\
ssionUUID->"cea8fb77-6cee-4386-bbce-7b9ca61e62b7"],

