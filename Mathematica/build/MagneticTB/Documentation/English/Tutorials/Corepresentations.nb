Cell["\<\
Specify Gamma, K, and A in reciprocal fractional coordinates and call \
getTBBandCorep. The function prints the k-point names and result tables. It \
returns Null, so no additional Out cell is expected:\
\>", "TechNoteText",ExpressionUUID->"858562ed-88be-425b-a6f8-65c0419be4ff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"getTBBandCorep", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"164", ",", " ", "87"}], "}"}], ",", " ", "corepHamiltonian", ",",
    " ", 
   RowBox[{"{", 
    RowBox[{"e1", " ", "->", " ", "0"}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", "3"}], ",", " ", 
       RowBox[{"1", "/", "3"}], ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}]}], "\n", "]"}]], "Input",Expr\
essionUUID->"120a16f7-639b-4218-b2a7-ad006254de70"],

