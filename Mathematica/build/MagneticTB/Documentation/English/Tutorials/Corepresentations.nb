Cell[CellGroupData[{

Cell["Band corepresentations with MSGCorep", "TechNoteTitle",ExpressionUUID->"80565a3d-8c9a-40a7-b3c4-ae29dcaa736c"],

Cell[TextData[ButtonBox["MagneticTB help home",
 BaseStyle->"Link",
 ButtonData->"paclet:MagneticTB/guide/MagneticTB"]], "TechNoteText",Expression\
UUID->"acd16cbf-6902-41b0-9349-5e27774bda37"],

Cell["\<\
To identify the symmetry of a band at a high-symmetry k point, use its small \
corepresentation. For magnetic space group 164.87, the examples below compare \
spinor and scalar s bases at Gamma, K, and A.\
\>", "TechNoteText",ExpressionUUID->"141d6163-d517-461d-97bd-61e7991a9bfe"],

Cell["\<\
This calculation uses the external MSGCorep package and its SpaceGroupIrep \
dependency. Install both first, then load MSGCorep and MagneticTB in a fresh \
kernel as shown below. MSGCorep must be loaded by the user:\
\>", "TechNoteText",ExpressionUUID->"72e3339a-e5fc-410a-ac17-fafc11a26fa2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<MSGCorep`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<MagneticTB`\>\"", "]"}], ";"}]}], "Input",Express\
ionUUID->"7857c6e7-23be-4804-a475-318aa45db757"],

Cell[CellGroupData[{

Cell["Use one ordered MSGCorep operation list", "TechNoteSection",ExpressionUUID->"859797ca-bdff-4eb4-b248-38c9b8b0d44b"],

Cell["\<\
Use getMSGElemFromMSGCorep to obtain the symmetry operations, and pass them \
to init without changing their order. The printed primitive vectors give the \
lattice for this example. The corepresentation calculation requires this \
operation list; do not replace it with a list from msgop.\
\>", "TechNoteText",ExpressionUUID->"61fb71cb-ceb6-4609-8983-6e548ae309a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"corepOperations", " ", "=", " ", 
   RowBox[{"getMSGElemFromMSGCorep", "[", 
    RowBox[{"{", 
     RowBox[{"164", ",", " ", "87"}], "}"}], "]"}]}], ";"}]], "Input",Expressi\
onUUID->"45883633-3de0-4566-b750-436e5d9b59de"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Primitive Lattice Vector: \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", "a"}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       FractionBox[
        RowBox[{
         SqrtBox["3"], " ", "a"}], "2"], ",", 
       FractionBox["a", "2"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "c"}], "}"}]}], "}"}]}],
  "Primitive Lattice Vector: " {{
    0, -$CellContext`a, 0}, {(Sqrt[3] $CellContext`a)/2, $CellContext`a/2, 
     0}, {0, 0, $CellContext`c}},
  Editable->False]], "Print",ExpressionUUID->"bd4a6cd8-5354-46c4-ac3b-\
ae661330d5d7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Double-valued high-symmetry calculation", "TechNoteSection",ExpressionUUID->"5fd128e6-3e0b-4130-bff0-5a28a46c7f08"],

Cell["\<\
Place {sup,sdn} at the origin to calculate double-valued corepresentations. \
Here we keep only the onsite term, with the same energy e1 for both states, \
to show how the result depends on the chosen basis.\
\>", "TechNoteText",ExpressionUUID->"e25cec6a-dd9d-4b7a-8b78-09830a6091f9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"-", "a"}], ",", " ", "0"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"a", "/", "2"}]}], ",", " ", 
         RowBox[{"a", "/", "2"}], ",", " ", "0"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "c"}], "}"}]}], "\n", "  ", 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"c", " ", "->", " ", "2"}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "}"}]}],
     ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", "corepOperations"}], ",", "\n",
     "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"\"\<sup\>\"", ",", " ", "\"\<sdn\>\""}], "}"}], "}"}]}]}], 
   "\n", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"corepHamiltonian", " ", "=", " ", 
   RowBox[{"symham", "[", "1", "]"}]}], ";"}], "\n", 
 RowBox[{"corepHamiltonian", " ", "//", " ", "MatrixForm"}]}], "Input",Express\
ionUUID->"d3092064-9898-4d44-bad1-9881708afcd4"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Generators:\"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\<\"I\"\>", ",", "\<\"T\"\>"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\<\"C3+\"\>", ",", "\<\"F\"\>"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\<\"C21pp\"\>", ",", "\<\"T\"\>"}], "}"}]}], "}"}]}],
  "Generators:" {{"I", "T"}, {"C3+", "F"}, {"C21pp", "T"}},
  Editable->False]], "Print",ExpressionUUID->"c9886022-415b-46da-a10e-\
a4e5a0d8612a"],

