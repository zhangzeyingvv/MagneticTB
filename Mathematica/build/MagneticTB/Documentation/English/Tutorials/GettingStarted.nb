Cell[CellGroupData[{

Cell["A spinful antiunitary model", "TechNoteSection",ExpressionUUID->"b0879760-82bc-4176-8e7a-b085e5dd8125"],

Cell["\<\
A spin-space group allows the spin rotation to be specified separately from \
the spatial operation. The following example has a pure spin C4 rotation and \
a half translation combined with time reversal. In each dictionary entry, \
spin -> {S,0} denotes a unitary operation and spin -> {S,1} an antiunitary \
one; S is the spin-rotation matrix.\
\>", "TechNoteText",ExpressionUUID->"431819e7-6bdc-4bb9-ab58-609b442a8239"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"identity3", " ", "=", " ", 
   RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"c4z", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{"-", "1"}], ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"collinearSSG", " ", "=", " ", 
   RowBox[{"<|", "\n", "  ", 
    RowBox[{
     RowBox[{"\"\<C4spin\>\"", " ", "->", " ", 
      RowBox[{"<|", "\n", "    ", 
       RowBox[{
        RowBox[{"\"\<space\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"identity3", ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}]}], ",",
         "\n", "    ", 
        RowBox[{"\"\<spin\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"c4z", ",", " ", "0"}], "}"}]}]}], "\n", "  ", "|>"}]}], ",",
      "\n", "  ", 
     RowBox[{"\"\<tauHalfT\>\"", " ", "->", " ", 
      RowBox[{"<|", "\n", "    ", 
       RowBox[{
        RowBox[{"\"\<space\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"identity3", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"1", "/", "2"}], ",", " ", "0", ",", " ", "0"}], "}"}]}],
           "}"}]}], ",", "\n", "    ", 
        RowBox[{"\"\<spin\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"identity3", ",", " ", "1"}], "}"}]}]}], "\n", "  ", 
       "|>"}]}]}], "\n", "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "a", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "a"}], "}"}]}], "}"}]}], ",", 
    "\n", "  ", 
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"a", " ", "->", " ", "1"}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], "}"}], "}"}]}],
     ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", "collinearSSG"}], ",", "\n", 
    "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"\"\<sup\>\"", ",", " ", "\"\<sdn\>\""}], "}"}], "}"}]}], ",", 
    "\n", "  ", 
    RowBox[{"GenerateSymmetryGroup", " ", "->", " ", "True"}]}], "\n", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"collinearHamiltonian", " ", "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"symham", "[", "i", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"validationBandPath", " ", "=", " ", 
   RowBox[{"{", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "2"}], ",", " ", "0", ",", " ", "0"}], "}"}]}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<G\>\"", ",", " ", "\"\<X\>\""}], "}"}]}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "2"}], ",", " ", "0", ",", " ", "0"}], "}"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "2"}], ",", " ", 
           RowBox[{"1", "/", "2"}], ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<X\>\"", ",", " ", "\"\<M\>\""}], "}"}]}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "2"}], ",", " ", 
           RowBox[{"1", "/", "2"}], ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<M\>\"", ",", " ", "\"\<G\>\""}], "}"}]}], "}"}]}], "\n", 
    "}"}]}], ";"}]}], "Input",ExpressionUUID->"4e64fda8-dbb2-4275-a721-\
ebe830c55293"],

