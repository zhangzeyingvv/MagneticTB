 RowBox[{"showCrystalStructure", "[", "]"}]], "Input",ExpressionUUID->"0551d3b8-211c-494e-ab34-e93810de5ad3"],

Cell[BoxData[
 Graphics3DBox[{
   {GrayLevel[0.35], Thickness[
    Tiny], {Line3DBox[{{0., 0., 0.}, {0., 0., 1.}}], 
     Line3DBox[{{0., 0., 0.}, {0., 1., 0.}}], 
