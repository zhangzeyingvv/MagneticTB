Cell[CellGroupData[{

Cell["Getting Started with MagneticTB", "TechNoteTitle",ExpressionUUID->"7699302f-dfbd-4ad2-b8bd-430389c7d02f"],

Cell["\<\
To construct a tight-binding model, first specify the lattice, atomic \
positions, symmetry operations, and local orbitals. With these inputs, \
MagneticTB finds the equivalent atoms and the symmetry-allowed hopping terms. \
We use graphene to show how to obtain the Hamiltonian and plot its bands.\
\>", "TechNoteText",ExpressionUUID->"fd188e5c-ac9a-44bc-9039-41eccf251d11"],

Cell[CellGroupData[{

Cell["Install, update, uninstall, and load", "TechNoteSection",ExpressionUUID->"8b7d1f75-0fad-45c9-af05-a595fc07bbbf"],

Cell["\<\
Obtain a local MagneticTB .paclet file, either supplied to you or built from \
the source. The installation commands below use this file; they do not \
download a release from the Internet.\
\>", "TechNoteText",ExpressionUUID->"399ba301-ced0-4442-a88a-27b5bfeb370a"],

Cell[CellGroupData[{

Cell["Install", "Subsection",ExpressionUUID->"434db7c4-9f92-462f-b536-a7399a3c8e4a"],

Cell[TextData[ButtonBox["MagneticTB help home",
 BaseStyle->"Link",
 ButtonData->"paclet:MagneticTB/guide/MagneticTB"]], "TechNoteText",Expression\
UUID->"3a73eb53-a116-4fb2-a13b-622340c190e5"],

Cell["\<\
Install the .paclet file with the following command. Replace the path and \
filename with those of your file:\
\>", "TechNoteText",ExpressionUUID->"8d0ff951-c85d-4d34-bc55-4fcf23af5024"],

Cell[BoxData[
 RowBox[{"PacletInstall", 
  "[", "\"\</absolute/path/MagneticTB-2.x.y.paclet\>\"", "]"}]], "Input",Expre\
ssionUUID->"f8e20c52-8927-42b7-8659-d96dbf2521bf"],

Cell["\<\
After installation, quit Mathematica completely and open it again before \
loading MagneticTB or opening its help. This also removes any definitions \
left by the previously loaded version.\
\>", "TechNoteText",ExpressionUUID->"ed8b4fcc-2b5c-4958-a7ad-f11aabae3e70"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Update", "Subsection",ExpressionUUID->"b0c75d14-9664-4e64-bf63-f020371796b0"],

Cell[TextData[ButtonBox["MagneticTB help home",
 BaseStyle->"Link",
 ButtonData->"paclet:MagneticTB/guide/MagneticTB"]], "TechNoteText",Expression\
UUID->"4f287a24-a1b5-4218-8e3e-0a6d32edb92a"],

Cell["\<\
To update, install the newer .paclet file in the same way, then quit and \
reopen Mathematica. If PacletInstall reports samevers, that version is \
already installed. To replace it with another file of the same version, \
uninstall that version first and then install the new file.\
\>", "TechNoteText",ExpressionUUID->"79941d59-6a68-457a-b0dd-fd1abf55ac0b"],

Cell[BoxData[
 RowBox[{"PacletInstall", 
  "[", "\"\</absolute/path/MagneticTB-2.x.y.paclet\>\"", "]"}]], "Input",Expre\
ssionUUID->"b5f7f337-5d95-4d2a-9b1c-855318386fc6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Uninstall or reinstall the same version", "Subsection",ExpressionUUID->"ccc840ed-7afe-4f60-a0e4-538130afc0db"],

Cell[TextData[ButtonBox["MagneticTB help home",
 BaseStyle->"Link",
 ButtonData->"paclet:MagneticTB/guide/MagneticTB"]], "TechNoteText",Expression\
UUID->"f3454fb6-8482-4165-9e35-303fd9bf4ab4"],

Cell["\<\
To uninstall MagneticTB, run the following command, then quit and reopen \
Mathematica:\
\>", "TechNoteText",ExpressionUUID->"eed74fb6-ce06-48a3-9f1c-78898e4ae344"],

Cell[BoxData[
 RowBox[{"PacletUninstall", "[", "\"\<MagneticTB\>\"", "]"}]], "Input",Express\
ionUUID->"38aae528-d129-4483-9adc-c3540b6e93da"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Load and open the documentation", "Subsection",ExpressionUUID->"b1cc31fb-5d0d-449e-ad0b-db0d01c5eabc"],

Cell[TextData[ButtonBox["MagneticTB help home",
 BaseStyle->"Link",
 ButtonData->"paclet:MagneticTB/guide/MagneticTB"]], "TechNoteText",Expression\
UUID->"407feac6-76d5-4640-942e-f5fdf79c3b00"],

Cell["\<\
After reopening Mathematica, load the package with Needs. To open the help, \
search for MagneticTB in the Documentation Center, or run the command below \
to open its home page. The functions from version 1.0 are loaded with \
MagneticTBOld`; use a separate kernel for that version.\
\>", "TechNoteText",ExpressionUUID->"f57ac945-2ca0-4dd9-af94-b38271a20fba"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<MagneticTB`\>\"", "]"}]], "Input",ExpressionUUID->"c6c1f6b9-0126-4351-8ee3-6aa04340345d"],

Cell[BoxData[
 RowBox[{"SystemOpen", "[", "\"\<paclet:MagneticTB/guide/MagneticTB\>\"", 
  "]"}]], "Input",ExpressionUUID->"952c97c7-3903-4a62-b483-5f6c96abf203"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["The five physical inputs", "TechNoteSection",ExpressionUUID->"86a94c58-84fc-475d-9dac-0665abfd7a91"],

Cell["\<\
init sets up the crystal and its local orbitals. Here lattice gives the three \
lattice vectors as rows, and lattpar supplies their parameter values. \
wyckoffposition gives one representative position and its magnetic moment for \
each inequivalent Wyckoff orbit. symminformation gives the symmetry \
operations, and basisFunctions lists the orbitals in the same order as the \
positions.\
\>", "TechNoteText",ExpressionUUID->"a98f5c88-2eee-4823-adf3-7d1d9d46d35c"],

Cell["\<\
The two carbon atoms in graphene are symmetry equivalent. Enter only \
{1/3,2/3,0}; the other atom at {2/3,1/3,0} is generated by symmetry. Keep one \
pz orbital on each carbon. The lattice parameter c separates the periodically \
repeated graphene layers.\
\>", "TechNoteText",ExpressionUUID->"6f67c64d-6452-4a18-bd40-850647254c60"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "e4462d09-d0e1-4384-8709-464baa0f546d"], "lattice", Cell[
    "length", "TechNoteTableText",ExpressionUUID->
     "40ffcabb-587e-4396-b5d1-9c2bc0feb538"], Cell["\<\
Three primitive vectors stored as rows. Coordinates in wyckoffposition are \
fractional coordinates in this basis.\
\>", "TechNoteTableText",ExpressionUUID->
     "ceed5c2d-14b6-4ab0-b4d0-692463c80af3"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "28884332-4256-459f-895e-3a7b5b0e0609"], "lattpar", Cell[
    "length", "TechNoteTableText",ExpressionUUID->
     "aaa0573a-5c70-476c-8dc2-d83182250d33"], Cell["\<\
Numerical assignments for every symbolic lattice constant. MagneticTB does \
not impose an angstrom unit; all lengths must use one consistent unit.\
\>", "TechNoteTableText",ExpressionUUID->
     "9c2ee07a-3516-43b0-ac6b-88f963c4eb3b"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "a6c257be-0605-41b6-a56e-16389c80b7b3"], "wyckoffposition", Cell[
    "fractional position and magnetic moment", "TechNoteTableText",
     ExpressionUUID->"e4c03ed2-d570-429b-bb91-9ad3b4271809"], Cell["\<\
The outer list enumerates inequivalent Wyckoff orbits. Each entry is {seed \
position, magnetic moment}; the same outer order is used by basisFunctions.\
\>", "TechNoteTableText",ExpressionUUID->
     "be9052e2-23a0-45c0-866b-043b4311ece5"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "fb3b309c-52a3-421b-a5ec-6ed2d9549951"], "symminformation", Cell[
    "symmetry operations", "TechNoteTableText",ExpressionUUID->
     "be994eda-660e-4bfe-8b81-3e9e02dc7713"], Cell["\<\
Each magnetic-group record is {label,R,t,\"F\"|\"T\"}. The last field records \
whether the operation is unitary or antiunitary.\
\>", "TechNoteTableText",ExpressionUUID->
     "cf4f38d3-0276-43b4-a7ac-797350f5ff84"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "1a2d090e-ac94-4504-b994-a65788d5d939"], "basisFunctions", Cell[
    "local orbital basis", "TechNoteTableText",ExpressionUUID->
     "f5471ea9-3581-40b4-8185-b8af526556fc"], Cell["\<\
One nonempty local basis list per Wyckoff orbit. Different entries may have \
different dimensions, which produces rectangular inter-orbit hopping blocks.\
\>", "TechNoteTableText",ExpressionUUID->
     "a2bcdad7-aa04-4cb1-a6b7-509902ccfa04"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxDividers->{"Rows" -> {{False}}},
  GridBoxSpacings->{"Columns" -> {
      Offset[0.27999999999999997`], {
       Offset[0.7]}, 
      Offset[0.27999999999999997`]}, "Rows" -> {
      Offset[0.2], {
       Offset[0.4]}, 
      Offset[0.2]}}]], "3ColumnTableMod",
 GridBoxOptions->{
 GridBoxBackground->{
  "Columns" -> {{None}}, "Rows" -> {None, None, None, None, {None}}},
 GridBoxDividers->{
  "Rows" -> {{
     True, True, True, True, True, 
      True}}}},ExpressionUUID->"72373e71-8eda-4d5a-9ed9-9d34be90e866"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"grapheneOperations", " ", "=", " ", 
   RowBox[{"msgop", "[", 
    RowBox[{"gray", "[", "191", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "0", ",", " ", "0"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"a", "/", "2"}]}], ",", " ", "0"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "c"}], "}"}]}], "\n", "  ", 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"c", " ", "->", " ", "3"}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "3"}], ",", " ", 
          RowBox[{"2", "/", "3"}], ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "\n", 
      "  ", "}"}]}], ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", "grapheneOperations"}], ",", 
    "\n", "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", "\"\<pz\>\"", "}"}], "}"}]}]}], "\n", "]"}], 
  ";"}]}], "Input",ExpressionUUID->"a7e1a6b8-282c-4652-82af-b37993d873bd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["View atomic positions and magnetization directions", "TechNoteSection",ExpressionUUID->"7c95f2de-563f-4b71-bd9b-f3d849d44533"],

Cell["\<\
After init, use atompos to view the generated atomic positions and \
magnetization directions. The atoms are grouped by Wyckoff orbit. Each entry \
is {fractional position, magnetization direction}, with both vectors \
expressed in the lattice-vector basis:\
\>", "TechNoteText",ExpressionUUID->"ba5b8327-5346-4ba9-9705-50f59c028075"],

Cell[CellGroupData[{

Cell[BoxData["atompos"], "Input",ExpressionUUID->"507a794f-551e-4487-8e73-e75ef1b70029"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        FractionBox["1", "3"], ",", 
        FractionBox["2", "3"], ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        FractionBox["2", "3"], ",", 
        FractionBox["1", "3"], ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]}], "}"}], 
  "}"}]], "Output",ExpressionUUID->"5a4332f5-42c4-4f75-8eee-3d21d92632bc"]
}, Open  ]],

Cell["\<\
The two entries are the carbon atoms at {1/3,2/3,0} and {2/3,1/3,0}. Their \
magnetization directions are both {0,0,0}, since this model is nonmagnetic.\
\>", "TechNoteText",ExpressionUUID->"3dcaa34c-c64c-4c33-bb39-96dcc4560d93"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Check the neighbour shells", "TechNoteSection",ExpressionUUID->"6388be73-1431-43af-b5d8-37b9555a3fe0"],

Cell["\<\
Hoppings are numbered by distance. Number 1 is the onsite term, number 2 is \
the nearest neighbor, and number 3 is the second neighbor. For graphene, \
showbonds[2] displays the three nearest-neighbor carbon-carbon bonds and \
their reverse directions. No hopping parameters need to be specified to draw \
these bonds.\
\>", "TechNoteText",ExpressionUUID->"728a4f95-a36b-4b9b-9a69-9ccf8aa8bab5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"showbonds", "[", "2", "]"}]], "Input",ExpressionUUID->"14c8e73d-54cc-4c95-a7a0-d9bf64c346f8"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{
      "\"Bond shell \"", "2", "\" (\"", "1", "\"-th neighbour), \"", 
       "\"bond length = \"", "0.5773502691896257`", "\"; \"", "6", 
       "\" directed bonds, \"", "1", "\" directed orbits\""},
      "RowDefault"], "\[SpanFromLeft]", "\[SpanFromLeft]", 
     "\[SpanFromLeft]"},
    {"\<\"Site index\"\>", "\<\"Atom position (fractional)\"\>", "\<\"Num. of \
directed bonds\"\>", 
     TemplateBox[{
       TagBox[
        SubsuperscriptBox["p", "k", "'"], DisplayForm], "\" (fractional)\""},
      "RowDefault"]},
    {"1", 
     RowBox[{"{", 
      RowBox[{
       FractionBox["1", "3"], ",", 
       FractionBox["2", "3"], ",", "0"}], "}"}], "3", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "3"]}], ",", 
         FractionBox["1", "3"], ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["2", "3"], ",", 
         FractionBox["1", "3"], ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["2", "3"], ",", 
         FractionBox["4", "3"], ",", "0"}], "}"}]}], "}"}]},
    {"2", 
     RowBox[{"{", 
      RowBox[{
       FractionBox["2", "3"], ",", 
       FractionBox["1", "3"], ",", "0"}], "}"}], "3", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", "3"], ",", 
         RowBox[{"-", 
          FractionBox["1", "3"]}], ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", "3"], ",", 
         FractionBox["2", "3"], ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["4", "3"], ",", 
         FractionBox["2", "3"], ",", "0"}], "}"}]}], "}"}]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",ExpressionUUID->"c891d9cd-ee91-4830-836a-a92a861fac35"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Solve the Hamiltonian shell by shell", "TechNoteSection",ExpressionUUID->"4297d884-77e6-4e3a-82af-8689a9269a12"],

Cell["\<\
First calculate the onsite term with symham[1]. The two carbon atoms are \
equivalent, so both diagonal entries contain the same real parameter e1:\
\>", "TechNoteText",ExpressionUUID->"d251ea31-8fd2-474f-b5d8-307180a3f003"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"grapheneOnsite", " ", "=", " ", 
   RowBox[{"symham", "[", "1", "]"}]}], ";"}], "\n", 
 RowBox[{"MatrixForm", "[", "grapheneOnsite", "]"}]}], "Input",ExpressionUUID->\
"f179f9b1-4f91-4e5a-9ffe-73d56f8ca955"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"e1", "0"},
     {"0", "e1"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",ExpressionUUID->"8f695973-e6f1-424d-\
ad70-ae20f50f0f98"]
}, Open  ]],

Cell["\<\
Next calculate the nearest-neighbor hopping with symham[2]. The three phase \
factors in the upper-right entry come from the three nearest-neighbor bonds. \
For real t1, the lower-left entry is its complex conjugate:\
\>", "TechNoteText",ExpressionUUID->"d223d534-abf0-4caf-b5ce-710dd0d055a8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"grapheneNearest", " ", "=", " ", 
   RowBox[{"symham", "[", "2", "]"}]}], ";"}], "\n", 
 RowBox[{"MatrixForm", "[", "grapheneNearest", "]"}]}], "Input",ExpressionUUID\
->"35359546-2148-44d7-a63d-8a41581bcec8"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"0", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             FractionBox[
              RowBox[{"2", " ", "kx"}], "3"]}], "-", 
            FractionBox["ky", "3"]}], ")"}]}]], " ", "t1"}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            FractionBox["kx", "3"], "-", 
            FractionBox["ky", "3"]}], ")"}]}]], " ", "t1"}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            FractionBox["kx", "3"], "+", 
            FractionBox[
             RowBox[{"2", " ", "ky"}], "3"]}], ")"}]}]], " ", "t1"}]}]},
     {
      RowBox[{
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             FractionBox["kx", "3"]}], "-", 
            FractionBox[
             RowBox[{"2", " ", "ky"}], "3"]}], ")"}]}]], " ", "t1"}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             FractionBox["kx", "3"]}], "+", 
            FractionBox["ky", "3"]}], ")"}]}]], " ", "t1"}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            FractionBox[
             RowBox[{"2", " ", "kx"}], "3"], "+", 
            FractionBox["ky", "3"]}], ")"}]}]], " ", "t1"}]}], "0"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",ExpressionUUID->"8fc80fa6-effc-488e-\
9588-b8779b32c164"]
}, Open  ]],

Cell["\<\
symham[3] gives the second-neighbor hopping. These bonds connect carbon atoms \
on the same sublattice, so their six phase factors appear in the diagonal \
entries:\
\>", "TechNoteText",ExpressionUUID->"f56e9cbd-ac82-462b-8574-7ed4ce6e1563"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"grapheneNextNearest", " ", "=", " ", 
   RowBox[{"symham", "[", "3", "]"}]}], ";"}], "\n", 
 RowBox[{"MatrixForm", "[", "grapheneNextNearest", "]"}]}], "Input",Expression\
UUID->"fa8ea134-831e-492b-a279-1b553e97d7e1"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "kx"}]], " ", "r1"}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", "kx"}]], " ", "r1"}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "kx"}], "-", "ky"}], ")"}]}]], " ", "r1"}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "ky"}]], " ", "r1"}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", "ky"}]], " ", "r1"}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{"kx", "+", "ky"}], ")"}]}]], " ", "r1"}]}], "0"},
     {"0", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "kx"}]], " ", "r1"}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", "kx"}]], " ", "r1"}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "kx"}], "-", "ky"}], ")"}]}]], " ", "r1"}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "ky"}]], " ", "r1"}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", "ky"}]], " ", "r1"}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{"kx", "+", "ky"}], ")"}]}]], " ", "r1"}]}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",ExpressionUUID->"d3f7cf1c-9783-43ed-\
9814-ce1341ef027c"]
}, Open  ]],

Cell["\<\
Add the contributions to obtain the Hamiltonian. Here we keep the onsite, \
nearest-neighbor, and second-neighbor terms:\
\>", "TechNoteText",ExpressionUUID->"13f2379d-0cfc-4477-a01c-40154e9e9400"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"grapheneOnsite", " ", "=", " ", 
   RowBox[{"symham", "[", "1", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grapheneNearest", " ", "=", " ", 
   RowBox[{"symham", "[", "2", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grapheneNextNearest", " ", "=", " ", 
   RowBox[{"symham", "[", "3", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grapheneHamiltonian", " ", "=", "\n", "  ", 
   RowBox[{
   "grapheneOnsite", " ", "+", " ", "grapheneNearest", " ", "+", " ", 
    "grapheneNextNearest"}]}], ";"}], "\n", 
 RowBox[{"MatrixForm", "[", "\n", "  ", 
  RowBox[{"FullSimplify", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"ExpToTrig", "[", "grapheneHamiltonian", "]"}], ",", "\n", "    ", 
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"kx", ",", " ", "ky", ",", " ", "kz"}], "}"}], ",", " ", 
      "Reals"}], "]"}]}], "\n", "  ", "]"}], "\n", "]"}]}], "Input",Expression\
UUID->"c4bc169c-e572-4196-9eb5-9b72e816b702"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{"e1", "+", 
       RowBox[{"2", " ", "r1", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Cos", "[", "kx", "]"}], "+", 
          RowBox[{"Cos", "[", "ky", "]"}], "+", 
          RowBox[{"Cos", "[", 
           RowBox[{"kx", "+", "ky"}], "]"}]}], ")"}]}]}], 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "3"]}], " ", "\[ImaginaryI]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "kx"}], "+", "ky"}], ")"}]}]], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"\[ImaginaryI]", " ", "kx"}]], "+", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"\[ImaginaryI]", " ", 
           RowBox[{"(", 
            RowBox[{"kx", "+", "ky"}], ")"}]}]]}], ")"}], " ", "t1"}]},
     {
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "3"]}], " ", "\[ImaginaryI]", " ", 
         RowBox[{"(", 
          RowBox[{"kx", "+", 
           RowBox[{"2", " ", "ky"}]}], ")"}]}]], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"\[ImaginaryI]", " ", "ky"}]], "+", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"\[ImaginaryI]", " ", 
           RowBox[{"(", 
            RowBox[{"kx", "+", "ky"}], ")"}]}]]}], ")"}], " ", "t1"}], 
      RowBox[{"e1", "+", 
       RowBox[{"2", " ", "r1", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Cos", "[", "kx", "]"}], "+", 
          RowBox[{"Cos", "[", "ky", "]"}], "+", 
          RowBox[{"Cos", "[", 
           RowBox[{"kx", "+", "ky"}], "]"}]}], ")"}]}]}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",ExpressionUUID->"4946f1b6-f75c-4106-\
8270-f4a0b9a0b149"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Explore the bands", "TechNoteSection",ExpressionUUID->"44ad03f4-decc-4bb0-9ab4-8228fd916546"],

Cell["\<\
The path is given in reciprocal fractional coordinates. Each entry contains a \
segment and its endpoint labels. bandManipulate draws the bands along this \
path and provides a slider for each parameter. The sliders initially equal \
zero, and no extra energy shift is added.\
\>", "TechNoteText",ExpressionUUID->"b62483db-193b-4ece-a100-3565413a8c34"],

Cell[BoxData[
 RowBox[{
  RowBox[{"graphenePath", " ", "=", " ", 
   RowBox[{"{", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"1", "/", "2"}], ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<G\>\"", ",", " ", "\"\<M\>\""}], "}"}]}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"1", "/", "2"}], ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "3"}], ",", " ", 
           RowBox[{"1", "/", "3"}], ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<M\>\"", ",", " ", "\"\<K\>\""}], "}"}]}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "3"}], ",", " ", 
           RowBox[{"1", "/", "3"}], ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<K\>\"", ",", " ", "\"\<G\>\""}], "}"}]}], "}"}]}], "\n", 
    "}"}]}], ";"}]], "Input",ExpressionUUID->"610b97e1-1e3f-49aa-ad8f-\
5aa26f4a9d24"],

Cell[BoxData[
 RowBox[{"bandManipulate", "[", 
  RowBox[{"graphenePath", ",", " ", "30", ",", " ", "grapheneHamiltonian"}], 
  "]"}]], "Input",ExpressionUUID->"e49eb74c-dbf0-41d6-bc08-4ecb2df92040"],

Cell["\<\
To draw a band plot with fixed parameters, assign their values as below. The \
second-neighbor term r1 breaks particle-hole symmetry, but the Dirac crossing \
at K remains:\
\>", "TechNoteText",ExpressionUUID->"130bda7b-5dd0-4638-8417-c0b4c5503914"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"bandplot", "[", "\n", "  ", 
  RowBox[{
  "graphenePath", ",", "\n", "  ", "60", ",", "\n", "  ", 
   "grapheneHamiltonian", ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"e1", " ", "->", " ", "0.05"}], ",", " ", 
     RowBox[{"r1", " ", "->", " ", "0.02"}], ",", " ", 
     RowBox[{"t1", " ", "->", " ", "0.5"}]}], "}"}]}], "\n", "]"}]], "Input",E\
xpressionUUID->"0b231f2c-faf0-4356-b220-7983adc6a9f6"],

