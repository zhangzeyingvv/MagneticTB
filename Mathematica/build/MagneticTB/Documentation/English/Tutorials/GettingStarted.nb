     Line3DBox[{{1., 0., 0.}, {1., 0., 1.}}], 
     Line3DBox[{{1., 0., 0.}, {1., 1., 0.}}], 
     Line3DBox[{{1., 0., 1.}, {1., 1., 1.}}], 
     Line3DBox[{{1., 1., 0.}, {1., 1., 1.}}]}, {
     {RGBColor[0.368417, 0.506779, 0.709798], Specularity[
       GrayLevel[1], 20], SphereBox[{0., 0., 0.}, 0.08]}, 
     {RGBColor[0.368417, 0.506779, 0.709798], Specularity[
       GrayLevel[1], 20], SphereBox[{0.5, 0., 0.}, 0.08]}}}, 
   {RGBColor[1, 0, 0], Thickness[Large], Arrowheads[
    0.035], {Arrow3DBox[{{0., 0., 0.}, {0., 0., 0.55}}], 
     Arrow3DBox[{{0.5, 0., 0.}, {0.5, 0., -0.55}}]}, {}}},
