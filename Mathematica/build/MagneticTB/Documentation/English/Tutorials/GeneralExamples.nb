Cell[CellGroupData[{

Cell["Spinful MoS2 and two explicit basis orders", "Subsection",ExpressionUUID->"526abc36-560f-4143-9a8d-69b0b05fb366"],

Cell["\<\
For the spinful onsite Hamiltonian, first place all spin-up orbitals before \
the spin-down orbitals. Specify the reduced symmetry in init before \
calculating the Hamiltonian:\
\>", "TechNoteText",ExpressionUUID->"aa99dd85-f30b-49b7-bc10-68498e1fa81d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"moS2SpinAOperations", " ", "=", " ", 
   RowBox[{"msgop", "[", 
    RowBox[{"gray", "[", "187", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "0", ",", " ", "0"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"a", "/", "2"}]}], ",", " ", "0"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "c"}], "}"}]}], "\n", "  ", 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"c", " ", "->", " ", "4"}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "}"}]}],
     ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", "moS2SpinAOperations"}], ",", 
    "\n", "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"\"\<dz2up\>\"", ",", " ", "\"\<dxyup\>\"", ",", 
        " ", "\"\<dx2-y2up\>\"", ",", " ", "\"\<dz2dn\>\"", ",", 
        " ", "\"\<dxydn\>\"", ",", " ", "\"\<dx2-y2dn\>\""}], "}"}], "}"}]}], 
    ",", "\n", "  ", 
    RowBox[{"InitialBondShells", " ", "->", " ", "1"}], ",", "\n", "  ", 
    RowBox[{"GenerateSymmetryGroup", " ", "->", " ", "False"}]}], "\n", "]"}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"moS2SpinARules", " ", "=", " ", 
   RowBox[{"brokenSymmetryInitRules", "[", 
    RowBox[{"{", 
     RowBox[{"9", ",", " ", "11", ",", " ", "13"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"init", " ", "@@", " ", "moS2SpinARules"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"moS2SpinAHamiltonian", " ", "=", " ", 
   RowBox[{"symham", "[", "1", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"0086ef28-fd42-406b-9f60-19e98c3270e4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"orbitalTable", "[", "]"}]], "Input",ExpressionUUID->"ce42ea0a-a89b-4c41-8398-37a39f352154"],

