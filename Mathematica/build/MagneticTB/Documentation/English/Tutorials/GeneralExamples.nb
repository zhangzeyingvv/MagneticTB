Cell[CellGroupData[{

Cell["Magnetic C3 Weyl point and Chern diagnostic", "TechNoteSection",ExpressionUUID->"3de7e805-8889-4c48-8428-4ca1b7231181"],

Cell["\<\
For magnetic space group 143.3, the local spinor pair gives a four-band \
Hamiltonian. As in the MagneticTB 1.0 example, select the two-band block with \
row and column indices {1,4}. The replacement c3OriginalParameterCoordinates \
puts its parameters in the 1.0 convention before numerical values are \
assigned.\
\>", "TechNoteText",ExpressionUUID->"6c6e6287-de0b-4bb9-bfd5-a1380769aebb"],

Cell["\<\
The parameters in this Weyl model and the following nodal-line and C4 models \
illustrate symmetry-allowed band structures. They are the values used in the \
MagneticTB 1.0 examples, not fitted parameters for a particular material.\
\>", "TechNoteText",ExpressionUUID->"26f25d76-6659-417a-8bd4-6b5af3459622"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"c3Operations", " ", "=", " ", 
   RowBox[{"msgop", "[", 
    RowBox[{"bnsdict", "[", 
     RowBox[{"{", 
      RowBox[{"143", ",", " ", "3"}], "}"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"a", "/", "2"}]}], ",", " ", 
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}], ",", " ", "0"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "a", ",", " ", "0"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "c"}], "}"}]}], "\n", "  ", 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"c", " ", "->", " ", "2"}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], "}"}], "\n", 
      "  ", "}"}]}], ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", "c3Operations"}], ",", "\n", 
    "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", " ", "+", " ", 
           RowBox[{"I", " ", "y"}]}], ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"x", " ", "-", " ", 
           RowBox[{"I", " ", "y"}]}]}], "}"}]}], "}"}], "}"}]}], ",", "\n", 
    "  ", 
    RowBox[{"InitialBondShells", " ", "->", " ", "4"}], ",", "\n", "  ", 
    RowBox[{"GenerateSymmetryGroup", " ", "->", " ", "False"}]}], "\n", "]"}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"c3Full", " ", "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"symham", "[", "i", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"c3OriginalParameterCoordinates", " ", "=", " ", 
   RowBox[{"{", "\n", "  ", 
    RowBox[{
     RowBox[{"r11", " ", "->", " ", 
      RowBox[{"-", "r2"}]}], ",", " ", 
     RowBox[{"r15", " ", "->", " ", 
      RowBox[{"-", "r10"}]}], ",", "\n", "  ", 
     RowBox[{"r3", " ", "->", " ", 
      RowBox[{"-", "r6"}]}], ",", " ", 
     RowBox[{"r7", " ", "->", " ", 
      RowBox[{"-", "r14"}]}], ",", "\n", "  ", 
     RowBox[{"s4", " ", "->", " ", 
      RowBox[{"-", "s4"}]}], ",", "\n", "  ", 
     RowBox[{"t4", " ", "->", " ", "t1"}], ",", " ", 
     RowBox[{"t8", " ", "->", " ", "t9"}], ",", " ", 
     RowBox[{"t11", " ", "->", " ", 
      RowBox[{"-", "t7"}]}]}], "\n", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"c3Hamiltonian", " ", "=", "\n", "  ", 
   RowBox[{
    RowBox[{"c3Full", "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "4"}], "}"}]}], "]"}], "]"}], " ", "/.", "\n", 
    "    ", "c3OriginalParameterCoordinates"}]}], ";"}]}], "Input",ExpressionU\
UID->"a74730f2-25f8-429d-9df5-16621e12ed8c"],

Cell["\<\
The full two-band c3Hamiltonian is used for the band plot and Chern-number \
calculation below. To see its matrix elements more clearly, first display it \
on Gamma-A by setting kx=ky=0:\
\>", "TechNoteText",ExpressionUUID->"7512c08e-7b2f-4cfa-9aa2-62d5e923d050"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"c3GammaAxisHamiltonian", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"c3Hamiltonian", " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"kx", " ", "->", " ", "0"}], ",", " ", 
        RowBox[{"ky", " ", "->", " ", "0"}]}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"Element", "[", 
      RowBox[{"kz", ",", " ", "Reals"}], "]"}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"MatrixForm", "[", "c3GammaAxisHamiltonian", "]"}]}], "Input",Express\
ionUUID->"0fd966b9-cbcd-4d2c-9f4c-432de26a6030"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{"6", " ", 
       RowBox[{"(", 
        RowBox[{"s8", "+", "t9"}], ")"}]}], 
      RowBox[{
       RowBox[{"-", "2"}], " ", "\[ImaginaryI]", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"3", " ", "r10"}], "-", 
         RowBox[{"3", " ", "r14"}], "+", 
         RowBox[{"3", " ", "\[ImaginaryI]", " ", "r2"}], "-", 
         RowBox[{"3", " ", "\[ImaginaryI]", " ", "r6"}], "+", "t15", "-", 
         RowBox[{"\[ImaginaryI]", " ", "t7"}]}], ")"}], " ", 
       RowBox[{"Sin", "[", 
        FractionBox["kz", "2"], "]"}]}]},
     {
      RowBox[{"2", " ", "\[ImaginaryI]", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"3", " ", "r10"}], "-", 
         RowBox[{"3", " ", "r14"}], "-", 
         RowBox[{"3", " ", "\[ImaginaryI]", " ", "r2"}], "+", 
         RowBox[{"3", " ", "\[ImaginaryI]", " ", "r6"}], "+", "t15", "+", 
         RowBox[{"\[ImaginaryI]", " ", "t7"}]}], ")"}], " ", 
       RowBox[{"Sin", "[", 
        FractionBox["kz", "2"], "]"}]}], 
      RowBox[{"6", " ", 
       RowBox[{"(", 
        RowBox[{"s8", "+", "t9"}], ")"}]}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",ExpressionUUID->"fbe53a4f-d2f7-4d95-\
8f08-e0bd5e9f20e1"]
}, Open  ]],

