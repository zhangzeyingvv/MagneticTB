Cell["\<\
Expand the Hamiltonian about Gamma through total order three, then pass it to \
pointChernNumber. The function calculates the occupied-band Berry flux \
through a cube surrounding the point. The occupied band must remain separated \
from the other band on the cube surface; the enclosed Chern number is given \
below.\
\>", "TechNoteText",ExpressionUUID->"de50dd2d-c5bb-41d2-a329-beb6d53a6893"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"c3Taylor", " ", "=", " ", 
   RowBox[{"Expand", "@", 
    RowBox[{"Normal", "@", 
     RowBox[{"Chop", "@", 
      RowBox[{"Series", "[", "\n", "  ", 
       RowBox[{"c3Hamiltonian", ",", " ", 
        RowBox[{"{", 
         RowBox[{"ky", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"kx", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"kz", ",", " ", "0", ",", " ", "3"}], "}"}]}], "\n", 
       "]"}]}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"c3Taylor", " ", "=", " ", 
   RowBox[{"FromCoefficientRules", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"Map", "[", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"#", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Total", "[", 
             RowBox[{"First", "[", "#", "]"}], "]"}], " ", "<=", " ", "3"}], 
           " ", "&"}]}], "]"}], " ", "&"}], " ", ",", "\n", "    ", 
       RowBox[{"CoefficientRules", "[", 
        RowBox[{"c3Taylor", ",", " ", 
         RowBox[{"{", 
          RowBox[{"kx", ",", " ", "ky", ",", " ", "kz"}], "}"}]}], "]"}], ",",
        "\n", "    ", 
       RowBox[{"{", "2", "}"}]}], "\n", "  ", "]"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"kx", ",", " ", "ky", ",", " ", "kz"}], "}"}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"c3Numeric", "[", "momentum_List", "]"}], " ", ":=", " ", 
   RowBox[{"N", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"c3Taylor", " ", "/.", " ", "c3Parameters"}], " ", "/.", "\n", 
     "    ", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"kx", ",", " ", "ky", ",", " ", "kz"}], "}"}], " ", "->", " ",
        "momentum"}], "]"}]}], "\n", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"4739c819-714f-4aa0-b3b9-01be6873578d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"pointChernNumber", "[", "\n", "  ", 
  RowBox[{"c3Numeric", ",", " ", "1", ",", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", "2", ",", 
   "\n", "  ", 
   RowBox[{"\"\<SurfaceSubdivisions\>\"", " ", "->", " ", "8"}]}], "\n", 
  "]"}]], "Input",ExpressionUUID->"5fa36dc1-8263-4088-bbca-38537c420b00"],

Cell[BoxData["3"], "Output",ExpressionUUID->"2d54acd3-c3c5-4122-a484-869ae1c90819"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Magnetic cubic nodal line", "TechNoteSection",ExpressionUUID->"b94bbc5c-9e97-461f-a39b-2c3027440ddd"],

Cell["\<\
Next use magnetic space group 184.196 with the same local spinor basis. The \
operations numbered {2,7,13} in the MagneticTB 1.0 example generate this \
24-operation group; init below receives the full group. Again select the \
{1,4} two-band block, and use nodalOriginalParameterCoordinates to put its \
parameters in the 1.0 convention.\
\>", "TechNoteText",ExpressionUUID->"d344e76d-6b80-4661-bccc-652ca1473f85"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nodalOperations", " ", "=", " ", 
   RowBox[{"msgop", "[", 
    RowBox[{"bnsdict", "[", 
     RowBox[{"{", 
      RowBox[{"184", ",", " ", "196"}], "}"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"a", "/", "2"}]}], ",", " ", 
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}], ",", " ", "0"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "a", ",", " ", "0"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "c"}], "}"}]}], "\n", "  ", 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"c", " ", "->", " ", "2"}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], "}"}], "\n", 
      "  ", "}"}]}], ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", "nodalOperations"}], ",", "\n",
     "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", " ", "+", " ", 
           RowBox[{"I", " ", "y"}]}], ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"x", " ", "-", " ", 
           RowBox[{"I", " ", "y"}]}]}], "}"}]}], "}"}], "}"}]}], ",", "\n", 
    "  ", 
    RowBox[{"InitialBondShells", " ", "->", " ", "5"}], ",", "\n", "  ", 
    RowBox[{"GenerateSymmetryGroup", " ", "->", " ", "False"}]}], "\n", "]"}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"nodalFull", " ", "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"symham", "[", "i", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "5"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nodalOriginalParameterCoordinates", " ", "=", " ", 
   RowBox[{"{", "\n", "  ", 
    RowBox[{
     RowBox[{"p5n1", " ", "->", " ", "p5n4"}], ",", " ", 
     RowBox[{"p5n8", " ", "->", " ", "p5n2"}], ",", "\n", "  ", 
     RowBox[{"s1", " ", "->", " ", "s3"}], ",", " ", 
     RowBox[{"t1", " ", "->", " ", "t2"}], ",", "\n", "  ", 
     RowBox[{"p5n6", " ", "->", " ", 
      RowBox[{"-", "p5n7"}]}], ",", " ", 
     RowBox[{"r2", " ", "->", " ", 
      RowBox[{"-", "r1"}]}]}], "\n", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nodalHamiltonian", " ", "=", "\n", "  ", 
   RowBox[{
    RowBox[{"nodalFull", "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "4"}], "}"}]}], "]"}], "]"}], " ", "/.", "\n", 
    "    ", "nodalOriginalParameterCoordinates"}]}], ";"}]}], "Input",Expressi\
onUUID->"1f10d97f-557d-40ea-8353-30d3afddf8c4"],

