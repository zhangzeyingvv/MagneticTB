       RowBox[{"2", " ", "x", " ", "y"}]}], "}"}], "\<\"FactorizedSpinor\"\>", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], "None"},
    {"6", "1", "1", "1", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], 
     RowBox[{"{", 
