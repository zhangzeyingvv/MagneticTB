        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",ExpressionUUID->"e6d7fa57-ab25-4ea7-\
ae74-cb1ff5aacc79"]
