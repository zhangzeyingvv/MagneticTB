           RowBox[{"2", " ", "ky"}]}], ")"}]}]], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"\[ImaginaryI]", " ", "ky"}]], "+", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"\[ImaginaryI]", " ", 
           RowBox[{"(", 
            RowBox[{"kx", "+", "ky"}], ")"}]}]]}], ")"}], " ", "t1"}], 
      RowBox[{"e1", "+", 
       RowBox[{"2", " ", "r1", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Cos", "[", "kx", "]"}], "+", 
          RowBox[{"Cos", "[", "ky", "]"}], "+", 
          RowBox[{"Cos", "[", 
           RowBox[{"kx", "+", "ky"}], "]"}]}], ")"}]}]}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
