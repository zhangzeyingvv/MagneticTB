Cell[CellGroupData[{

Cell["General MagneticTB Examples", "TechNoteTitle",ExpressionUUID->"e463e298-8cb2-47cd-983b-0d428f08452b"],

Cell["\<\
The following examples show how to construct models for graphene, MoS2, \
magnetic Weyl points, nodal lines, and a C4 topological insulator. For each \
model, first specify the lattice, atomic positions, symmetry, and orbitals. \
Then calculate the Hamiltonian, assign its parameters, and plot the bands. \
Some examples also calculate a Chern number or export Wannier90 hopping data.\
\
\>", "TechNoteText",ExpressionUUID->"ed01db3b-206c-4627-ad11-c33ba83e253d"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<MagneticTB`\>\"", "]"}]], "Input",ExpressionUUID->"64f27124-d9c1-44a6-936d-78be515727fd"],

Cell[CellGroupData[{

Cell["Graphene", "TechNoteSection",ExpressionUUID->"1d80d2a5-e64d-4285-a696-cc4b54b0fa46"],

Cell["\<\
Start with graphene, retaining one pz orbital on each carbon atom. The \
complete input below gives the two-band Hamiltonian with onsite, \
nearest-neighbor, and second-neighbor terms:\
\>", "TechNoteText",ExpressionUUID->"8792cbb4-8a50-4346-b89a-2562705f7314"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"grapheneOperations", " ", "=", " ", 
   RowBox[{"msgop", "[", 
    RowBox[{"gray", "[", "191", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "0", ",", " ", "0"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"a", "/", "2"}]}], ",", " ", "0"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "c"}], "}"}]}], "\n", "  ", 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"c", " ", "->", " ", "3"}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "3"}], ",", " ", 
          RowBox[{"2", "/", "3"}], ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "\n", 
      "  ", "}"}]}], ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", "grapheneOperations"}], ",", 
    "\n", "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", "\"\<pz\>\"", "}"}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"InitialBondShells", " ", "->", " ", "3"}], ",", "\n", "  ", 
    RowBox[{"GenerateSymmetryGroup", " ", "->", " ", "False"}]}], "\n", "]"}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"grapheneOnsite", " ", "=", " ", 
   RowBox[{"symham", "[", "1", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grapheneNearest", " ", "=", " ", 
   RowBox[{"symham", "[", "2", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grapheneNextNearest", " ", "=", " ", 
   RowBox[{"symham", "[", "3", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grapheneHamiltonian", " ", "=", "\n", "  ", 
   RowBox[{
   "grapheneOnsite", " ", "+", " ", "grapheneNearest", " ", "+", " ", 
    "grapheneNextNearest"}]}], ";"}], "\n", 
 RowBox[{"MatrixForm", "[", "\n", "  ", 
  RowBox[{"FullSimplify", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"ExpToTrig", "[", "grapheneHamiltonian", "]"}], ",", "\n", "    ", 
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"kx", ",", " ", "ky", ",", " ", "kz"}], "}"}], ",", " ", 
      "Reals"}], "]"}]}], "\n", "  ", "]"}], "\n", "]"}]}], "Input",Expression\
UUID->"c0ce863f-648f-40cd-8ca1-97be51a3aad1"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{"e1", "+", 
       RowBox[{"2", " ", "r1", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Cos", "[", "kx", "]"}], "+", 
          RowBox[{"Cos", "[", "ky", "]"}], "+", 
          RowBox[{"Cos", "[", 
           RowBox[{"kx", "+", "ky"}], "]"}]}], ")"}]}]}], 
      RowBox[{
