         SuperscriptBox["z", "2"]}]}]}], "}"}], "\<\"FactorizedSpinor\"\>", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], "None"},
    {"5", "1", "1", "1", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], 
