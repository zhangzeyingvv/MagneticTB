Cell[CellGroupData[{

Cell["Using MagneticTB 1.0", "TechNoteTitle",ExpressionUUID->"21d33476-a4c2-47cb-8e3d-7e848bed03d7"],

Cell["\<\
MagneticTB 2.0 includes the functions from version 1.0. To continue using a \
1.0 notebook, load MagneticTBOld` and use the function names ending in old. \
The graphene example below shows how to initialize a model, calculate its \
Hamiltonian, and plot the bands with these functions.\
\>", "TechNoteText",ExpressionUUID->"892a15ad-e299-4912-8064-f6d9c677712a"],

Cell[CellGroupData[{

Cell["Load MagneticTB 1.0", "TechNoteSection",ExpressionUUID->"9c8f037b-fc6e-4097-837d-928302850a87"],

Cell["\<\
Start a fresh kernel and load MagneticTBOld` with the following command. Use \
separate kernels for versions 1.0 and 2.0:\
\>", "TechNoteText",ExpressionUUID->"688dc303-db1e-44a7-ac8b-10e7ff4bbe79"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<MagneticTBOld`\>\"", "]"}]], "Input",ExpressionUUID->"c81f34db-cbee-4ef0-ab7f-f7cc0e7d4e99"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Initialize the model with version 1.0", "TechNoteSection",ExpressionUUID->"9aee5b73-4c6a-4bda-b068-fe8867dc2fbe"],

Cell["\<\
For graphene, give the hexagonal lattice, one representative carbon position, \
and its pz orbital. The symmetry operations generate the second carbon atom. \
In version 1.0, the function and option names below all end in old:\
\>", "TechNoteText",ExpressionUUID->"a75f4131-5334-4f48-9b3e-3ff3aa5470bd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"grapheneOperationsOld", " ", "=", " ", 
   RowBox[{"msgopold", "[", 
    RowBox[{"grayold", "[", "191", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"initold", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"latticeold", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"aold", ",", " ", "0", ",", " ", "0"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "aold"}], "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"aold", "/", "2"}]}], ",", " ", "0"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "cold"}], "}"}]}], "\n", "  ", 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"lattparold", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"aold", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"cold", " ", "->", " ", "3"}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffpositionold", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "3"}], ",", " ", 
          RowBox[{"2", "/", "3"}], ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "\n", 
      "  ", "}"}]}], ",", "\n", "  ", 
    RowBox[{"symminformationold", " ", "->", " ", "grapheneOperationsOld"}], ",",
     "\n", "  ", 
    RowBox[{"basisFunctionsold", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", "\"\<pz\>\"", "}"}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"debugQold", " ", "->", " ", "False"}]}], "\n", "]"}], 
  ";"}]}], "Input",ExpressionUUID->"5f87dd2a-8a91-4802-a281-c5aae4f52429"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Construct and display the Hamiltonian with version 1.0", \
"TechNoteSection",ExpressionUUID->"87986030-427e-44a5-93c5-e2a9f8893b54"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"hOldOnsite", " ", "=", " ", 
   RowBox[{"symhamold", "[", "1", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hOldNearest", " ", "=", " ", 
   RowBox[{"symhamold", "[", "2", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hOld", " ", "=", " ", 
   RowBox[{"hOldOnsite", " ", "+", " ", "hOldNearest"}]}], ";"}], "\n", 
 RowBox[{"MatrixForm", "[", "hOld", "]"}]}], "Input",ExpressionUUID->\
"4f634c8b-012a-417d-b819-be672c2a629c"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"e1old", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             FractionBox[
              RowBox[{"2", " ", "kxold"}], "3"]}], "-", 
            FractionBox["kyold", "3"]}], ")"}]}]], " ", "t1old"}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            FractionBox["kxold", "3"], "-", 
            FractionBox["kyold", "3"]}], ")"}]}]], " ", "t1old"}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            FractionBox["kxold", "3"], "+", 
            FractionBox[
             RowBox[{"2", " ", "kyold"}], "3"]}], ")"}]}]], " ", 
        "t1old"}]}]},
     {
      RowBox[{
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             FractionBox["kxold", "3"]}], "-", 
            FractionBox[
             RowBox[{"2", " ", "kyold"}], "3"]}], ")"}]}]], " ", "t1old"}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             FractionBox["kxold", "3"]}], "+", 
            FractionBox["kyold", "3"]}], ")"}]}]], " ", "t1old"}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            FractionBox[
             RowBox[{"2", " ", "kxold"}], "3"], "+", 
            FractionBox["kyold", "3"]}], ")"}]}]], " ", "t1old"}]}], "e1old"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",ExpressionUUID->"3675ec16-4f55-444c-\
a002-68c6d246af6c"]
}, Open  ]]
}, Open  ]],

