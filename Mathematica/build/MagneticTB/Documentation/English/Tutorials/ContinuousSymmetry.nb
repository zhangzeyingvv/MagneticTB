Cell[CellGroupData[{

Cell["Band splitting along G-Z", "TechNoteSection",ExpressionUUID->"44f78acc-54bf-4268-80da-c82d2911dab1"],

Cell["\<\
The nearest neighbors lie along c, so plot the bands on G-Z. For clarity, \
keep one nonzero hopping parameter in each model. In the SOC model, also turn \
on the two onsite spin-orbital mixing terms shown in the matrix above.\
\>", "TechNoteText",ExpressionUUID->"4d0681e8-89fb-4497-b63a-1357e784f090"],

Cell["The bands with SOC are:", "TechNoteText",ExpressionUUID->"7d377c83-1206-4548-a27a-57b58fa02bd8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"bandplot", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
