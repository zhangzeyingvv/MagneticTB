Cell[CellGroupData[{

Cell["Without SOC: add continuous C-infinity spin symmetry", "TechNoteSection",ExpressionUUID->"7ab1efba-8ff0-49c0-b646-20031f378562"],

Cell["\<\
Without SOC, spin can also rotate independently about the magnetic axis. \
Write the finite operations as a spin-space group and add this continuous \
C_infinity symmetry. The finite representation matrices below come from the \
preceding model; pass them to initfromrep together with the continuous \
rotation.\
\>", "TechNoteText",ExpressionUUID->"52c84ef8-3182-48cd-9f6e-fb98591e0c53"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"initfromrep", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "a", ",", " ", "c"}], "}"}], "]"}]}], ",", "\n",
     "  ", 
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"c", " ", "->", " ", 
        RowBox[{"3", "/", "2"}]}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], "}"}], "}"}]}],
     ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", 
     RowBox[{"Append", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"Association", " ", "@", " ", 
        RowBox[{"MapIndexed", "[", "\n", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\"\<g\>\"", " ", "<>", " ", 
             RowBox[{"ToString", "[", 
              RowBox[{"#2", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}]}], " ", "->", " ", 
            RowBox[{"<|", "\n", "        ", 
             RowBox[{
              RowBox[{"\"\<space\>\"", " ", "->", " ", 
               RowBox[{"#1", "[", 
                RowBox[{"[", 
                 RowBox[{"{", 
                  RowBox[{"2", ",", " ", "3"}], "}"}], "]"}], "]"}]}], ",", 
              "\n", "        ", 
              RowBox[{"\"\<spin\>\"", " ", "->", " ", 
               RowBox[{"{", "\n", "          ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Det", "[", 
                   RowBox[{"#1", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}], " ", 
                  RowBox[{"#1", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
                 RowBox[{"Boole", "[", 
                  RowBox[{
                   RowBox[{"#1", "[", 
                    RowBox[{"[", "4", "]"}], "]"}], " ", "==", 
                   " ", "\"\<T\>\""}], "]"}]}], "\n", "        ", "}"}]}]}], 
             "\n", "      ", "|>"}]}], " ", "&"}], ",", "\n", "      ", 
          RowBox[{"msgop", "[", 
           RowBox[{"typeIV", "[", 
            RowBox[{"{", 
             RowBox[{"124", ",", " ", "360"}], "}"}], "]"}], "]"}]}], "\n", 
         "    ", "]"}]}], ",", "\n", "    ", 
       RowBox[{"\"\<C_infty\>\"", " ", "->", " ", 
        RowBox[{"<|", "\n", "      ", 
         RowBox[{
          RowBox[{"\"\<space\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"IdentityMatrix", "[", "3", "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}]}], ",",
           "\n", "      ", 
          RowBox[{"\"\<spin\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "\n", "        ", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Cos", "[", "theta", "]"}], ",", " ", 
                 RowBox[{"-", 
                  RowBox[{"Sin", "[", "theta", "]"}]}], ",", " ", "0"}], 
                "}"}], ",", "\n", "        ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Sin", "[", "theta", "]"}], ",", " ", 
                 RowBox[{"Cos", "[", "theta", "]"}], ",", " ", "0"}], "}"}], ",",
                "\n", "        ", 
               RowBox[{"{", 
                RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], "\n", 
              "      ", "}"}], ",", " ", "0"}], "}"}]}], ",", "\n", "      ", 
          
          RowBox[{"\"\<continuous\>\"", " ", "->", " ", "theta"}]}], "\n", 
         "    ", "|>"}]}]}], "\n", "  ", "]"}]}], ",", "\n", "  ", 
    RowBox[{"repinformation", " ", "->", " ", 
     RowBox[{"<|", "\n", "    ", 
      RowBox[{
       RowBox[{"\"\<Discrete\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"MapThread", "[", "\n", "      ", 
          RowBox[{
           RowBox[{"Function", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"matrix", ",", " ", "operation"}], "}"}], ",", "\n", 
             "        ", 
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"site", " ", "=", " ", 
                 RowBox[{"First", "@", 
                  RowBox[{"FirstPosition", "[", "\n", "            ", 
                   RowBox[{
                    RowBox[{"First", "@", 
                    RowBox[{
                    RowBox[{"CurrentModelSession", "[", "]"}], "[", "\n", 
                    "              ", 
                    
                    RowBox[{"\"\<ModelSpecification\>\"", ",", 
                    " ", "\"\<SiteOrbits\>\""}], "\n", "            ", 
                    "]"}]}], ",", "\n", "            ", 
                    RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{"operation", "[", 
                    RowBox[{"[", "3", "]"}], "]"}], ",", " ", "1"}], "]"}]}], 
                   "\n", "          ", "]"}]}]}], "}"}], ",", "\n", 
               "          ", 
               RowBox[{"matrix", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"6", " ", 
                    RowBox[{"(", 
                    RowBox[{"site", " ", "-", " ", "1"}], ")"}]}], " ", "+", 
                   " ", 
                   RowBox[{"Range", "[", "6", "]"}]}], ",", " ", 
                  RowBox[{"Range", "[", "6", "]"}]}], "]"}], "]"}]}], "\n", 
              "        ", "]"}]}], "\n", "      ", "]"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"socRepresentation", ",", " ", 
             RowBox[{"msgop", "[", 
              RowBox[{"typeIV", "[", 
               RowBox[{"{", 
                RowBox[{"124", ",", " ", "360"}], "}"}], "]"}], "]"}]}], 
            "}"}]}], "\n", "    ", "]"}], "}"}]}], ",", "\n", "    ", 
       RowBox[{"\"\<Continuous\>\"", " ", "->", " ", 
        RowBox[{"<|", "\n", "      ", 
         RowBox[{"\"\<SiteMatrices\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"ConstantArray", "[", "\n", "        ", 
            RowBox[{
             RowBox[{"KroneckerProduct", "[", "\n", "          ", 
              RowBox[{
               RowBox[{"IdentityMatrix", "[", "3", "]"}], ",", "\n", 
               "          ", 
               RowBox[{"DiagonalMatrix", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Exp", "[", 
                   RowBox[{
                    RowBox[{"-", "I"}], " ", 
                    RowBox[{"theta", "/", "2"}]}], "]"}], ",", " ", 
                  RowBox[{"Exp", "[", 
                   RowBox[{"I", " ", 
                    RowBox[{"theta", "/", "2"}]}], "]"}]}], "}"}], "]"}]}], 
              "\n", "        ", "]"}], ",", "\n", "        ", "2"}], "\n", 
            "      ", "]"}], "}"}]}], "\n", "    ", "|>"}]}]}], "\n", "  ", 
      "|>"}]}], ",", "\n", "  ", 
    RowBox[{"orbitalLabels", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", "\n", "    ", 
       RowBox[{"\"\<pxup\>\"", ",", " ", "\"\<pxdn\>\"", ",", 
        " ", "\"\<pyup\>\"", ",", " ", "\"\<pydn\>\"", ",", 
        " ", "\"\<pzup\>\"", ",", " ", "\"\<pzdn\>\""}], "\n", "  ", "}"}], 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"InitialBondShells", " ", "->", " ", "2"}]}], "\n", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"noSOCHamiltonian", " ", "=", " ", 
   RowBox[{
    RowBox[{"symham", "[", "1", "]"}], " ", "+", " ", 
    RowBox[{"symham", "[", "2", "]"}]}]}], ";"}]}], "Input",ExpressionUUID->\
"a7434f66-37a1-47ca-8ac2-252855ca6720"],

