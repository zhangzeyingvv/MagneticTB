   RowBox[{"[", 
    RowBox[{
     RowBox[{"1", " ", ";;", " ", "6"}], ",", " ", 
     RowBox[{"1", " ", ";;", " ", "6"}]}], "]"}], "]"}], "]"}]], "Input",Expre\
ssionUUID->"9cb74a1b-e4a5-4eaf-a261-3e555d649fdb"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{"-", "e8"}], "0", 
      RowBox[{"\[ImaginaryI]", " ", "e4"}], "0", "0", 
      RowBox[{"-", "e1"}]},
     {"0", 
      RowBox[{"-", "e7"}], "0", 
      RowBox[{"\[ImaginaryI]", " ", "e3"}], "e2", "0"},
