Cell["\<\
Compare the two onsite matrices. C_infinity sets the px/py-pz spin-mixing \
terms to zero. With onsite and nearest-neighbor hopping retained, the numbers \
of real parameters are 13 with SOC and 9 without SOC:\
\>", "TechNoteText",ExpressionUUID->"19853c08-7075-4d82-879a-3b1e3654bb17"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", "\n", "  ", 
  RowBox[{
   RowBox[{"Length", "[", 
    RowBox[{"Variables", "[", "socHamiltonian", "]"}], "]"}], ",", "\n", "  ", 
   RowBox[{"Length", "[", 
    RowBox[{"Variables", "[", "noSOCHamiltonian", "]"}], "]"}]}], "\n", 
  "}"}]], "Input",ExpressionUUID->"522f1f18-283f-4515-84ff-061a815e53a9"],

