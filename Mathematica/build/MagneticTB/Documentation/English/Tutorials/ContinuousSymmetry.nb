Cell[CellGroupData[{

Cell["\<\
High-symmetry tetragonal antiferromagnet: spin symmetry and SOC\
\>", "TechNoteTitle",ExpressionUUID->"4a78136d-b2ef-427b-a5a9-85ad53ca0090"],

Cell["\<\
Consider the tetragonal antiferromagnet with magnetic space group 124.360, \
P_c4/mcc. Its 32 operations generate two sites, at z=0 and z=1/2, with \
opposite moments. We compare the Hamiltonians and bands with and without \
spin-orbit coupling (SOC). Keep all px, py, and pz spin states so that onsite \
SOC can mix the different orbitals and spins.\
\>", "TechNoteText",ExpressionUUID->"98089dce-a6a0-4740-ab4d-dd25f01a7212"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<MagneticTB`\>\"", "]"}]], "Input",ExpressionUUID->"1b2947f2-ae45-423b-8ba0-08af7781de13"],

Cell[CellGroupData[{

Cell["High-symmetry MSG 124.360 with SOC", "TechNoteSection",ExpressionUUID->"b530dade-cff9-4b4e-bbd1-9346cd8680b9"],

Cell["\<\
With SOC, spin rotates together with the spatial operation. Pass the complete \
magnetic space group to init, then calculate the onsite term and the \
nearest-neighbor hopping between the two layers:\
\>", "TechNoteText",ExpressionUUID->"27fbe67e-49f9-4a07-94b7-69cbc32a78fc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "a", ",", " ", "c"}], "}"}], "]"}]}], ",", "\n",
     "  ", 
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"c", " ", "->", " ", 
        RowBox[{"3", "/", "2"}]}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], "}"}], "}"}]}],
     ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", 
     RowBox[{"msgop", "[", 
      RowBox[{"typeIV", "[", 
       RowBox[{"{", 
        RowBox[{"124", ",", " ", "360"}], "}"}], "]"}], "]"}]}], ",", "\n", 
    "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", "\n", "    ", 
       RowBox[{"\"\<pxup\>\"", ",", " ", "\"\<pxdn\>\"", ",", 
        " ", "\"\<pyup\>\"", ",", " ", "\"\<pydn\>\"", ",", 
        " ", "\"\<pzup\>\"", ",", " ", "\"\<pzdn\>\""}], "\n", "  ", "}"}], 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"InitialBondShells", " ", "->", " ", "2"}]}], "\n", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"socHamiltonian", " ", "=", " ", 
   RowBox[{
    RowBox[{"symham", "[", "1", "]"}], " ", "+", " ", 
    RowBox[{"symham", "[", "2", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"socRepresentation", " ", "=", " ", 
   RowBox[{
    RowBox[{"CurrentModelSession", "[", "]"}], "[", "\n", "  ", 
    RowBox[{"\"\<FullRepresentation\>\"", ",", 
     " ", "\"\<RepresentationMatrices\>\""}], "\n", "]"}]}], ";"}]}], "Input",\
ExpressionUUID->"a2de3194-d9c6-4d8b-8066-08a74af4124f"],

Cell[CellGroupData[{

