Cell["\<\
Every matrix must have the declared coordinate dimension. A row with only two \
entries in a three-coordinate problem fails explicitly:\
\>", "ExampleText",ExpressionUUID->"d1b2c571-e06e-44bb-a4bb-071b191b4058"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dimensionFailure", " ", "=", " ", 
   RowBox[{"CompileCyclotomicMatrices", "[", 
    RowBox[{"<|", "\n", "  ", 
     RowBox[{
      RowBox[{"\"\<coordinate_dimension\>\"", " ", "->", " ", "3"}], ",", 
      "\n", "  ", 
      RowBox[{"\"\<constraints\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], "}"}]}]}], "\n", "|>"}],
     "]"}]}], ";"}], "\n", 
 RowBox[{"<|", 
  RowBox[{"\"\<FailureTag\>\"", " ", "->", " ", 
   RowBox[{"dimensionFailure", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], "|>"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"41b14292-277d-4f5b-bcc4-30edbc7e8e3d"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{"\<\"FailureTag\"\>", "\[Rule]", "\<\"DimensionMismatch\"\>"}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]=",ExpressionUUID->"9604fb11-88e8-42cc-bd59-5393443d92b9"]
}, Open  ]],

Cell["\<\
The field degree may not exceed max_cyclotomic_degree. This boundary stops \
the calculation instead of changing to approximate arithmetic:\
\>", "ExampleText",ExpressionUUID->"f20c7078-1863-4f72-89b3-2de6d8775dd6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"z257", " ", "=", " ", 
   RowBox[{"<|", "\n", "  ", 
    RowBox[{
     RowBox[{"\"\<kind\>\"", " ", "->", " ", "\"\<root_sum\>\""}], ",", "\n", 
     "  ", 
     RowBox[{"\"\<constant\>\"", " ", "->", " ", "0"}], ",", "\n", "  ", 
     RowBox[{"\"\<terms\>\"", " ", "->", " ", 
      RowBox[{"{", "\n", "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<coefficient\>\"", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"\"\<order\>\"", " ", "->", " ", "257"}], ",", " ", 
         RowBox[{"\"\<power\>\"", " ", "->", " ", "1"}]}], "|>"}], "\n", "  ",
        "}"}]}]}], "\n", "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"degreeFailure", " ", "=", " ", 
   RowBox[{"CompileCyclotomicMatrices", "[", 
    RowBox[{"<|", "\n", "  ", 
     RowBox[{
      RowBox[{"\"\<coordinate_dimension\>\"", " ", "->", " ", "1"}], ",", 
      "\n", "  ", 
      RowBox[{"\"\<constraints\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"{", "z257", "}"}], "}"}], "}"}]}], ",", "\n", "  ", 
      RowBox[{"\"\<max_cyclotomic_degree\>\"", " ", "->", " ", "128"}]}], 
     "\n", "|>"}], "]"}]}], ";"}], "\n", 
 RowBox[{"<|", 
  RowBox[{"\"\<FailureTag\>\"", " ", "->", " ", 
   RowBox[{"degreeFailure", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], "|>"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[3]:=",ExpressionUUID->"d98797e0-2607-4ad6-96bc-1b4e726dd8a4"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{"\<\"FailureTag\"\>", 
   "\[Rule]", "\<\"ConductorDegreeLimitExceeded\"\>"}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[4]=",ExpressionUUID->"02caa583-0775-438b-bbac-e5b7dcc67e84"]
}, Open  ]]
}, Closed]]
}, Open  ]],

