Cell["\<\
Compile two three-coordinate constraints containing the fourth root of unity \
i. The summary shows that both blocks share conductor 4:\
\>", "ExampleText",ExpressionUUID->"f0011c5f-5579-49c8-a955-a10325b0d0e0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"iRoot", " ", "=", " ", 
   RowBox[{"<|", "\n", "  ", 
    RowBox[{
     RowBox[{"\"\<kind\>\"", " ", "->", " ", "\"\<root_sum\>\""}], ",", "\n", 
     "  ", 
     RowBox[{"\"\<constant\>\"", " ", "->", " ", "0"}], ",", "\n", "  ", 
     RowBox[{"\"\<terms\>\"", " ", "->", " ", 
      RowBox[{"{", "\n", "    ", 
       RowBox[{"<|", "\n", "      ", 
        RowBox[{
         RowBox[{"\"\<coefficient\>\"", " ", "->", " ", "1"}], ",", "\n", 
         "      ", 
         RowBox[{"\"\<order\>\"", " ", "->", " ", "4"}], ",", "\n", "      ", 
         
         RowBox[{"\"\<power\>\"", " ", "->", " ", "1"}]}], "\n", "    ", 
        "|>"}], "\n", "  ", "}"}]}]}], "\n", "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"compiledCyclotomic", " ", "=", " ", 
   RowBox[{"CompileCyclotomicMatrices", "[", 
    RowBox[{"<|", "\n", "  ", 
     RowBox[{
      RowBox[{"\"\<coordinate_dimension\>\"", " ", "->", " ", "3"}], ",", 
      "\n", "  ", 
      RowBox[{"\"\<constraints\>\"", " ", "->", " ", 
       RowBox[{"{", "\n", "    ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "iRoot", ",", " ", "0"}], "}"}], "}"}], ",",
          "\n", "    ", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1", ",", " ", "0"}], "}"}], "}"}]}], "\n", 
        "  ", "}"}]}], ",", "\n", "  ", 
      RowBox[{"\"\<max_cyclotomic_degree\>\"", " ", "->", " ", "128"}]}], 
     "\n", "|>"}], "]"}]}], ";"}], "\n", 
 RowBox[{"KeyTake", "[", "\n", "  ", 
  RowBox[{"compiledCyclotomic", ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"\"\<type\>\"", ",", " ", "\"\<conductor\>\"", ",", 
     " ", "\"\<coordinate_dimension\>\"", ",", 
     " ", "\"\<constraint_count\>\""}], "}"}]}], "\n", "]"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"129e2e11-91c3-4b16-b9e6-590b2c85214e"],

