Cell["\<\
For MSG {164,87}, initialize a double-valued spinor model and print \
corepresentations at Gamma, K, and A:\
\>", "ExampleText",ExpressionUUID->"1e1f2761-3cb3-4aec-bff8-ff4b6625a164"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<MSGCorep`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"corepOperations", " ", "=", " ", 
   RowBox[{"getMSGElemFromMSGCorep", "[", 
    RowBox[{"{", 
     RowBox[{"164", ",", " ", "87"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"-", "a"}], ",", " ", "0"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"a", "/", "2"}]}], ",", " ", 
         RowBox[{"a", "/", "2"}], ",", " ", "0"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "c"}], "}"}]}], "\n", "  ", 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"c", " ", "->", " ", "2"}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "}"}]}],
     ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", "corepOperations"}], ",", "\n",
     "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"\"\<sup\>\"", ",", " ", "\"\<sdn\>\""}], "}"}], "}"}]}], ",", 
    "\n", "  ", 
    RowBox[{"InitialBondShells", " ", "->", " ", "1"}], ",", "\n", "  ", 
    RowBox[{"GenerateSymmetryGroup", " ", "->", " ", "False"}]}], "\n", "]"}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"corepHamiltonian", " ", "=", " ", 
   RowBox[{"symham", "[", "1", "]"}]}], ";"}], "\n", 
 RowBox[{"getTBBandCorep", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"164", ",", " ", "87"}], "}"}], ",", " ", "corepHamiltonian", ",",
    " ", 
   RowBox[{"{", 
    RowBox[{"e1", " ", "->", " ", "0"}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", "3"}], ",", " ", 
       RowBox[{"1", "/", "3"}], ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}]}], "\n", "]"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"a33fb398-399d-4634-b9ac-04d095d137fd"]
}, Open  ]],

