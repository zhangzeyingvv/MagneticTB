Cell["\<\
The same nontrivial group with one scalar s orbital follows the single-valued \
MSGCorep route:\
\>", "ExampleText",ExpressionUUID->"731c5e2a-638c-4280-a05d-a662dd612487"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<MSGCorep`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"corepOperations", " ", "=", " ", 
   RowBox[{"getMSGElemFromMSGCorep", "[", 
    RowBox[{"{", 
     RowBox[{"164", ",", " ", "87"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"-", "a"}], ",", " ", "0"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"a", "/", "2"}]}], ",", " ", 
         RowBox[{"a", "/", "2"}], ",", " ", "0"}], "}"}], ",", "\n", "    ", 
