        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], "}"}], "}"}]}],
     ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", 
     RowBox[{"msgop", "[", 
      RowBox[{"bnsdict", "[", 
       RowBox[{"{", 
        RowBox[{"75", ",", " ", "1"}], "}"}], "]"}], "]"}]}], ",", "\n", "  ", 
