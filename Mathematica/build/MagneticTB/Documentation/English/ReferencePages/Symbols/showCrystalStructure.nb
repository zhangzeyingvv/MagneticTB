      RowBox[{"bnsdict", "[", 
       RowBox[{"{", 
        RowBox[{"75", ",", " ", "1"}], "}"}], "]"}], "]"}]}], ",", "\n", "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", "\"\<s\>\"", "}"}], "}"}]}]}], "\n", "]"}], ";"}], "\n", 
