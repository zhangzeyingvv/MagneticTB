Cell["\<\
Initialize graphene and display the matrices of four operations that generate \
its complete symmetry group:\
\>", "ExampleText",ExpressionUUID->"4bf05d81-bf36-4343-81e6-d29204d2338a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"grapheneOperations", " ", "=", " ", 
   RowBox[{"msgop", "[", 
    RowBox[{"gray", "[", "191", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "0", ",", " ", "0"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"a", "/", "2"}]}], ",", " ", "0"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "c"}], "}"}]}], "\n", "  ", 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"c", " ", "->", " ", "3"}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "3"}], ",", " ", 
          RowBox[{"2", "/", "3"}], ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "\n", 
      "  ", "}"}]}], ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", "grapheneOperations"}], ",", 
    "\n", "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", "\"\<pz\>\"", "}"}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"InitialBondShells", " ", "->", " ", "3"}], ",", "\n", "  ", 
    RowBox[{"GenerateSymmetryGroup", " ", "->", " ", "False"}]}], "\n", "]"}],
   ";"}], "\n", 
 RowBox[{"showSymmetryRepresentations", "[", "]"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"b9216d6f-2472-41ff-b853-c7d3e596cf86"],

