Cell["Initialize a complete model before inspecting it:", "ExampleText",ExpressionUUID->"a160b377-a556-4344-bbe6-a8ef60d297cf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"grapheneOperations", " ", "=", " ", 
   RowBox[{"msgop", "[", 
    RowBox[{"gray", "[", "191", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "0", ",", " ", "0"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"a", "/", "2"}]}], ",", " ", "0"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "c"}], "}"}]}], "\n", "  ", 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"c", " ", "->", " ", "3"}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "3"}], ",", " ", 
          RowBox[{"2", "/", "3"}], ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "\n", 
      "  ", "}"}]}], ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", "grapheneOperations"}], ",", 
    "\n", "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", "\"\<pz\>\"", "}"}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"InitialBondShells", " ", "->", " ", "3"}], ",", "\n", "  ", 
    RowBox[{"GenerateSymmetryGroup", " ", "->", " ", "False"}]}], "\n", "]"}],
   ";"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"8b653be7-daa1-44a1-9d3d-086b1dfb4626"],

Cell["\<\
Read the representation mode, generated site orbits, local bases, and \
available shell numbers of the graphene model. Merely viewing them does not \
calculate another Hamiltonian:\
\>", "ExampleText",ExpressionUUID->"4bc374dd-e19e-4d11-af99-7d1d908f36cb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"session", " ", "=", " ", 
   RowBox[{"CurrentModelSession", "[", "]"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"List", " ", "@@@", " ", 
    RowBox[{"Normal", "@", 
     RowBox[{"<|", "\n", "  ", 
      RowBox[{
       RowBox[{"\"\<RepresentationSource\>\"", " ", "->", " ", 
        RowBox[{"session", "[", "\"\<RepresentationSource\>\"", "]"}]}], ",", 
       "\n", "  ", 
       RowBox[{"\"\<RepresentationMode\>\"", " ", "->", " ", 
        RowBox[{"session", "[", "\"\<RepresentationMode\>\"", "]"}]}], ",", 
       "\n", "  ", 
       RowBox[{"\"\<SiteOrbits\>\"", " ", "->", " ", 
        RowBox[{"session", "[", 
         RowBox[{"\"\<ModelSpecification\>\"", ",", 
          " ", "\"\<SiteOrbits\>\""}], "]"}]}], ",", "\n", "  ", 
       RowBox[{"\"\<LocalBases\>\"", " ", "->", " ", 
        RowBox[{"session", "[", 
         RowBox[{"\"\<ModelSpecification\>\"", ",", 
          " ", "\"\<LocalBases\>\""}], "]"}]}], ",", "\n", "  ", 
       RowBox[{"\"\<PreparedBondShells\>\"", " ", "->", "\n", "    ", 
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"session", "[", "\"\<CompiledBondShells\>\"", "]"}], ",", 
          " ", "\"\<Shell\>\""}], "]"}]}]}], "\n", "|>"}]}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[2]:=",ExpressionUUID->"1c4f0faa-0378-499b-8f33-8cf7079668e5"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"RepresentationSource\"\>", "\<\"BasisFunctions\"\>"},
    {"\<\"RepresentationMode\"\>", "\<\"DirectProduct\"\>"},
    {"\<\"SiteOrbits\"\>", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          FractionBox["1", "3"], ",", 
          FractionBox["2", "3"], ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
