          FractionBox["2", "3"], ",", 
          FractionBox["1", "3"], ",", "0"}], "}"}]}], "}"}], "}"}]},
    {"\<\"LocalBases\"\>", 
     RowBox[{"{", 
      RowBox[{"{", "z", "}"}], "}"}]},
    {"\<\"PreparedBondShells\"\>", 
