Cell["\<\
Primitive orthorhombic lattice (gray group 47): three unequal lattice \
constants give a rectangular box with edge lengths 2 Pi/a, 2 Pi/b, and 2 Pi/c:\
\>", "ExampleText",ExpressionUUID->"6b8d1f43-1236-48cc-8d44-bbbcbc970f36"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<MagneticTB`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "b", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "c"}], "}"}]}], "}"}]}], ",", 
    "\n", "  ", 
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"b", " ", "->", " ", 
        RowBox[{"3", "/", "2"}]}], ",", " ", 
       RowBox[{"c", " ", "->", " ", "2"}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "}"}]}],
     ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", 
     RowBox[{"msgop", "[", 
      RowBox[{"gray", "[", "47", "]"}], "]"}]}], ",", "\n", "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", "\"\<s\>\"", "}"}], "}"}]}]}], "\n", "]"}], ";"}], "\n", 
 RowBox[{"showBrillouinZone", "[", 
  RowBox[{"ImageSize", " ", "->", " ", "400"}], "]"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[3]:=",ExpressionUUID->"37482914-5f33-4246-b287-a6cd42c34fef"],

