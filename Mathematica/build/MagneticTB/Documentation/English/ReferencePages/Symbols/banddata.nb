Cell["\<\
Initialize graphene, construct its Hamiltonian and reciprocal-space path, and \
choose a portable temporary CSV file:\
\>", "ExampleText",ExpressionUUID->"c8965486-b9a9-4bf1-8a1a-c7787cda875a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<MagneticTB`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grapheneOperations", " ", "=", " ", 
   RowBox[{"msgop", "[", 
    RowBox[{"gray", "[", "191", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "0", ",", " ", "0"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"a", "/", "2"}]}], ",", " ", "0"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "c"}], "}"}]}], "\n", "  ", 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"c", " ", "->", " ", "3"}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "3"}], ",", " ", 
          RowBox[{"2", "/", "3"}], ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "\n", 
      "  ", "}"}]}], ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", "grapheneOperations"}], ",", 
    "\n", "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", "\"\<pz\>\"", "}"}], "}"}]}]}], "\n", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grapheneHamiltonian", " ", "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"symham", "[", "i", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"graphenePath", " ", "=", " ", 
   RowBox[{"{", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"1", "/", "2"}], ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<G\>\"", ",", " ", "\"\<M\>\""}], "}"}]}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"1", "/", "2"}], ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "3"}], ",", " ", 
           RowBox[{"1", "/", "3"}], ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<M\>\"", ",", " ", "\"\<K\>\""}], "}"}]}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "3"}], ",", " ", 
           RowBox[{"1", "/", "3"}], ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<K\>\"", ",", " ", "\"\<G\>\""}], "}"}]}], "}"}]}], "\n", 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grapheneBandFile", " ", "=", " ", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"$TemporaryDirectory", ",", " ", "\"\<graphene-band.csv\>\""}], 
     "}"}], "]"}]}], ";"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"0a5cd3d7-18c1-462a-821c-969c22ceeb0d"],

Cell["\<\
Export the sampled band energies. Each row of the CSV file is one momentum \
point and each column is one band:\
\>", "ExampleText",ExpressionUUID->"48389e47-a1c3-4d29-a499-c75303b8c8cb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"banddata", "[", 
   RowBox[{
   "graphenePath", ",", " ", "10", ",", " ", "grapheneHamiltonian", ",", " ", 
    
    RowBox[{"{", 
     RowBox[{
      RowBox[{"e1", " ", "->", " ", "0.05"}], ",", " ", 
      RowBox[{"r1", " ", "->", " ", "0.02"}], ",", " ", 
      RowBox[{"t1", " ", "->", " ", "0.5"}]}], "}"}], ",", " ", 
    "grapheneBandFile"}], "]"}], ";"}]], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[2]:=",ExpressionUUID->"098a36d8-43db-493d-b0e4-a8455d0667b3"],

Cell["Import the CSV file and plot the two graphene bands:", "ExampleText",ExpressionUUID->"27f7a574-07bd-4188-940a-a461e1125851"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"grapheneBandEnergies", " ", "=", " ", 
   RowBox[{"Import", "[", 
    RowBox[{"grapheneBandFile", ",", " ", "\"\<CSV\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListPlot", "[", 
  RowBox[{"Transpose", "[", "grapheneBandEnergies", "]"}], "]"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[3]:=",ExpressionUUID->"6140afd8-40cf-4205-b835-a0cdd7edd3b9"],

