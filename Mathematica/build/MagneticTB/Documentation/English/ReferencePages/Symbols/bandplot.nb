Cell["\<\
Initialize a one-orbital simple-cubic model and define a two-segment \
reciprocal-space path:\
\>", "ExampleText",ExpressionUUID->"fd10687f-3ca7-4e2f-a14e-25bf66279dcd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"cubicIdentity", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"\"\<E\>\"", ",", " ", 
      RowBox[{"IdentityMatrix", "[", "3", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", 
      " ", "\"\<F\>\""}], "}"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "}"}]}],
     ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", "cubicIdentity"}], ",", "\n", 
    "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", "\"\<s\>\"", "}"}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"InitialBondShells", " ", "->", " ", "1"}], ",", "\n", "  ", 
    RowBox[{"GenerateSymmetryGroup", " ", "->", " ", "False"}]}], "\n", "]"}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"plotHamiltonian", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", "kx", "]"}], " ", "+", " ", 
      RowBox[{"Cos", "[", "ky", "]"}], " ", "+", " ", 
      RowBox[{"Cos", "[", "kz", "]"}]}], "}"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"plotPath", " ", "=", " ", 
   RowBox[{"{", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"1", "/", "2"}], ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<G\>\"", ",", " ", "\"\<X\>\""}], "}"}]}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"1", "/", "2"}], ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "2"}], ",", " ", 
           RowBox[{"1", "/", "2"}], ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<X\>\"", ",", " ", "\"\<M\>\""}], "}"}]}], "}"}]}], "\n", 
    "}"}]}], ";"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"2b92e657-2cfb-47c8-86ff-672a107bae83"],

