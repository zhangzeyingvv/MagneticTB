Cell["\<\
gray is an Association whose integer keys run from 1 through 230.\
\>", "Notes",ExpressionUUID->"e0820f52-c6d5-4ada-9533-1d59b391de66"],

Cell["\<\
Pass the returned integer to msgop or showMSGWyckoff. It is a database \
identifier, not an operation list.\
\>", "Notes",ExpressionUUID->"57d2969c-ba9b-4161-b064-2f7e3b805801"]
}, Closed]],

