Cell["\<\
SameTest can provide a domain-specific exact equality predicate; here it \
reproduces the same C4 ordering:\
\>", "ExampleText",ExpressionUUID->"19b8b6a4-b5b5-49e4-bca8-95ab7f4f70bd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GenerateGroup", "[", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", " ", "0", ",", " ", 
   RowBox[{
    RowBox[{"Mod", "[", 
     RowBox[{
      RowBox[{"#1", " ", "+", " ", "#2"}], ",", " ", "4"}], "]"}], " ", "&"}],
    ",", " ", 
   RowBox[{"SameTest", " ", "->", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"#1", " ", "===", " ", "#2"}], " ", "&"}], ")"}]}]}], 
  "]"}]], "Input",
