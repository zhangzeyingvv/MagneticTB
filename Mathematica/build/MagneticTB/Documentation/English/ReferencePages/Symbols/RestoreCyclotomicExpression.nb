Cell["\<\
Compile a matrix containing the fourth root of unity and restore it as the \
ordinary exact expression I:\
\>", "ExampleText",ExpressionUUID->"cc2d20e3-d3b4-4428-8534-7a24fde098a1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"iRoot", " ", "=", " ", 
   RowBox[{"<|", "\n", "  ", 
    RowBox[{
     RowBox[{"\"\<kind\>\"", " ", "->", " ", "\"\<root_sum\>\""}], ",", "\n", 
     "  ", 
     RowBox[{"\"\<constant\>\"", " ", "->", " ", "0"}], ",", "\n", "  ", 
     RowBox[{"\"\<terms\>\"", " ", "->", " ", 
      RowBox[{"{", "\n", "    ", 
       RowBox[{"<|", "\n", "      ", 
        RowBox[{
         RowBox[{"\"\<coefficient\>\"", " ", "->", " ", "1"}], ",", "\n", 
         "      ", 
         RowBox[{"\"\<order\>\"", " ", "->", " ", "4"}], ",", "\n", "      ", 
         
         RowBox[{"\"\<power\>\"", " ", "->", " ", "1"}]}], "\n", "    ", 
        "|>"}], "\n", "  ", "}"}]}]}], "\n", "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"compiledCyclotomic", " ", "=", " ", 
   RowBox[{"CompileCyclotomicMatrices", "[", 
    RowBox[{"<|", "\n", "  ", 
     RowBox[{
      RowBox[{"\"\<coordinate_dimension\>\"", " ", "->", " ", "3"}], ",", 
      "\n", "  ", 
      RowBox[{"\"\<constraints\>\"", " ", "->", " ", 
       RowBox[{"{", "\n", "    ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "iRoot", ",", " ", "0"}], "}"}], "}"}], ",",
          "\n", "    ", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1", ",", " ", "0"}], "}"}], "}"}]}], "\n", 
        "  ", "}"}]}], ",", "\n", "  ", 
      RowBox[{"\"\<max_cyclotomic_degree\>\"", " ", "->", " ", "128"}]}], 
     "\n", "|>"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"restoredMatrix", " ", "=", " ", 
   RowBox[{"RestoreCyclotomicExpression", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"compiledCyclotomic", "[", "\"\<constraints\>\"", "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"MatrixForm", "@", 
  RowBox[{"Partition", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"restoredMatrix", "[", "\"\<entries\>\"", "]"}], ",", "\n", "  ", 
    
    RowBox[{"restoredMatrix", "[", "\"\<columns\>\"", "]"}]}], "\n", 
   "]"}]}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"51508c81-889a-46d8-b069-86438a2e66f0"],

