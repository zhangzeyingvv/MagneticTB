Cell["\<\
The two-argument form restores one element from its matching context. The \
second entry of this matrix is exactly I:\
\>", "ExampleText",ExpressionUUID->"5cdc2bf6-6abb-4bbb-b81e-6bc904d5e806"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"iRoot", " ", "=", " ", 
   RowBox[{"<|", "\n", "  ", 
    RowBox[{
     RowBox[{"\"\<kind\>\"", " ", "->", " ", "\"\<root_sum\>\""}], ",", "\n", 
     "  ", 
     RowBox[{"\"\<constant\>\"", " ", "->", " ", "0"}], ",", "\n", "  ", 
     RowBox[{"\"\<terms\>\"", " ", "->", " ", 
      RowBox[{"{", "\n", "    ", 
       RowBox[{"<|", "\n", "      ", 
        RowBox[{
         RowBox[{"\"\<coefficient\>\"", " ", "->", " ", "1"}], ",", "\n", 
         "      ", 
         RowBox[{"\"\<order\>\"", " ", "->", " ", "4"}], ",", "\n", "      ", 
         
         RowBox[{"\"\<power\>\"", " ", "->", " ", "1"}]}], "\n", "    ", 
        "|>"}], "\n", "  ", "}"}]}]}], "\n", "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"compiledCyclotomic", " ", "=", " ", 
   RowBox[{"CompileCyclotomicMatrices", "[", 
    RowBox[{"<|", "\n", "  ", 
     RowBox[{
      RowBox[{"\"\<coordinate_dimension\>\"", " ", "->", " ", "3"}], ",", 
      "\n", "  ", 
      RowBox[{"\"\<constraints\>\"", " ", "->", " ", 
       RowBox[{"{", "\n", "    ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "iRoot", ",", " ", "0"}], "}"}], "}"}], ",",
          "\n", "    ", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1", ",", " ", "0"}], "}"}], "}"}]}], "\n", 
        "  ", "}"}]}], ",", "\n", "  ", 
      RowBox[{"\"\<max_cyclotomic_degree\>\"", " ", "->", " ", "128"}]}], 
     "\n", "|>"}], "]"}]}], ";"}], "\n", 
 RowBox[{"RestoreCyclotomicExpression", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"compiledCyclotomic", "[", "\"\<context\>\"", "]"}], ",", "\n", 
   "  ", 
   RowBox[{
    RowBox[{"compiledCyclotomic", "[", "\"\<constraints\>\"", "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", " ", "\"\<entries\>\"", ",", " ", "2"}], "]"}], 
    "]"}]}], "\n", "]"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"4f625418-6ce0-4899-9b34-e63348996aca"],

Cell[BoxData["\[ImaginaryI]"], "Output",
 CellLabel->"Out[2]=",ExpressionUUID->"181465a8-13eb-4674-968d-c0a447908ef9"]
}, Open  ]]
}, Closed]],

