Cell["\<\
Restore a complete kernel result, then display its row-basis and column-basis \
matrices:\
\>", "ExampleText",ExpressionUUID->"b2ed3ac4-7eb5-4d37-88fa-d7a4a4c93fb8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"compiledRational", " ", "=", " ", 
   RowBox[{"CompileCyclotomicMatrices", "[", 
    RowBox[{"<|", "\n", "  ", 
     RowBox[{
      RowBox[{"\"\<coordinate_dimension\>\"", " ", "->", " ", "3"}], ",", 
      "\n", "  ", 
      RowBox[{"\"\<constraints\>\"", " ", "->", " ", 
       RowBox[{"{", "\n", "    ", 
        RowBox[{"{", "\n", "      ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", "\n", 
          "      ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "4", ",", " ", "6"}], "}"}]}], "\n", "    ",
          "}"}], "\n", "  ", "}"}]}]}], "\n", "|>"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exactRationalMatrix", " ", "=", " ", 
   RowBox[{
    RowBox[{"compiledRational", "[", "\"\<constraints\>\"", "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kernelResult", " ", "=", " ", 
   RowBox[{"CyclotomicNullSpace", "[", "exactRationalMatrix", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"restoredKernel", " ", "=", " ", 
   RowBox[{"RestoreCyclotomicExpression", "[", "kernelResult", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", "\n", "  ", 
  RowBox[{
   RowBox[{"MatrixForm", "@", 
    RowBox[{"Partition", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"restoredKernel", "[", 
       RowBox[{"\"\<nullspace_rows\>\"", ",", " ", "\"\<entries\>\""}], "]"}],
       ",", "\n", "    ", 
      RowBox[{"restoredKernel", "[", 
       RowBox[{"\"\<nullspace_rows\>\"", ",", " ", "\"\<columns\>\""}], 
       "]"}]}], "\n", "  ", "]"}]}], ",", "\n", "  ", 
   RowBox[{"MatrixForm", "@", 
    RowBox[{"Partition", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"restoredKernel", "[", 
       RowBox[{"\"\<basis_matrix\>\"", ",", " ", "\"\<entries\>\""}], "]"}], ",",
       "\n", "    ", 
      RowBox[{"restoredKernel", "[", 
       RowBox[{"\"\<basis_matrix\>\"", ",", " ", "\"\<columns\>\""}], "]"}]}],
      "\n", "  ", "]"}]}]}], "\n", "}"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"903ff74f-327c-48b6-8bfe-00b8a0d64dd8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TagBox[
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {
        RowBox[{"-", "2"}], "1", "0"},
       {
