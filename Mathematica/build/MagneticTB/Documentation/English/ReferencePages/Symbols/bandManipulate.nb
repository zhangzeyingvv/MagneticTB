Cell["\<\
Open the live interactive panel along the explicit G-M-K-G path. Its three \
sliders are the onsite, nearest-neighbour, and next-nearest-neighbour \
amplitudes; no hidden energy shift is added:\
\>", "ExampleText",ExpressionUUID->"27b6ba51-f3da-4868-a06c-0576143b3f77"],

Cell[BoxData[
 RowBox[{"bandManipulate", "[", 
  RowBox[{"graphenePath", ",", " ", "30", ",", " ", "grapheneHamiltonian"}], 
  "]"}]], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[4]:=",ExpressionUUID->"8ad5a691-af3b-47e7-94c3-418273cc9ef6"],

