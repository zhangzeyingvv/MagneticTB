Cell["\<\
Initialize graphene and construct the Hamiltonian before plotting:\
\>", "ExampleText",ExpressionUUID->"1a1930e7-5af9-4b4a-8e52-a1e0d4cde3dc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<MagneticTB`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grapheneOperations", " ", "=", " ", 
   RowBox[{"msgop", "[", 
    RowBox[{"gray", "[", "191", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "0", ",", " ", "0"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"a", "/", "2"}]}], ",", " ", "0"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "c"}], "}"}]}], "\n", "  ", 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"c", " ", "->", " ", "3"}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "3"}], ",", " ", 
          RowBox[{"2", "/", "3"}], ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "\n", 
      "  ", "}"}]}], ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", "grapheneOperations"}], ",", 
    "\n", "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", "\"\<pz\>\"", "}"}], "}"}]}]}], "\n", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grapheneOnsite", " ", "=", " ", 
   RowBox[{"symham", "[", "1", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grapheneNearest", " ", "=", " ", 
   RowBox[{"symham", "[", "2", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grapheneNextNearest", " ", "=", " ", 
   RowBox[{"symham", "[", "3", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grapheneHamiltonian", " ", "=", "\n", "  ", 
   RowBox[{
   "grapheneOnsite", " ", "+", " ", "grapheneNearest", " ", "+", " ", 
    "grapheneNextNearest"}]}], ";"}], "\n", 
 RowBox[{"MatrixForm", "[", "\n", "  ", 
  RowBox[{"FullSimplify", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"ExpToTrig", "[", "grapheneHamiltonian", "]"}], ",", "\n", "    ", 
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"kx", ",", " ", "ky", ",", " ", "kz"}], "}"}], ",", " ", 
      "Reals"}], "]"}]}], "\n", "  ", "]"}], "\n", "]"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"b934bc2b-9f52-499a-b74e-0927ef272d6b"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{"e1", "+", 
       RowBox[{"2", " ", "r1", " ", 
        RowBox[{"(", 
