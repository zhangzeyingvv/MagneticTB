Cell["\<\
Full column rank gives a zero-dimensional null space. The basis matrix \
retains the exact 2 by 0 shape even though it has no entries:\
\>", "ExampleText",ExpressionUUID->"5712de57-a43d-469f-91f3-9fe52b84dabc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fullRankCompiled", " ", "=", " ", 
   RowBox[{"CompileCyclotomicMatrices", "[", 
    RowBox[{"<|", "\n", "  ", 
     RowBox[{
      RowBox[{"\"\<coordinate_dimension\>\"", " ", "->", " ", "2"}], ",", 
      "\n", "  ", 
      RowBox[{"\"\<constraints\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"IdentityMatrix", "[", "2", "]"}], "}"}]}]}], "\n", "|>"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fullRankKernel", " ", "=", " ", 
   RowBox[{"CyclotomicNullSpace", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"fullRankCompiled", "[", "\"\<constraints\>\"", "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"{", "\n", "  ", 
  RowBox[{
