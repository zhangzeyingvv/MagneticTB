Cell["\<\
For this rank-one matrix, the two row-basis vectors are {-2,1,0} and \
{-3,0,1}. Their transpose is the column-basis matrix annihilated by the input:\
\>", "ExampleText",ExpressionUUID->"711c16f2-1009-4a46-af51-ff1c31264a05"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"compiledRational", " ", "=", " ", 
   RowBox[{"CompileCyclotomicMatrices", "[", 
    RowBox[{"<|", "\n", "  ", 
     RowBox[{
      RowBox[{"\"\<coordinate_dimension\>\"", " ", "->", " ", "3"}], ",", 
      "\n", "  ", 
      RowBox[{"\"\<constraints\>\"", " ", "->", " ", 
       RowBox[{"{", "\n", "    ", 
        RowBox[{"{", "\n", "      ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", "\n", 
          "      ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "4", ",", " ", "6"}], "}"}]}], "\n", "    ",
          "}"}], "\n", "  ", "}"}]}]}], "\n", "|>"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exactRationalMatrix", " ", "=", " ", 
   RowBox[{
    RowBox[{"compiledRational", "[", "\"\<constraints\>\"", "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kernelResult", " ", "=", " ", 
   RowBox[{"CyclotomicNullSpace", "[", "exactRationalMatrix", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"restoredRows", " ", "=", " ", 
   RowBox[{"RestoreCyclotomicExpression", "[", "\n", "  ", 
    RowBox[{"kernelResult", "[", "\"\<nullspace_rows\>\"", "]"}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"restoredBasis", " ", "=", " ", 
   RowBox[{"RestoreCyclotomicExpression", "[", "\n", "  ", 
    RowBox[{"kernelResult", "[", "\"\<basis_matrix\>\"", "]"}], "\n", "]"}]}],
   ";"}], "\n", 
 RowBox[{"{", "\n", "  ", 
  RowBox[{
   RowBox[{"MatrixForm", "@", 
    RowBox[{"Partition", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"restoredRows", "[", "\"\<entries\>\"", "]"}], ",", " ", 
      RowBox[{"restoredRows", "[", "\"\<columns\>\"", "]"}]}], "\n", "  ", 
     "]"}]}], ",", "\n", "  ", 
   RowBox[{"MatrixForm", "@", 
    RowBox[{"Partition", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"restoredBasis", "[", "\"\<entries\>\"", "]"}], ",", " ", 
      RowBox[{"restoredBasis", "[", "\"\<columns\>\"", "]"}]}], "\n", "  ", 
     "]"}]}], ",", "\n", "  ", 
   RowBox[{"KeyTake", "[", "\n", "    ", 
    RowBox[{"kernelResult", ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"\"\<pivot_columns\>\"", ",", " ", "\"\<free_columns\>\"", ",", 
       " ", "\"\<rank\>\"", ",", " ", "\"\<nullity\>\"", ",", "\n", 
       "      ", "\"\<exact_residual_verified\>\""}], "}"}]}], "\n", "  ", 
    "]"}]}], "\n", "}"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"47b3473a-5669-4aee-8540-a2e4505db42d"],

