Cell["\<\
The full unitary tetragonal C4 point group from gray group 75 acts on the \
ordered {px,py} basis as follows:\
\>", "ExampleText",ExpressionUUID->"852677c0-1f26-4c22-b778-c0bfc6b8bb56"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pointOperations", " ", "=", " ", 
   RowBox[{"Select", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"msgop", "[", 
      RowBox[{"gray", "[", "75", "]"}], "]"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"Last", "[", "#", "]"}], " ", "===", " ", "\"\<F\>\""}], " ", 
      "&"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"MatrixForm", " ", "/@", " ", 
  RowBox[{"pointMatrix", "[", "\n", "  ", 
