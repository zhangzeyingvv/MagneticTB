Cell["\<\
Solve the nearest-neighbor shell of a one-orbital cubic model and read its \
numerical real-space blocks from the cache:\
\>", "ExampleText",ExpressionUUID->"0bbc2fca-75aa-4f0f-8764-edb1c1461ba7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"cubicOperations", " ", "=", " ", 
   RowBox[{"msgop", "[", 
    RowBox[{"gray", "[", "221", "]"}], "]"}]}], ";"}], "\n", 
