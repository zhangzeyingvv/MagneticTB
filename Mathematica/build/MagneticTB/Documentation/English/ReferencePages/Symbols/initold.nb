Cell["\<\
Use initold to run notebooks written for the original MagneticTB, or to \
compare the original and current constructions.\
\>", "Notes",ExpressionUUID->"c1b2aa65-0559-4905-8f61-d3ded91cde50"],

Cell["\<\
Its physical inputs are the original lattice, Wyckoff, symmetry, and \
basis-function options, renamed with the suffix old so that they cannot be \
confused with the new interface.\
\>", "Notes",ExpressionUUID->"0eb114a5-ba06-4a16-8db7-d273c5bd864b"],

Cell["\<\
MagneticTBOld` and MagneticTB` do not load or call one another. Evaluate them \
in separate fresh Wolfram kernels when comparing results.\
\>", "Notes",ExpressionUUID->"bc16e0df-5f9f-427e-a41a-30f065155abb"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "e993f7de-478a-40cb-bc32-bbc9dd2db04f"], "latticeold", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"aold", ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "aold"}], "/", "2"}], ",", 
        RowBox[{
         RowBox[{"Sqrt", "[", "3", "]"}], " ", 
         RowBox[{"aold", "/", "2"}]}], ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "cold"}], "}"}]}], "}"}], Cell["\<\
Primitive direct-lattice vectors used by the original version, stored by rows.\
\>", "TableText",ExpressionUUID->"0bd6cc29-ae69-44d5-8705-f3e1c351427e"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
