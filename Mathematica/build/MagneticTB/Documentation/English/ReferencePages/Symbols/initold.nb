        RowBox[{"0", ",", "0", ",", 
         RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}], "}"}], Cell["\<\
Fractional Wyckoff seeds and magnetic moments used by the original version.\
\>", "TableText",ExpressionUUID->"0ac8f9a2-c67c-4b19-8251-d6c065541a2f"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
