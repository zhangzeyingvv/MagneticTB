Cell["\<\
A spinful induced example uses the complete magnetic group P6'/m'mm' (BNS \
191.239). One exact in-plane spinor on the reference kagome site generates \
the other two local states.  The first three neighbour-hopping layers \
reproduce the three-band quadratic-nodal-point model of Feng et al., Phys. \
Rev. B 109, 045423 (2024).  In MagneticTB's basis and directed-bond \
convention, the paper parameters map to the three rules shown in bandplot:\
\>", "ExampleText",ExpressionUUID->"63b24e90-8d18-43d1-ae8f-b5537bc37e1a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"kagomeOperations", " ", "=", " ", 
   RowBox[{"msgop", "[", 
    RowBox[{"typeIII", "[", 
     RowBox[{"{", 
      RowBox[{"191", ",", " ", "239"}], "}"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "0", ",", " ", "0"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"a", "/", "2"}]}], ",", " ", "0"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "c"}], "}"}]}], "\n", "  ", 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"c", " ", "->", " ", "8"}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "2"}], ",", " ", "0", ",", " ", "0"}], "}"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "\n", 
      "  ", "}"}]}], ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", "kagomeOperations"}], ",", 
    "\n", "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], "/", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], "}"}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"RepresentationMode", " ", "->", " ", "\"\<Induced\>\""}], ",", 
    "\n", "  ", 
    RowBox[{"InitialBondShells", " ", "->", " ", "3"}]}], "\n", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"kagomeHamiltonian", " ", "=", " ", 
   RowBox[{"Total", "[", 
    RowBox[{"symham", " ", "/@", " ", 
     RowBox[{"Range", "[", "3", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kagomePath", " ", "=", " ", 
   RowBox[{"{", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"1", "/", "2"}], ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<M\>\"", ",", " ", "\"\<G\>\""}], "}"}]}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "3"}], ",", " ", 
           RowBox[{"1", "/", "3"}], ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<G\>\"", ",", " ", "\"\<K\>\""}], "}"}]}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "3"}], ",", " ", 
           RowBox[{"1", "/", "3"}], ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"1", "/", "2"}], ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<K\>\"", ",", " ", "\"\<M\>\""}], "}"}]}], "}"}]}], "\n", 
    "}"}]}], ";"}], "\n", 
 RowBox[{"bandplot", "[", "\n", "  ", 
  RowBox[{
  "kagomePath", ",", "\n", "  ", "80", ",", "\n", "  ", "kagomeHamiltonian", ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"e1", " ", "->", " ", 
      RowBox[{"-", "0.15"}]}], ",", " ", 
     RowBox[{"t1", " ", "->", " ", 
      RowBox[{
       RowBox[{"-", "0.155"}], "/", "2"}]}], ",", " ", 
     RowBox[{"r1", " ", "->", " ", 
      RowBox[{"0.23", "/", "2"}]}]}], "}"}]}], "\n", "]"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[5]:=",ExpressionUUID->"d338c2c0-bdbf-4044-afeb-1a46c1cb933e"],

