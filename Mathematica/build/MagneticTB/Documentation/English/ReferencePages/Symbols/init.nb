Cell["\<\
For the same cubic Wyckoff orbit, RepresentationMode -> \"Induced\" needs \
only the reference px orbital at {1/2, 0, 0}. Cubic symmetry transports it to \
the corresponding py and pz states at the other equivalent sites, as the \
orbital table shows:\
\>", "ExampleText",ExpressionUUID->"38721828-4384-49e7-a247-43d8ff11660a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"cubicOperations", " ", "=", " ", 
   RowBox[{"msgop", "[", 
    RowBox[{"gray", "[", "221", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "0", ",", " ", "0"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "a", ",", " ", "0"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "a"}], "}"}]}], "\n", "  ", 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"a", " ", "->", " ", "1"}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "2"}], ",", " ", "0", ",", " ", "0"}], "}"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "\n", 
      "  ", "}"}]}], ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", "cubicOperations"}], ",", "\n",
     "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", "\"\<px\>\"", "}"}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"RepresentationMode", " ", "->", " ", "\"\<Induced\>\""}]}], "\n",
    "]"}], ";"}], "\n", 
 RowBox[{"orbitalTable", "[", "]"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[3]:=",ExpressionUUID->"77e560ba-f74b-4fc6-8233-81c869c8e366"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{
      "\"Hamiltonian dimension = \"", "3", "\"; representation mode = \"", 
       "\"Induced\""},
      "RowDefault"], "\[SpanFromLeft]", "\[SpanFromLeft]", "\[SpanFromLeft]", 
     "\[SpanFromLeft]", "\[SpanFromLeft]", "\[SpanFromLeft]", 
     "\[SpanFromLeft]", "\[SpanFromLeft]", "\[SpanFromLeft]", 
