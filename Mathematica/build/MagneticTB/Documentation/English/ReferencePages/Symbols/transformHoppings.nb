Cell["Build the tetragonal gray-group 75 hopping model used below:", \
"ExampleText",ExpressionUUID->"63f56fc3-3fdb-4a5b-936f-138137b8d2ca"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"chainOperations", " ", "=", " ", 
   RowBox[{"msgop", "[", 
    RowBox[{"gray", "[", "75", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "a", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "c"}], "}"}]}], "}"}]}], ",", "\n", "  ", 
    
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", "3"}], ",", 
       RowBox[{"c", " ", "->", " ", "1"}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}], "}"}]}], ",", 
    "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", "chainOperations"}], ",", "\n",
     "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", "\"\<s\>\"", "}"}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"InitialBondShells", " ", "->", " ", "2"}], ",", "\n", "  ", 
    RowBox[{"GenerateSymmetryGroup", " ", "->", " ", "False"}]}], "\n", "]"}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"chainHamiltonian", " ", "=", " ", 
   RowBox[{
    RowBox[{"symham", "[", "1", "]"}], " ", "+", " ", 
    RowBox[{"symham", "[", "2", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"chainData", " ", "=", " ", 
   RowBox[{"hoppingData", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"e1", " ", "->", " ", "0."}], ",", " ", 
       RowBox[{"t1", " ", "->", " ", "1."}]}], "}"}]}], "\n", "]"}]}], 
  ";"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"99b30ea3-7934-4dd6-b220-abddb7830153"],

Cell["\<\
Double the chain cell along axis 3. The transformed model contains two \
orbitals per new cell:\
\>", "ExampleText",ExpressionUUID->"0b7fc660-3741-44aa-a2c9-613f36548bf2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"transformed", " ", "=", " ", 
   RowBox[{"transformHoppings", "[", 
    RowBox[{"chainData", ",", " ", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1", ",", " ", "2"}], "}"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"KeyTake", "[", 
  RowBox[{"transformed", ",", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<NumWannier\>\"", ",", " ", "\"\<CellVolumeFactor\>\"", ",", 
     " ", "\"\<Lattice\>\"", ",", " ", "\"\<WannierCenters\>\""}], "}"}]}], 
  "]"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[2]:=",ExpressionUUID->"e867acf3-ad83-408e-bdf1-27b5974047a0"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"NumWannier\"\>", "\[Rule]", "2"}], ",", 
   RowBox[{"\<\"CellVolumeFactor\"\>", "\[Rule]", "2"}], ",", 
   RowBox[{"\<\"Lattice\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"3", ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "3", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "2"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"WannierCenters\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", 
        FractionBox["1", "2"]}], "}"}]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[3]=",ExpressionUUID->"2018fa2c-7d22-4c43-889a-5252f106e3ba"]
}, Open  ]]
}, Open  ]],

