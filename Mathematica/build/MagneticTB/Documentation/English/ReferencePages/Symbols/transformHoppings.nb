Cell["\<\
T must be a nonsingular 3 by 3 integer matrix. Exact Smith decomposition \
enumerates all cell representatives; no real-space cutoff is introduced.\
\>", "Notes",ExpressionUUID->"f80fff2c-8ca9-4d2e-8a14-17784f90fbc3"],

Cell["\<\
The returned Association has Abs[Det[T]] times the original orbital dimension \
and, when available, transformed lattice vectors and Wannier centers.\
\>", "Notes",ExpressionUUID->"ceb3a280-7a6b-4e06-952e-3de844134948"],

Cell["\<\
transformHoppings returns $Failed and issues a message when the hopping \
Association/path is incomplete, T is not a nonsingular integer matrix, \
center/lattice metadata are malformed, or the Hermiticity residual exceeds \
the requested tolerance. It does not repair the input or switch to an \
approximate fallback.\
\>", "Notes",ExpressionUUID->"a3010c46-6f60-4661-b06e-4b6bae503baf"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "7f25f532-3a87-4c30-b895-52476e27e28a"], "\"\<WannierCenters\>\"", 
    "Automatic", Cell["\<\
Automatic uses centers stored in data; None omits them; an explicit list \
supplies one fractional three-vector per input orbital.\
\>", "TableText",ExpressionUUID->"e037d5df-7492-405f-be42-8d5201af2677"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "7559e747-9580-4c12-a0d1-bd4569c1e84e"], "\"\<Lattice\>\"", "Automatic", 
    Cell["\<\
Automatic uses the stored row-vector lattice; None omits it; an explicit real \
numerical 3 by 3 matrix replaces it.\
\>", "TableText",ExpressionUUID->"06b3c548-ca8b-4cba-b71d-ef6ddb90d8db"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "a8aa3f94-da31-4d5b-b91e-4f01bc202453"], "\"\<HermiticityTolerance\>\"", 
    
    RowBox[{"10", "^", 
     RowBox[{"-", "9"}]}], Cell["\<\
Nonnegative numerical tolerance for H(R)=H(-R)^dagger before the exact cell \
transform.\
\>", "TableText",ExpressionUUID->"8fa7ac96-ae2f-4faa-9ae1-ec5e1e264b3d"]}
  },
