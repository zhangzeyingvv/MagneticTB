Cell["\<\
The first constraint removes the first coordinate and the second removes the \
second. Their common kernel is therefore spanned by {0,0,1}:\
\>", "ExampleText",ExpressionUUID->"863b19d6-d6ca-4acd-a8db-1e75494053b2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"compiledCommon", " ", "=", " ", 
   RowBox[{"CompileCyclotomicMatrices", "[", 
    RowBox[{"<|", "\n", "  ", 
     RowBox[{
      RowBox[{"\"\<coordinate_dimension\>\"", " ", "->", " ", "3"}], ",", 
      "\n", "  ", 
      RowBox[{"\"\<constraints\>\"", " ", "->", " ", 
       RowBox[{"{", "\n", "    ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}], "}"}], ",", 
         "\n", "    ", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1", ",", " ", "0"}], "}"}], "}"}]}], "\n", 
        "  ", "}"}]}]}], "\n", "|>"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"commonResult", " ", "=", " ", 
   RowBox[{"CyclotomicCommonKernel", "[", "compiledCommon", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"commonRows", " ", "=", " ", 
   RowBox[{"RestoreCyclotomicExpression", "[", "\n", "  ", 
    RowBox[{"commonResult", "[", "\"\<nullspace_rows\>\"", "]"}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"commonBasis", " ", "=", " ", 
   RowBox[{"RestoreCyclotomicExpression", "[", "\n", "  ", 
    RowBox[{"commonResult", "[", "\"\<basis_matrix\>\"", "]"}], "\n", "]"}]}],
   ";"}], "\n", 
 RowBox[{"{", "\n", "  ", 
  RowBox[{
   RowBox[{"MatrixForm", "@", 
    RowBox[{"Partition", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"commonRows", "[", "\"\<entries\>\"", "]"}], ",", " ", 
      RowBox[{"commonRows", "[", "\"\<columns\>\"", "]"}]}], "\n", "  ", 
     "]"}]}], ",", "\n", "  ", 
   RowBox[{"MatrixForm", "@", 
    RowBox[{"Partition", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"commonBasis", "[", "\"\<entries\>\"", "]"}], ",", " ", 
      RowBox[{"commonBasis", "[", "\"\<columns\>\"", "]"}]}], "\n", "  ", 
     "]"}]}], ",", "\n", "  ", 
   RowBox[{"KeyTake", "[", "\n", "    ", 
    RowBox[{"commonResult", ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"\"\<iteration_nullities\>\"", ",", " ", "\"\<rank\>\"", ",", 
       " ", "\"\<nullity\>\"", ",", "\n", 
       "      ", "\"\<exact_residual_verified\>\""}], "}"}]}], "\n", "  ", 
    "]"}]}], "\n", "}"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"616c5352-e1a2-487b-a9bb-ffb1e85058b3"],

