Cell["\<\
Here is a complete simple-cubic model in this input form. The output shows \
the lattice, generated sites, exact representation matrices, and first bond \
class:\
\>", "ExampleText",ExpressionUUID->"ce0ccbdd-6319-4d70-9a67-ab6fe6079464"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"compilerInput", " ", "=", " ", 
   RowBox[{"<|", "\n", "  ", 
    RowBox[{
     RowBox[{"\"\<Lattice\>\"", " ", "->", " ", 
      RowBox[{"{", "\n", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "0", ",", " ", "0"}], "}"}], ",", "\n", 
        "    ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "a", ",", " ", "0"}], "}"}], ",", "\n", 
        "    ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "a"}], "}"}]}], "\n", "  ", 
       "}"}]}], ",", "\n", "  ", 
     RowBox[{"\"\<LatticeParameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "->", " ", "1"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"\"\<WyckoffPosition\>\"", " ", "->", " ", 
      RowBox[{"{", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "\n", 
       "  ", "}"}]}], ",", "\n", "  ", 
     RowBox[{"\"\<SymmetryInformation\>\"", " ", "->", " ", 
      RowBox[{"{", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"\"\<E\>\"", ",", " ", 
         RowBox[{"IdentityMatrix", "[", "3", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", 
         " ", "\"\<F\>\""}], "}"}], "\n", "  ", "}"}]}], ",", "\n", "  ", 
     RowBox[{"\"\<BasisFunctions\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"{", "\"\<s\>\"", "}"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"\"\<Debug\>\"", " ", "->", " ", "False"}], ",", "\n", "  ", 
     RowBox[{"\"\<InitialBondShells\>\"", " ", "->", " ", "2"}], ",", "\n", 
     "  ", 
     RowBox[{"\"\<GenerateSymmetryGroup\>\"", " ", "->", " ", "False"}], ",", 
     "\n", "  ", 
     RowBox[{"\"\<RepresentationMode\>\"", " ", "->", 
      " ", "\"\<DirectProduct\>\""}], ",", "\n", "  ", 
     RowBox[{"\"\<SiteLocalData\>\"", " ", "->", " ", "Automatic"}]}], "\n", 
    "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"compiledModel", " ", "=", " ", 
   RowBox[{"CompileMagneticTBInput", "[", "compilerInput", "]"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"List", " ", "@@@", " ", 
    RowBox[{"Normal", "@", 
     RowBox[{"<|", "\n", "  ", 
      RowBox[{
       RowBox[{"\"\<Lattice\>\"", " ", "->", " ", 
