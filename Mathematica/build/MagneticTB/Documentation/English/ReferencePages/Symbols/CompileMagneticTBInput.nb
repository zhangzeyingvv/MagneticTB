Cell["\<\
All physical inputs must be present. For example, a lattice by itself does \
not define a model:\
\>", "ExampleText",ExpressionUUID->"b1361129-c998-4afe-973c-b96de0863af7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CompileMagneticTBInput", "[", 
  RowBox[{"<|", 
   RowBox[{"\"\<Lattice\>\"", " ", "->", " ", 
    RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "|>"}], "]"}]], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellTags->"ExpectedMessage:CompileMagneticTBInput::input",
 CellLabel->"In[1]:=",ExpressionUUID->"253ba8f8-f96f-461b-a99c-c2fc0d5567c9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CompileMagneticTBInput", "::", 
   RowBox[{"input", ":", " ", 
    RowBox[{
     RowBox[{
     "The", " ", "init", " ", "options", " ", "are", " ", "incomplete", " ", 
      "or", " ", "mutually", " ", 
      RowBox[{"incompatible", ".", " ", "symminformation"}], " ", "must", " ",
       "be", " ", "either", " ", "traditional", " ", 
      RowBox[{"{", 
       RowBox[{"label", ",", "R", ",", "t", ",", 
        RowBox[{"F", "|", "T"}]}], "}"}], " ", "records", " ", "or", " ", "a",
       " ", "discrete", " ", "spin"}], "-", "space", "-", 
     RowBox[{"group", " ", "label"}]}]}]}], "->", 
  RowBox[{
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"space", "->", 
      RowBox[{"{", 
       RowBox[{"R", ",", "t"}], "}"}]}], ",", 
     RowBox[{"spin", "->", 
      RowBox[{"{", 
       RowBox[{"S", ",", 
        RowBox[{"0", "|", "1"}]}], "}"}]}]}], "|>"}], " ", 
   RowBox[{"Association", "."}]}]}]], "Message",ExpressionUUID->"ed22614e-\
875f-4ac0-b6ca-584a9ad2757a"],

