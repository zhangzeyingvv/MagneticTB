          " ", "\"\<RepresentationMatrices\>\""}], "]"}]}], ",", "\n", "  ", 
       RowBox[{"\"\<FirstBondShell\>\"", " ", "->", " ", 
        RowBox[{
         RowBox[{"compiledModel", "[", 
          
          RowBox[{"\"\<ModelSpecification\>\"", ",", 
