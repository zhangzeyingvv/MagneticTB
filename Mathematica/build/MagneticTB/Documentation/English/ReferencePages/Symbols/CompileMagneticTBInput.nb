Cell["\<\
When another program writes the model input, it can first inspect the exact \
symmetry matrices returned here. The same physical input can then be passed \
to init or initfromrep for an interactive calculation:\
\>", "ExampleText",ExpressionUUID->"4e3f5cc5-f4cf-41ff-91ea-a0145e354b6c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"compilerInput", " ", "=", " ", 
   RowBox[{"<|", "\n", "  ", 
    RowBox[{
     RowBox[{"\"\<Lattice\>\"", " ", "->", " ", 
      RowBox[{"{", "\n", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "0", ",", " ", "0"}], "}"}], ",", "\n", 
        "    ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "a", ",", " ", "0"}], "}"}], ",", "\n", 
        "    ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "a"}], "}"}]}], "\n", "  ", 
       "}"}]}], ",", "\n", "  ", 
     RowBox[{"\"\<LatticeParameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "->", " ", "1"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"\"\<WyckoffPosition\>\"", " ", "->", " ", 
      RowBox[{"{", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "\n", 
       "  ", "}"}]}], ",", "\n", "  ", 
     RowBox[{"\"\<SymmetryInformation\>\"", " ", "->", " ", 
      RowBox[{"{", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"\"\<E\>\"", ",", " ", 
         RowBox[{"IdentityMatrix", "[", "3", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", 
         " ", "\"\<F\>\""}], "}"}], "\n", "  ", "}"}]}], ",", "\n", "  ", 
     RowBox[{"\"\<BasisFunctions\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"{", "\"\<s\>\"", "}"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"\"\<Debug\>\"", " ", "->", " ", "False"}], ",", "\n", "  ", 
     RowBox[{"\"\<InitialBondShells\>\"", " ", "->", " ", "2"}], ",", "\n", 
     "  ", 
     RowBox[{"\"\<GenerateSymmetryGroup\>\"", " ", "->", " ", "False"}], ",", 
     "\n", "  ", 
     RowBox[{"\"\<RepresentationMode\>\"", " ", "->", 
      " ", "\"\<DirectProduct\>\""}], ",", "\n", "  ", 
     RowBox[{"\"\<SiteLocalData\>\"", " ", "->", " ", "Automatic"}]}], "\n", 
    "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"CompileMagneticTBInput", "[", "compilerInput", "]"}], "[", 
  RowBox[{"\"\<FullRepresentation\>\"", ",", 
   " ", "\"\<RepresentationMatrices\>\""}], "]"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"81351c1c-ae89-413e-9049-36e45e491989"],

