Cell["\<\
Read bands 21 through 23 from the included EIGENVAL file and show the first \
k-point record:\
\>", "ExampleText",ExpressionUUID->"895712d4-c884-4535-9bfb-fd35153c7e4c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eigenvalFile", " ", "=", " ", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", "\"\<EIGENVAL\>\""}],
      "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vaspBands", " ", "=", " ", 
   RowBox[{"vaspEig", "[", 
    RowBox[{"eigenvalFile", ",", " ", 
