Cell["\<\
When converting a supplied Hamiltonian, set \"wcc\" to the fractional center \
of each orbital. This example uses the graphene centers; for a periodic-gauge \
Hamiltonian, replace them with one zero vector per orbital:\
\>", "ExampleText",ExpressionUUID->"bf4b6717-2a1b-4f7c-ab33-718aa4509ac4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"grapheneNearest", " ", "=", " ", 
   RowBox[{"symham", "[", "2", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"readHR", "[", "\n", "  ", 
   RowBox[{"hop", "[", "\n", "    ", 
    RowBox[{"grapheneNearest", ",", " ", 
     RowBox[{"{", 
      RowBox[{"t1", " ", "->", " ", "0.5"}], "}"}], ",", "\n", "    ", 
     RowBox[{"\"\<hrExport\>\"", " ", "->", " ", 
      RowBox[{"FileNameJoin", "[", "\n", "      ", 
       RowBox[{"{", 
        RowBox[{
        "$TemporaryDirectory", ",", " ", "\"\<hop-explicit-wcc_hr.dat\>\""}], 
        "}"}], "\n", "    ", "]"}]}], ",", "\n", "    ", 
     RowBox[{"\"\<wcc\>\"", " ", "->", " ", 
      RowBox[{"{", "\n", "      ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "3"}], ",", " ", 
          RowBox[{"2", "/", "3"}], ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "/", "3"}], ",", " ", 
          RowBox[{"1", "/", "3"}], ",", " ", "0"}], "}"}]}], "\n", "    ", 
       "}"}]}]}], "\n", "  ", "]"}], "\n", "]"}], "[", "\"\<Translations\>\"",
   "]"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"04f5cf59-73cf-4611-9685-cf931f4b8bb4"],

