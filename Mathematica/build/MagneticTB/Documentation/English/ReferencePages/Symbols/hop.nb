Cell["\<\
Initialize graphene and construct its Hamiltonian from the first three \
neighbour contributions:\
\>", "ExampleText",ExpressionUUID->"7a6660b8-1f27-4904-8dfe-4f2c0d1a6b90"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"grapheneOperations", " ", "=", " ", 
   RowBox[{"msgop", "[", 
    RowBox[{"gray", "[", "191", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "0", ",", " ", "0"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"a", "/", "2"}]}], ",", " ", "0"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "c"}], "}"}]}], "\n", "  ", 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"c", " ", "->", " ", "3"}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "3"}], ",", " ", 
          RowBox[{"2", "/", "3"}], ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "\n", 
      "  ", "}"}]}], ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", "grapheneOperations"}], ",", 
    "\n", "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", "\"\<pz\>\"", "}"}], "}"}]}]}], "\n", "]"}], ";"}], "\n", 
 RowBox[{"ham", " ", "=", " ", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{"symham", "[", "i", "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "}"}]}], 
   "]"}]}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"5db9d575-5e55-400e-b9ac-18d388bdf7e4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"e1", "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "kx"}]], " ", "r1"}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", "kx"}]], " ", "r1"}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "kx"}], "-", "ky"}], ")"}]}]], " ", "r1"}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "ky"}]], " ", "r1"}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", "ky"}]], " ", "r1"}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"(", 
          RowBox[{"kx", "+", "ky"}], ")"}]}]], " ", "r1"}]}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            FractionBox[
             RowBox[{"2", " ", "kx"}], "3"]}], "-", 
           FractionBox["ky", "3"]}], ")"}]}]], " ", "t1"}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"(", 
          RowBox[{
           FractionBox["kx", "3"], "-", 
           FractionBox["ky", "3"]}], ")"}]}]], " ", "t1"}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"(", 
          RowBox[{
           FractionBox["kx", "3"], "+", 
           FractionBox[
            RowBox[{"2", " ", "ky"}], "3"]}], ")"}]}]], " ", "t1"}]}]}], 
    "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["kx", "3"]}], "-", 
           FractionBox[
            RowBox[{"2", " ", "ky"}], "3"]}], ")"}]}]], " ", "t1"}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["kx", "3"]}], "+", 
           FractionBox["ky", "3"]}], ")"}]}]], " ", "t1"}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"(", 
          RowBox[{
           FractionBox[
            RowBox[{"2", " ", "kx"}], "3"], "+", 
           FractionBox["ky", "3"]}], ")"}]}]], " ", "t1"}]}], ",", 
     RowBox[{"e1", "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "kx"}]], " ", "r1"}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", "kx"}]], " ", "r1"}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "kx"}], "-", "ky"}], ")"}]}]], " ", "r1"}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "ky"}]], " ", "r1"}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", "ky"}]], " ", "r1"}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"(", 
          RowBox[{"kx", "+", "ky"}], ")"}]}]], " ", "r1"}]}]}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[2]=",ExpressionUUID->"f8885407-f607-465d-855f-3e4197ada0c8"]
}, Open  ]],

Cell["Convert the Hamiltonian directly to a Wannier90 HR file:", "ExampleText",ExpressionUUID->"785a3b32-8a4d-413e-a0f7-68fb37326573"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"hrFile", " ", "=", " ", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"$TemporaryDirectory", ",", " ", "\"\<graphene_hr.dat\>\""}], 
     "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hop", "[", "\n", "  ", 
   RowBox[{"ham", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"e1", " ", "->", " ", "0.05"}], ",", " ", 
      RowBox[{"r1", " ", "->", " ", "0.02"}], ",", " ", 
      RowBox[{"t1", " ", "->", " ", "0.5"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"\"\<hrExport\>\"", " ", "->", " ", "hrFile"}], ",", " ", 
    RowBox[{"\"\<wcc\>\"", " ", "->", " ", "Automatic"}]}], "\n", "]"}], 
  ";"}], "\n", 
 RowBox[{"Take", "[", 
  RowBox[{
   RowBox[{"Import", "[", 
    RowBox[{"hrFile", ",", " ", "\"\<Lines\>\""}], "]"}], ",", " ", "12"}], 
  "]"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[3]:=",ExpressionUUID->"97104b1d-8d81-4ad6-91d1-8aef39b8172f"],

