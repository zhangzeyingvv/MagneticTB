Cell["\<\
\"KPointNeighborhood\" - fit the periodic radius 0.35 around Gamma in \
fractional reciprocal coordinates:\
\>", "ExampleText",ExpressionUUID->"a9aebcc1-3d9d-4df6-98e2-fe0acc0ff620"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"fittingTB", "[", "\n", "  ", 
   RowBox[{"fittingHamiltonian", ",", " ", "vaspBands", ",", "\n", "  ", 
    RowBox[{"Range", "[", 
     RowBox[{"Length", "[", "vaspBands", "]"}], "]"}], ",", " ", 
    "initialRules", ",", "\n", "  ", 
    RowBox[{"\"\<KPointNeighborhood\>\"", " ", "->", " ", 
     RowBox[{"<|", "\n", "    ", 
      RowBox[{
       RowBox[{"\"\<Center\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], ",", "\n", 
       "    ", 
       RowBox[{"\"\<Radius\>\"", " ", "->", " ", "0.35"}], ",", "\n", "    ", 
       
       RowBox[{"\"\<Periodic\>\"", " ", "->", " ", "True"}]}], "\n", "  ", 
      "|>"}]}]}], "\n", "]"}], "[", "\"\<ComparisonPlot\>\"", "]"}]], "Input",\

 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"e5710022-686b-4430-b197-efba49727def"],

