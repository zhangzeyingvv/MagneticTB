Cell["\<\
Fit all three VASP bands with onsite and nearest-neighbour hopping, then draw \
the full-range comparison:\
\>", "ExampleText",ExpressionUUID->"f1a1ccc0-01bb-461a-88b9-44e1d9bad7e1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nearestFit", " ", "=", " ", 
   RowBox[{"fittingTB", "[", "\n", "  ", 
    RowBox[{"fittingHamiltonian", ",", " ", "vaspBands", ",", "\n", "  ", 
     RowBox[{"Range", "[", 
      RowBox[{"Length", "[", "vaspBands", "]"}], "]"}], ",", " ", 
     "initialRules"}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"compareBand", "[", "\n", "  ", 
  RowBox[{
  "fittingPath", ",", " ", "30", ",", " ", "fittingHamiltonian", ",", "\n", 
   "  ", 
   RowBox[{"nearestFit", "[", "\"\<FittedParams\>\"", "]"}], ",", " ", 
   "vaspBands", ",", "\n", "  ", 
   RowBox[{"plotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.5"}], ",", " ", "3"}], "}"}]}]}], "\n", "]"}]}], "Input",\

 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[2]:=",ExpressionUUID->"926334cd-d89e-477c-82a6-cd7c5afe8599"],

