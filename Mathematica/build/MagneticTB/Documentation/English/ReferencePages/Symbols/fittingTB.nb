Cell["\<\
Add second-neighbour hopping, refit the same three VASP bands, and draw the \
full-range comparison again:\
\>", "ExampleText",ExpressionUUID->"3cd70236-b0a0-4023-b55d-f77f72f5af35"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"secondNeighborHamiltonian", " ", "=", " ", 
   RowBox[{"fittingHamiltonian", " ", "+", " ", 
    RowBox[{"symham", "[", "3", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"secondNeighborInitialRules", " ", "=", " ", 
   RowBox[{"Join", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"nearestFit", "[", "\"\<FittedParams\>\"", "]"}], ",", "\n", 
     "  ", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "r1", ",", " ", "r2", ",", " ", "r3", ",", " ", "r4", ",", " ", "r5", 
         ",", " ", "r6", ",", " ", "r7", ",", " ", "r8", ",", " ", "r9", ",", 
         " ", "r10"}], "}"}], " ", "->", " ", "0."}], "]"}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"secondNeighborFit", " ", "=", " ", 
   RowBox[{"fittingTB", "[", "\n", "  ", 
    RowBox[{
    "secondNeighborHamiltonian", ",", " ", "vaspBands", ",", "\n", "  ", 
     RowBox[{"Range", "[", 
      RowBox[{"Length", "[", "vaspBands", "]"}], "]"}], ",", " ", 
     "secondNeighborInitialRules"}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"compareBand", "[", "\n", "  ", 
  RowBox[{
  "fittingPath", ",", " ", "30", ",", " ", "secondNeighborHamiltonian", ",", 
   "\n", "  ", 
   RowBox[{"secondNeighborFit", "[", "\"\<FittedParams\>\"", "]"}], ",", " ", 
   "vaspBands", ",", "\n", "  ", 
   RowBox[{"plotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.5"}], ",", " ", "3"}], "}"}]}]}], "\n", "]"}]}], "Input",\

 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[4]:=",ExpressionUUID->"98543d9c-6696-450a-ad25-fdeacb570f75"],

