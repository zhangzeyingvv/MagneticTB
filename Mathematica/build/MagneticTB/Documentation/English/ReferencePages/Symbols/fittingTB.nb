Cell["\<\
Read the VASP three-band data and construct the symmetry-generated hexagonal \
model:\
\>", "ExampleText",ExpressionUUID->"a9d36ef7-7599-4af7-ae25-8e251b76fc3d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"eigenvalFile", " ", "=", " ", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", "\"\<EIGENVAL\>\""}],
      "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"vaspBands", " ", "=", " ", 
    RowBox[{"vaspEig", "[", 
     RowBox[{"eigenvalFile", ",", " ", 
      RowBox[{"-", "0.0072"}], ",", " ", "1", ",", " ", "21", ",", " ", 
      "23"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "0", ",", " ", "0"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"a", "/", "2"}]}], ",", " ", "0"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "c"}], "}"}]}], "\n", "  ", 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"c", " ", "->", " ", "10"}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "/", "3"}], ",", " ", 
          RowBox[{"1", "/", "3"}], ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
