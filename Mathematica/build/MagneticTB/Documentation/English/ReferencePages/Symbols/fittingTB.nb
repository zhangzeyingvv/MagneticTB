Cell["\<\
\"ResidualWeights\" - give the first path segment five times the weight of \
the remaining points:\
\>", "ExampleText",ExpressionUUID->"dc166b27-68a4-4c37-a31a-4e095e7bf23a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fitWeights", " ", "=", " ", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"1.", ",", " ", 
     RowBox[{"Dimensions", "[", 
      RowBox[{"vaspBands", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fitWeights", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"1", " ", ";;", " ", "30"}], ",", " ", "All"}], "]"}], "]"}], 
   " ", "=", " ", "5."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fittingTB", "[", "\n", "  ", 
   RowBox[{"fittingHamiltonian", ",", " ", "vaspBands", ",", "\n", "  ", 
    RowBox[{"Range", "[", 
     RowBox[{"Length", "[", "vaspBands", "]"}], "]"}], ",", " ", 
    "initialRules", ",", "\n", "  ", 
    RowBox[{"\"\<ResidualWeights\>\"", " ", "->", " ", "fitWeights"}]}], "\n",
    "]"}], "[", "\"\<ComparisonPlot\>\"", "]"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"75f3a14c-fdc6-4a49-a610-1d8a67dd885c"],

