Cell["\<\
Initialize a one-orbital simple-cubic model before requesting its \
conventional path:\
\>", "ExampleText",ExpressionUUID->"65c2ef1e-6313-4d41-bed3-810e6f0ef898"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"cubicOperations", " ", "=", " ", 
   RowBox[{"msgop", "[", 
    RowBox[{"gray", "[", "221", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "}"}]}],
     ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", "cubicOperations"}], ",", "\n",
     "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", "\"\<s\>\"", "}"}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"InitialBondShells", " ", "->", " ", "2"}], ",", "\n", "  ", 
    RowBox[{"GenerateSymmetryGroup", " ", "->", " ", "False"}]}], "\n", "]"}],
   ";"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"e39c468d-7727-466f-b387-d46f078db3ff"],

Cell["\<\
For a simple-cubic lattice, the path contains the conventional \
Gamma-X-M-Gamma-R-X and M-R segments:\
\>", "ExampleText",ExpressionUUID->"42568f38-719b-485b-ad16-eb852540f8c4"],

