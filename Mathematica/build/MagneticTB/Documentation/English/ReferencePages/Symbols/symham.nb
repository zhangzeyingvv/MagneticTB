Cell["\<\
Initialize the complete graphene model used below. symham never performs \
initialization implicitly:\
\>", "ExampleText",ExpressionUUID->"2d83a395-f4fe-4611-ba11-316ef93f5dcf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"grapheneOperations", " ", "=", " ", 
   RowBox[{"msgop", "[", 
    RowBox[{"gray", "[", "191", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "0", ",", " ", "0"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"a", "/", "2"}]}], ",", " ", "0"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "c"}], "}"}]}], "\n", "  ", 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"c", " ", "->", " ", "3"}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "3"}], ",", " ", 
          RowBox[{"2", "/", "3"}], ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "\n", 
      "  ", "}"}]}], ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", "grapheneOperations"}], ",", 
    "\n", "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", "\"\<pz\>\"", "}"}], "}"}]}]}], "\n", "]"}], 
  ";"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"284d7c77-e744-45d2-8eee-67c02cfa61a2"],

Cell["\<\
Shell 1 is the onsite contribution. The same onsite parameter appears on the \
two equivalent carbon sites:\
\>", "ExampleText",ExpressionUUID->"eb72668f-22e2-41c3-b986-9aefecb6ad34"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"grapheneOnsite", " ", "=", " ", 
