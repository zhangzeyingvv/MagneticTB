   RowBox[{
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<Hermitian -> True: \>\"", ",", " ", 
       RowBox[{"MatrixForm", "[", "p3Hermitian", "]"}]}], "}"}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<Hermitian -> False: \>\"", ",", " ", 
       RowBox[{"MatrixForm", "[", "p3NonHermitian", "]"}]}], "}"}], "]"}]}], 
   "\n", "}"}], "]"}]}], "Input",
