}, Open  ]],

Cell["\<\
Shell 2 is the nearest-neighbour hopping. Its off-diagonal entries contain \
the three symmetry-related Bloch phases:\
\>", "ExampleText",ExpressionUUID->"fddb9f4d-f17d-4937-b707-32418277713f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"grapheneNearest", " ", "=", " ", 
   RowBox[{"symham", "[", "2", "]"}]}], ";"}], "\n", 
 RowBox[{"MatrixForm", "[", "grapheneNearest", "]"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[4]:=",ExpressionUUID->"906c7cba-bbf6-4261-ad1f-168f57cf751e"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"0", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             FractionBox[
              RowBox[{"2", " ", "kx"}], "3"]}], "-", 
            FractionBox["ky", "3"]}], ")"}]}]], " ", "t1"}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            FractionBox["kx", "3"], "-", 
            FractionBox["ky", "3"]}], ")"}]}]], " ", "t1"}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            FractionBox["kx", "3"], "+", 
            FractionBox[
             RowBox[{"2", " ", "ky"}], "3"]}], ")"}]}]], " ", "t1"}]}]},
     {
      RowBox[{
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             FractionBox["kx", "3"]}], "-", 
            FractionBox[
