Cell["\<\
Find the common null space of two ordinary exact constraint blocks containing \
three independent square roots. The two displayed residual matrices are \
exactly zero:\
\>", "ExampleText",ExpressionUUID->"f4b26155-1eb9-4753-961b-fa182ec3d820"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"constraintBlocks", " ", "=", " ", 
   RowBox[{"{", "\n", "  ", 
    RowBox[{
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0", ",", " ", "0", ",", " ", 
         RowBox[{"-", 
          RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", "0"}], "}"}], ",", 
       "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1", ",", " ", "0", ",", " ", 
         RowBox[{"-", 
          RowBox[{"Sqrt", "[", "3", "]"}]}], ",", " ", "0"}], "}"}]}], "\n", 
      "  ", "}"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0", ",", " ", "1", ",", " ", 
        RowBox[{"-", 
         RowBox[{"Sqrt", "[", "5", "]"}]}], ",", " ", "0"}], "}"}], "}"}]}], 
    "\n", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"commonRows", " ", "=", " ", 
   RowBox[{"CyclotomicCommonNullSpace", "[", "constraintBlocks", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", "\n", "  ", 
  RowBox[{
   RowBox[{"MatrixForm", "[", "commonRows", "]"}], ",", "\n", "  ", 
   RowBox[{"MatrixForm", " ", "/@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"#", " ", ".", " ", 
        RowBox[{"Transpose", "[", "commonRows", "]"}]}], " ", "&"}], " ", "/@",
       " ", "constraintBlocks"}], ")"}]}]}], "\n", "}"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"55ae86c5-98c0-45ce-8d03-56a0b15a17c1"],

