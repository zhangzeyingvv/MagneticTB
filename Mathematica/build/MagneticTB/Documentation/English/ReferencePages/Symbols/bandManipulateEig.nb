Cell["\<\
Read the included VASP bands and construct the symmetry-generated \
three-orbital hexagonal Hamiltonian:\
\>", "ExampleText",ExpressionUUID->"c3f9c9b2-c0b5-46d4-983f-e190ba387ca0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"eigenvalFile", " ", "=", " ", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", "\"\<EIGENVAL\>\""}],
      "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"vaspBands", " ", "=", " ", 
    RowBox[{"vaspEig", "[", 
     RowBox[{"eigenvalFile", ",", " ", 
      RowBox[{"-", "0.0072"}], ",", " ", "1", ",", " ", "21", ",", " ", 
      "23"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "0", ",", " ", "0"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"a", "/", "2"}]}], ",", " ", "0"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "c"}], "}"}]}], "\n", "  ", 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"c", " ", "->", " ", "10"}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "/", "3"}], ",", " ", 
          RowBox[{"1", "/", "3"}], ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "}"}]}],
     ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"msgop", "[", 
        RowBox[{"gray", "[", "156", "]"}], "]"}], ",", " ", "6"}], "]"}]}], ",",
     "\n", "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"\"\<dz2\>\"", ",", " ", "\"\<dxy\>\"", ",", 
        " ", "\"\<dx2-y2\>\""}], "}"}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"InitialBondShells", " ", "->", " ", "3"}]}], "\n", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"fittingHamiltonian", " ", "=", " ", 
   RowBox[{
    RowBox[{"symham", "[", "1", "]"}], " ", "+", " ", 
    RowBox[{"symham", "[", "2", "]"}]}]}], ";"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"53022e85-dba2-4f0c-8e6d-517cdfeda6b8"],

Cell["\<\
Move the sliders until the black tight-binding bands follow the red VASP \
bands:\
\>", "ExampleText",ExpressionUUID->"094527e3-039c-4a65-b15c-db48da12c81e"],

Cell[CellGroupData[{

Cell[BoxData[
