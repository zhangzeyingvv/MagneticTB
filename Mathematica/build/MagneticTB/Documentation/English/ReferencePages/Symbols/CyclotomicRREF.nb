Cell["\<\
The same call works in a nontrivial cyclotomic field. Here the matrix entry i \
is kept exact throughout the reduction:\
\>", "ExampleText",ExpressionUUID->"023b3d97-884f-4b44-ace2-da1fb3f96f25"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"iRoot", " ", "=", " ", 
   RowBox[{"<|", "\n", "  ", 
    RowBox[{
     RowBox[{"\"\<kind\>\"", " ", "->", " ", "\"\<root_sum\>\""}], ",", "\n", 
     "  ", 
     RowBox[{"\"\<constant\>\"", " ", "->", " ", "0"}], ",", "\n", "  ", 
     RowBox[{"\"\<terms\>\"", " ", "->", " ", 
      RowBox[{"{", "\n", "    ", 
       RowBox[{"<|", "\n", "      ", 
        RowBox[{
         RowBox[{"\"\<coefficient\>\"", " ", "->", " ", "1"}], ",", "\n", 
         "      ", 
         RowBox[{"\"\<order\>\"", " ", "->", " ", "4"}], ",", "\n", "      ", 
         
         RowBox[{"\"\<power\>\"", " ", "->", " ", "1"}]}], "\n", "    ", 
        "|>"}], "\n", "  ", "}"}]}]}], "\n", "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"compiledCyclotomic", " ", "=", " ", 
   RowBox[{"CompileCyclotomicMatrices", "[", 
    RowBox[{"<|", "\n", "  ", 
     RowBox[{
      RowBox[{"\"\<coordinate_dimension\>\"", " ", "->", " ", "3"}], ",", 
      "\n", "  ", 
      RowBox[{"\"\<constraints\>\"", " ", "->", " ", 
       RowBox[{"{", "\n", "    ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "iRoot", ",", " ", "0"}], "}"}], "}"}], ",",
          "\n", "    ", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1", ",", " ", "0"}], "}"}], "}"}]}], "\n", 
        "  ", "}"}]}], ",", "\n", "  ", 
      RowBox[{"\"\<max_cyclotomic_degree\>\"", " ", "->", " ", "128"}]}], 
     "\n", "|>"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cyclotomicRREF", " ", "=", " ", 
   RowBox[{"CyclotomicRREF", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"compiledCyclotomic", "[", "\"\<constraints\>\"", "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"restoredCyclotomicRREF", " ", "=", " ", 
   RowBox[{"RestoreCyclotomicExpression", "[", "\n", "  ", 
    RowBox[{"cyclotomicRREF", "[", "\"\<reduced_matrix\>\"", "]"}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{"{", "\n", "  ", 
  RowBox[{
   RowBox[{"MatrixForm", "@", 
    RowBox[{"Partition", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"restoredCyclotomicRREF", "[", "\"\<entries\>\"", "]"}], ",", 
      "\n", "    ", 
