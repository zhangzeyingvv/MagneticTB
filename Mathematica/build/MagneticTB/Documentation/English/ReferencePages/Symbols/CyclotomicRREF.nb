Cell["\<\
Compile a rank-one rational matrix and display its exact RREF together with \
its 0-based pivot and free columns:\
\>", "ExampleText",ExpressionUUID->"454ae8b8-6a85-4f04-99e7-4d4aa5ca6d97"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"compiledRational", " ", "=", " ", 
   RowBox[{"CompileCyclotomicMatrices", "[", 
    RowBox[{"<|", "\n", "  ", 
     RowBox[{
      RowBox[{"\"\<coordinate_dimension\>\"", " ", "->", " ", "3"}], ",", 
      "\n", "  ", 
      RowBox[{"\"\<constraints\>\"", " ", "->", " ", 
       RowBox[{"{", "\n", "    ", 
        RowBox[{"{", "\n", "      ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", "\n", 
          "      ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "4", ",", " ", "6"}], "}"}]}], "\n", "    ",
          "}"}], "\n", "  ", "}"}]}]}], "\n", "|>"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exactRationalMatrix", " ", "=", " ", 
   RowBox[{
    RowBox[{"compiledRational", "[", "\"\<constraints\>\"", "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rrefResult", " ", "=", " ", 
   RowBox[{"CyclotomicRREF", "[", "exactRationalMatrix", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"restoredRREF", " ", "=", " ", 
   RowBox[{"RestoreCyclotomicExpression", "[", "\n", "  ", 
    RowBox[{"rrefResult", "[", "\"\<reduced_matrix\>\"", "]"}], "\n", "]"}]}],
   ";"}], "\n", 
 RowBox[{"{", "\n", "  ", 
  RowBox[{
   RowBox[{"MatrixForm", "@", 
    RowBox[{"Partition", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"restoredRREF", "[", "\"\<entries\>\"", "]"}], ",", " ", 
      RowBox[{"restoredRREF", "[", "\"\<columns\>\"", "]"}]}], "\n", "  ", 
     "]"}]}], ",", "\n", "  ", 
   RowBox[{"KeyTake", "[", "\n", "    ", 
    RowBox[{"rrefResult", ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"\"\<pivot_columns\>\"", ",", " ", "\"\<free_columns\>\"", ",", 
       " ", "\"\<rank\>\"", ",", " ", "\"\<nullity\>\""}], "}"}]}], "\n", 
    "  ", "]"}]}], "\n", "}"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"5be8ce4b-0419-40e7-a642-e54e37146a17"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TagBox[
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"1", "2", "3"},
       {"0", "0", "0"}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}],
    Function[BoxForm`e$, 
     MatrixForm[BoxForm`e$]]], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"pivot_columns\"\>", "\[Rule]", 
      RowBox[{"{", "0", "}"}]}], ",", 
     RowBox[{"\<\"free_columns\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}]}], ",", 
     RowBox[{"\<\"rank\"\>", "\[Rule]", "1"}], ",", 
     RowBox[{"\<\"nullity\"\>", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}],
   "}"}]], "Output",
 CellLabel->"Out[2]=",ExpressionUUID->"261facf2-e964-41b6-a148-41c16a96ea00"]
}, Open  ]]
}, Open  ]],

