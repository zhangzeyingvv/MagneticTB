Cell["\<\
Create a graphene HR file with hop, read it back, reconstruct H(k), and \
display the Hamiltonian at the Gamma point:\
\>", "ExampleText",ExpressionUUID->"2ef51bf2-8dce-493a-945e-5b8dd5c471ef"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"grapheneOperations", " ", "=", " ", 
   RowBox[{"msgop", "[", 
    RowBox[{"gray", "[", "191", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "0", ",", " ", "0"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"a", "/", "2"}]}], ",", " ", "0"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "c"}], "}"}]}], "\n", "  ", 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"c", " ", "->", " ", "3"}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "3"}], ",", " ", 
          RowBox[{"2", "/", "3"}], ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "\n", 
      "  ", "}"}]}], ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", "grapheneOperations"}], ",", 
    "\n", "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", "\"\<pz\>\"", "}"}], "}"}]}]}], "\n", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Scan", "[", 
   RowBox[{"symham", ",", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hrFile", " ", "=", " ", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"$TemporaryDirectory", ",", " ", "\"\<graphene_hr.dat\>\""}], 
     "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hop", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"e1", " ", "->", " ", "0.05"}], ",", " ", 
      RowBox[{"r1", " ", "->", " ", "0.02"}], ",", " ", 
      RowBox[{"t1", " ", "->", " ", "0.5"}]}], "}"}], ",", " ", 
    RowBox[{"\"\<hrExport\>\"", " ", "->", " ", "hrFile"}], ",", " ", 
    RowBox[{"\"\<wcc\>\"", " ", "->", " ", "Automatic"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hrData", " ", "=", " ", 
   RowBox[{"readHR", "[", "hrFile", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hrHamiltonian", "[", "k_List", "]"}], " ", ":=", " ", 
   RowBox[{"buildBlochHamiltonian", "[", 
    RowBox[{"hrData", ",", " ", "k"}], "]"}]}], ";"}], "\n", 
 RowBox[{"MatrixForm", "@", 
  RowBox[{"hrHamiltonian", "[", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], "]"}]}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"7ab9bf9c-48ba-46ac-a566-643cebbceb63"],

