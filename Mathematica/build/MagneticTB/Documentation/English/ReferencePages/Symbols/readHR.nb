Cell["\<\
\"prec\" -> 10^-12 chops symmetry-generated hopping entries below that \
threshold. The 10^-13 non-onsite hopping becomes an exact zero:\
\>", "ExampleText",ExpressionUUID->"352205ea-3554-4786-9300-c17e3d7372dd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"tinyHRFile", " ", "=", " ", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
     "$TemporaryDirectory", ",", " ", "\"\<graphene_tiny_hr.dat\>\""}], "}"}],
     "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hop", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"e1", " ", "->", " ", "1."}], ",", " ", 
      RowBox[{"r1", " ", "->", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "13"}]}]}], ",", " ", 
      RowBox[{"t1", " ", "->", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "13"}]}]}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"\"\<hrExport\>\"", " ", "->", " ", "tinyHRFile"}], ",", " ", 
    RowBox[{"\"\<wcc\>\"", " ", "->", " ", "Automatic"}]}], "\n", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"tinyHRData", " ", "=", " ", 
   RowBox[{"readHR", "[", 
    RowBox[{"tinyHRFile", ",", " ", 
     RowBox[{"\"\<prec\>\"", " ", "->", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "12"}]}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"MatrixForm", "@", 
  RowBox[{"First", "@", 
   RowBox[{"Pick", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"tinyHRData", "[", "\"\<HoppingMatrices\>\"", "]"}], ",", "\n", 
     "  ", 
     RowBox[{"tinyHRData", "[", "\"\<Translations\>\"", "]"}], ",", "\n", 
     "  ", 
     RowBox[{"Except", "[", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}], "]"}]}], "\n", 
    "]"}]}]}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"064edd9b-cbfe-4904-820f-94f104d48dd4"],

