          RowBox[{"(", 
           RowBox[{
            FractionBox[
             RowBox[{"2", " ", "kxold"}], "3"], "+", 
            FractionBox["kyold", "3"]}], ")"}]}]], " ", "t1old"}]}], "e1old"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
