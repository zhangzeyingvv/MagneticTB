Cell["\<\
Call initold first. The shell numbering and Bloch Hamiltonian follow the \
original package, while every symbol carries the old suffix where needed for \
isolation.\
\>", "Notes",ExpressionUUID->"e1c35406-496a-4f91-a24e-8eaa83843847"],

Cell["\<\
symhamold is kept for existing notebooks and for independent comparisons with \
the current version. Its calculation is entirely the one used by the original \
MagneticTB.\
\>", "Notes",ExpressionUUID->"85e7a841-fd77-44e5-b5b6-1071ea9794d9"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "bff7f267-5ba3-472d-8fcb-029273c5b82d"], "symmetrysetold", "genindex", 
    Cell["\<\
Subset of symmetry-operation indices used by the original algorithm. This \
option exists only in MagneticTBOld`.\
\>", "TableText",ExpressionUUID->"338151cf-7481-4e23-a96f-11fe91ebbe41"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "41d496e2-824c-4313-859f-552fe9ceaf21"], "\"\<CartesianCoordinates\>\"", 
