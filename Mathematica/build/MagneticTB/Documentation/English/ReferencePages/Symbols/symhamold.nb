Cell["\<\
Initialize the complete original model used in this example. symhamold does \
not perform initialization:\
\>", "ExampleText",ExpressionUUID->"def0fbf4-e39d-4072-8aa7-0700c8d5c3c7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"grapheneOperationsOld", " ", "=", " ", 
   RowBox[{"msgopold", "[", 
    RowBox[{"grayold", "[", "191", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"initold", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"latticeold", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"aold", ",", " ", "0", ",", " ", "0"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "aold"}], "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"aold", "/", "2"}]}], ",", " ", "0"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "cold"}], "}"}]}], "\n", "  ", 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"lattparold", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"aold", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"cold", " ", "->", " ", "3"}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffpositionold", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "3"}], ",", " ", 
          RowBox[{"2", "/", "3"}], ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "\n", 
      "  ", "}"}]}], ",", "\n", "  ", 
    RowBox[{"symminformationold", " ", "->", " ", "grapheneOperationsOld"}], ",",
     "\n", "  ", 
    RowBox[{"basisFunctionsold", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", "\"\<pz\>\"", "}"}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"debugQold", " ", "->", " ", "False"}]}], "\n", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hOldOnsite", " ", "=", " ", 
   RowBox[{"symhamold", "[", "1", "]"}]}], ";"}], "\n", 
 RowBox[{"MatrixForm", "[", "hOldOnsite", "]"}]}], "Input",
 CellProlog:>Needs["MagneticTBOld`"],
 CellLabel->"In[1]:=",ExpressionUUID->"4811add1-771f-4aec-ae0e-9eae204c1dca"],

