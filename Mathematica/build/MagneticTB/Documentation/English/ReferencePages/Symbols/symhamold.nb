           RowBox[{
            FractionBox["kxold", "3"], "+", 
            FractionBox[
             RowBox[{"2", " ", "kyold"}], "3"]}], ")"}]}]], " ", 
        "t1old"}]}]},
     {
      RowBox[{
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             FractionBox["kxold", "3"]}], "-", 
            FractionBox[
             RowBox[{"2", " ", "kyold"}], "3"]}], ")"}]}]], " ", "t1old"}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             FractionBox["kxold", "3"]}], "+", 
            FractionBox["kyold", "3"]}], ")"}]}]], " ", "t1old"}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
