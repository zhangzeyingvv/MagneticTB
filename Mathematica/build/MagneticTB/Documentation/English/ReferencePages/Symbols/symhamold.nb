Cell["\<\
Add the onsite and nearest-neighbour terms to obtain the Bloch Hamiltonian of \
the original version:\
\>", "ExampleText",ExpressionUUID->"612bfad9-a23f-425e-a59c-e2b1d437812f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"hOldNearest", " ", "=", " ", 
   RowBox[{"symhamold", "[", "2", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hOld", " ", "=", " ", 
   RowBox[{"hOldOnsite", " ", "+", " ", "hOldNearest"}]}], ";"}], "\n", 
 RowBox[{"MatrixForm", "[", "hOld", "]"}]}], "Input",
 CellProlog:>Needs["MagneticTBOld`"],
 CellLabel->"In[3]:=",ExpressionUUID->"26413df1-a664-48c6-ad34-707aaf792f84"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"e1old", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             FractionBox[
              RowBox[{"2", " ", "kxold"}], "3"]}], "-", 
