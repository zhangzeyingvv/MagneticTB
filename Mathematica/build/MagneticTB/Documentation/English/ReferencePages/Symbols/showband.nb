Cell["\<\
Initialize the one-orbital simple-cubic model used by the automatic path:\
\>", "ExampleText",ExpressionUUID->"5f7177d6-3b10-44ce-a4d3-d3ed097f673c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"cubicOperations", " ", "=", " ", 
   RowBox[{"msgop", "[", 
    RowBox[{"gray", "[", "221", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "}"}]}],
     ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", "cubicOperations"}], ",", "\n",
     "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", "\"\<s\>\"", "}"}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"InitialBondShells", " ", "->", " ", "2"}], ",", "\n", "  ", 
    RowBox[{"GenerateSymmetryGroup", " ", "->", " ", "False"}]}], "\n", "]"}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"plotHamiltonian", " ", "=", " ", 
   RowBox[{"symham", "[", "2", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"plotRules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"t1", " ", "->", " ", "1"}], "}"}]}], ";"}]}], "Input",
 CellProlog:>Needs["MagneticTB`"],
 CellLabel->"In[1]:=",ExpressionUUID->"e39157a1-d40d-4f23-9165-906fa1217e44"],

Cell["\<\
Let showband choose the conventional simple-cubic path and draw the \
dispersion:\
\>", "ExampleText",ExpressionUUID->"f2facced-cdcd-46c1-9ff9-50d0c4ca45aa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"showband", "[", 
  RowBox[{"4", ",", " ", "plotHamiltonian", ",", " ", "plotRules"}], 
