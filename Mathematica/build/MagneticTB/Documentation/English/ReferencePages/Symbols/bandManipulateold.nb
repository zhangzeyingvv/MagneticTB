Cell["\<\
Initialize the original graphene model and construct its Hamiltonian before \
plotting:\
\>", "ExampleText",ExpressionUUID->"152eba9b-ac2a-4401-9c8c-aca29f98a49f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"grapheneOperationsOld", " ", "=", " ", 
   RowBox[{"msgopold", "[", 
    RowBox[{"grayold", "[", "191", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"initold", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"latticeold", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"aold", ",", " ", "0", ",", " ", "0"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "aold"}], "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"aold", "/", "2"}]}], ",", " ", "0"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "cold"}], "}"}]}], "\n", "  ", 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"lattparold", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"aold", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"cold", " ", "->", " ", "3"}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffpositionold", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "3"}], ",", " ", 
          RowBox[{"2", "/", "3"}], ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "\n", 
      "  ", "}"}]}], ",", "\n", "  ", 
    RowBox[{"symminformationold", " ", "->", " ", "grapheneOperationsOld"}], ",",
     "\n", "  ", 
    RowBox[{"basisFunctionsold", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", "\"\<pz\>\"", "}"}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"debugQold", " ", "->", " ", "False"}]}], "\n", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hOld", " ", "=", " ", 
   RowBox[{"Total", "[", 
    RowBox[{"symhamold", " ", "/@", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"MatrixForm", "[", "hOld", "]"}]}], "Input",
 CellProlog:>Needs["MagneticTBOld`"],
 CellLabel->"In[1]:=",ExpressionUUID->"19de2f08-b2f1-4978-98d1-c34ce684de5b"],

