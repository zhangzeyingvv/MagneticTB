Cell["\<\
graylayer is an Association whose integer keys run from 1 through 80.\
\>", "Notes",ExpressionUUID->"737bb082-0e02-446d-824c-169f8f79b132"],

Cell["\<\
Use mlgop[graylayer[n]] to read the complete ordered operation list; \
graylayer[n] alone returns only the three-integer database identifier.\
\>", "Notes",ExpressionUUID->"a73bc730-21eb-4986-af5b-8d71d547d5bc"]
}, Closed]],

