Cell["\<\
grayrod is an Association whose integer keys run from 1 through 75.\
\>", "Notes",ExpressionUUID->"277a3a7c-da4b-4757-98b9-d2c43686e94e"],

Cell["\<\
Use mrgop[grayrod[n]] to read the complete ordered operation list; grayrod[n] \
alone returns only the three-integer database identifier.\
\>", "Notes",ExpressionUUID->"88617af7-6d88-4f1e-876e-4b35e10e4ecb"]
}, Closed]],

