         " ", "r10"}], "}"}], " ", "->", " ", "0."}], "]"}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"secondNeighborFit", " ", "=", " ", 
   RowBox[{"fittingTB", "[", "\n", "  ", 
    RowBox[{
    "secondNeighborHamiltonian", ",", " ", "vaspBands", ",", "\n", "  ", 
     RowBox[{"Range", "[", 
      RowBox[{"Length", "[", "vaspBands", "]"}], "]"}], ",", " ", 
     "secondNeighborInitialRules"}], "\n", "]"}]}], ";"}], "\n", 
