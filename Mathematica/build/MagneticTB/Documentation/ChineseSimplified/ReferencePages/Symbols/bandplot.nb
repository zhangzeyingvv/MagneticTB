      RowBox[{"Cos", "[", "kx", "]"}], " ", "+", " ", 
      RowBox[{"Cos", "[", "ky", "]"}], " ", "+", " ", 
      RowBox[{"Cos", "[", "kz", "]"}]}], "}"}], "}"}]}], ";"}], "\n", 
