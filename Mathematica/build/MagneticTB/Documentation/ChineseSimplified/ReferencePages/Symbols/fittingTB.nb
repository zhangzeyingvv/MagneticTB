Cell["\:52a0\:5165\:7b2c\:4e8c\:8fd1\:90bb hopping\:ff0c\:91cd\:65b0\:62df\
\:5408\:540c\:6837\:7684\:4e09\:6761 VASP \
\:80fd\:5e26\:ff0c\:5e76\:518d\:6b21\:7ed8\:5236\:5b8c\:6574\:80fd\:91cf\:8303\
\:56f4\:7684\:5bf9\:6bd4\:56fe\:ff1a", "ExampleText",ExpressionUUID->\
"6f50a229-837c-463b-8d2c-a8457504ad8e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"secondNeighborHamiltonian", " ", "=", " ", 
   RowBox[{"fittingHamiltonian", " ", "+", " ", 
    RowBox[{"symham", "[", "3", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"secondNeighborInitialRules", " ", "=", " ", 
   RowBox[{"Join", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"nearestFit", "[", "\"\<FittedParams\>\"", "]"}], ",", "\n", 
     "  ", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "r1", ",", " ", "r2", ",", " ", "r3", ",", " ", "r4", ",", " ", "r5", 
         ",", " ", "r6", ",", " ", "r7", ",", " ", "r8", ",", " ", "r9", ",", 
         " ", "r10"}], "}"}], " ", "->", " ", "0."}], "]"}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"secondNeighborFit", " ", "=", " ", 
   RowBox[{"fittingTB", "[", "\n", "  ", 
    RowBox[{
    "secondNeighborHamiltonian", ",", " ", "vaspBands", ",", "\n", "  ", 
     RowBox[{"Range", "[", 
      RowBox[{"Length", "[", "vaspBands", "]"}], "]"}], ",", " ", 
     "secondNeighborInitialRules"}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"compareBand", "[", "\n", "  ", 
  RowBox[{
  "fittingPath", ",", " ", "30", ",", " ", "secondNeighborHamiltonian", ",", 
   "\n", "  ", 
   RowBox[{"secondNeighborFit", "[", "\"\<FittedParams\>\"", "]"}], ",", " ", 
   "vaspBands", ",", "\n", "  ", 
   RowBox[{"plotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.5"}], ",", " ", "3"}], "}"}]}]}], "\n", "]"}]}], "Input",\

 CellProlog:>Needs["MagneticTB`"],
