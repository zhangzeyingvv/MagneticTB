Cell[BoxData[{
 RowBox[{
  RowBox[{"eigenvalFile", " ", "=", " ", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", "\"\<EIGENVAL\>\""}],
      "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"vaspBands", " ", "=", " ", 
    RowBox[{"vaspEig", "[", 
     RowBox[{"eigenvalFile", ",", " ", 
      RowBox[{"-", "0.0072"}], ",", " ", "1", ",", " ", "21", ",", " ", 
      "23"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"init", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"lattice", " ", "->", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "0", ",", " ", "0"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "a"}], "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], " ", 
          RowBox[{"a", "/", "2"}]}], ",", " ", "0"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "c"}], "}"}]}], "\n", "  ", 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{"lattpar", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"c", " ", "->", " ", "10"}]}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"wyckoffposition", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "/", "3"}], ",", " ", 
          RowBox[{"1", "/", "3"}], ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], "}"}]}],
     ",", "\n", "  ", 
    RowBox[{"symminformation", " ", "->", " ", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"msgop", "[", 
        RowBox[{"gray", "[", "156", "]"}], "]"}], ",", " ", "6"}], "]"}]}], ",",
     "\n", "  ", 
    RowBox[{"basisFunctions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"\"\<dz2\>\"", ",", " ", "\"\<dxy\>\"", ",", 
        " ", "\"\<dx2-y2\>\""}], "}"}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"InitialBondShells", " ", "->", " ", "3"}]}], "\n", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"fittingHamiltonian", " ", "=", " ", 
   RowBox[{
    RowBox[{"symham", "[", "1", "]"}], " ", "+", " ", 
    RowBox[{"symham", "[", "2", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fittingPath", " ", "=", " ", 
   RowBox[{"{", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "2"}], ",", " ", "0", ",", " ", "0"}], "}"}]}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<\[CapitalGamma]\>\"", ",", " ", "\"\<M\>\""}], "}"}]}], 
      "}"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "2"}], ",", " ", "0", ",", " ", "0"}], "}"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "3"}], ",", " ", 
           RowBox[{"1", "/", "3"}], ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<M\>\"", ",", " ", "\"\<K\>\""}], "}"}]}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "3"}], ",", " ", 
           RowBox[{"1", "/", "3"}], ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<K\>\"", ",", " ", "\"\<\[CapitalGamma]\>\""}], "}"}]}], 
      "}"}]}], "\n", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"initialRules", " ", "=", " ", 
   RowBox[{"{", "\n", "  ", 
    RowBox[{
     RowBox[{"e1", " ", "->", " ", "0.915"}], ",", " ", 
     RowBox[{"e2", " ", "->", " ", "0.685"}], ",", "\n", "  ", 
     RowBox[{"t1", " ", "->", " ", "0.1"}], ",", " ", 
     RowBox[{"t2", " ", "->", " ", "0.09"}], ",", " ", 
     RowBox[{"t3", " ", "->", " ", "0.1"}], ",", "\n", "  ", 
