     RowBox[{"t5", " ", "->", " ", "0.34"}], ",", " ", 
     RowBox[{"t6", " ", "->", " ", "0.245"}], ",", "\n", "  ", 
     RowBox[{"t7", " ", "->", " ", "0.565"}], ",", " ", 
     RowBox[{"t8", " ", "->", " ", "0.305"}], ",", " ", 
     RowBox[{"t9", " ", "->", " ", "0.365"}]}], "\n", "}"}]}], 
  ";"}]}], "Input",
