  RowBox[{"CompileMagneticTBInput", "::", 
   RowBox[{"input", ":", " ", 
    RowBox[{
     RowBox[{
     "The", " ", "init", " ", "options", " ", "are", " ", "incomplete", " ", 
      "or", " ", "mutually", " ", 
      RowBox[{"incompatible", ".", " ", "symminformation"}], " ", "must", " ",
       "be", " ", "either", " ", "traditional", " ", 
      RowBox[{"{", 
       RowBox[{"label", ",", "R", ",", "t", ",", 
        RowBox[{"F", "|", "T"}]}], "}"}], " ", "records", " ", "or", " ", "a",
       " ", "discrete", " ", "spin"}], "-", "space", "-", 
     RowBox[{"group", " ", "label"}]}]}]}], "->", 
  RowBox[{
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"space", "->", 
      RowBox[{"{", 
       RowBox[{"R", ",", "t"}], "}"}]}], ",", 
     RowBox[{"spin", "->", 
      RowBox[{"{", 
       RowBox[{"S", ",", 
        RowBox[{"0", "|", "1"}]}], "}"}]}]}], "|>"}], " ", 
   RowBox[{"Association", "."}]}]}]], "Message",ExpressionUUID->"7db3e2a9-\
