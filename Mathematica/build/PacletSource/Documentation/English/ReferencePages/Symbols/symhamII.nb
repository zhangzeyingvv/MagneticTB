Notebook[{Cell[CellGroupData[{Cell["symhamII", "ObjectName"], Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["symhamII[H]"], "InlineFormula"], " \:2028", "changes the Bloch basis convention of H by including the orbital-center phases."}], "Usage"], Cell["In convention I, the Bloch phase is attached to the full displacement between orbitals. Convention II moves the intracell orbital-center phases into the basis states.", "Notes"], Cell["Initialize the model first so that the fractional orbital centers are known, or supply them with \"wcc\". An explicit list must follow the row and column order of H, and lets symhamII convert a user-supplied Hamiltonian without relying on the current init session. The transformation changes the matrix phases but not the energy spectrum.", "Notes"], Cell[BoxData[GridBox[{{Cell["      ", "TableRowIcon"], "\"wcc\"", "None", Cell["None uses the orbital centers prepared by init. An explicit list supplies one fractional center per Hamiltonian orbital in the same order as the rows and columns of H.", "TableText"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxDividers -> {"Rows" -> {{False}}}, GridBoxSpacings -> {"Columns" -> {Offset[0.27999999999999997], {Offset[0.7]}, Offset[0.27999999999999997]}, "Rows" -> {Offset[0.2], {Offset[0.8]}, Offset[0.2]}}]], "3ColumnTableMod"]}, Open]], Cell[CellGroupData[{Cell["Examples Initialization", "ExamplesInitializationSection"], Cell[BoxData["Needs[\"MagneticTB`\"]"], "ExampleInitialization"]}, Open]], Cell[CellGroupData[{Cell["Basic Examples", "PrimaryExamplesSection"], Cell["Construct graphene and display the same Hamiltonian in convention II:", "ExampleText"], Cell[BoxData["grapheneOperations = msgop[gray[191]];\ninit[\n  lattice -> {\n    {a, 0, 0},\n    {-a/2, Sqrt[3] a/2, 0},\n    {0, 0, c}\n  },\n  lattpar -> {a -> 1, c -> 3},\n  wyckoffposition -> {\n    {{1/3, 2/3, 0}, {0, 0, 0}}\n  },\n  symminformation -> grapheneOperations,\n  basisFunctions -> {{\"pz\"}}\n];\ngrapheneOnsite = symham[1];\ngrapheneNearest = symham[2];\ngrapheneNextNearest = symham[3];\ngrapheneHamiltonian =\n  grapheneOnsite + grapheneNearest + grapheneNextNearest;\nMatrixForm[\n  FullSimplify[\n    ExpToTrig[grapheneHamiltonian],\n    Element[{kx, ky, kz}, Reals]\n  ]\n];\nMatrixForm[symhamII[grapheneHamiltonian]]"], "Input"], Cell[BoxData[TagBox[RowBox[{"(", "\:2060", GridBox[{{RowBox[{"e1", "+", RowBox[{SuperscriptBox["\:f74d", RowBox[{RowBox[{"-", "\:f74e"}], " ", "kx"}]], " ", "r1"}], "+", RowBox[{SuperscriptBox["\:f74d", RowBox[{"\:f74e", " ", "kx"}]], " ", "r1"}], "+", RowBox[{SuperscriptBox["\:f74d", RowBox[{RowBox[{RowBox[{"-", "\:f74e"}], " ", "kx"}], "-", RowBox[{"\:f74e", " ", "ky"}]}]], " ", "r1"}], "+", RowBox[{SuperscriptBox["\:f74d", RowBox[{RowBox[{"\:f74e", " ", "kx"}], "+", RowBox[{"\:f74e", " ", "ky"}]}]], " ", "r1"}], "+", RowBox[{SuperscriptBox["\:f74d", RowBox[{RowBox[{"-", "\:f74e"}], " ", "ky"}]], " ", "r1"}], "+", RowBox[{SuperscriptBox["\:f74d", RowBox[{"\:f74e", " ", "ky"}]], " ", "r1"}]}], RowBox[{"t1", "+", RowBox[{SuperscriptBox["\:f74d", RowBox[{RowBox[{"-", "\:f74e"}], " ", "kx"}]], " ", "t1"}], "+", RowBox[{SuperscriptBox["\:f74d", RowBox[{"\:f74e", " ", "ky"}]], " ", "t1"}]}]}, {RowBox[{"t1", "+", RowBox[{SuperscriptBox["\:f74d", RowBox[{"\:f74e", " ", "kx"}]], " ", "t1"}], "+", RowBox[{SuperscriptBox["\:f74d", RowBox[{RowBox[{"-", "\:f74e"}], " ", "ky"}]], " ", "t1"}]}], RowBox[{"e1", "+", RowBox[{SuperscriptBox["\:f74d", RowBox[{RowBox[{"-", "\:f74e"}], " ", "kx"}]], " ", "r1"}], "+", RowBox[{SuperscriptBox["\:f74d", RowBox[{"\:f74e", " ", "kx"}]], " ", "r1"}], "+", RowBox[{SuperscriptBox["\:f74d", RowBox[{RowBox[{RowBox[{"-", "\:f74e"}], " ", "kx"}], "-", RowBox[{"\:f74e", " ", "ky"}]}]], " ", "r1"}], "+", RowBox[{SuperscriptBox["\:f74d", RowBox[{RowBox[{"\:f74e", " ", "kx"}], "+", RowBox[{"\:f74e", " ", "ky"}]}]], " ", "r1"}], "+", RowBox[{SuperscriptBox["\:f74d", RowBox[{RowBox[{"-", "\:f74e"}], " ", "ky"}]], " ", "r1"}], "+", RowBox[