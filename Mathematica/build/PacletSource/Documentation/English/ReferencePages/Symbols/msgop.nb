Notebook[{Cell[CellGroupData[{Cell["msgop", "ObjectName"], Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["msgop[group]"], "InlineFormula"], " \:2028", "reads the symmetry operations of a magnetic space group from the bundled database."}], "Usage"], Cell["Use gray[n] for a gray group. Type-I, type-III, and type-IV groups use complete BNS pairs: typeI[{n,m}], typeIII[{n,m}], and typeIV[{n,m}].", "Notes"], Cell["Each returned item is {label,R,t,flag}: R and t are the point and translation parts in fractional coordinates, and flag states whether the operation is unitary or antiunitary.", "Notes"], Cell["The list may be passed directly to symminformation in init. Its order is also the order used when displaying the corresponding representation matrices.", "Notes"]}, Open]], Cell[CellGroupData[{Cell["Examples Initialization", "ExamplesInitializationSection"], Cell[BoxData["Needs[\"MagneticTB`\"]"], "ExampleInitialization"]}, Open]], Cell[CellGroupData[{Cell["Basic Examples", "PrimaryExamplesSection"], Cell["Read gray magnetic space group 191 and inspect representative unitary and antiunitary records. Each record is {label, point matrix, translation, antiunitary flag}:", "ExampleText"], Cell[BoxData["operations191 = msgop[gray[191]];\noperations191[[{1, 2, 25}]]"], "Input"], Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"\"\\\"1\\\"\"", ",", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "\"F\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"\\\"6z\\\"\"", ",", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"1", ",", RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "\"F\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"\\\"1\\\"\"", ",", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "\"T\""}], "}"}]}], "}"}]], "Output"]}, Open]], Cell[CellGroupData[{Cell["Related Functions", "SeeAlsoSection"], Cell[TextData[{ButtonBox["gray", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/gray"], " \:25aa ", ButtonBox["typeI", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/typeI"], " \:25aa ", ButtonBox["typeIII", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/typeIII"], " \:25aa ", ButtonBox["typeIV", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/typeIV"], " \:25aa ", ButtonBox["init", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/init"]}], "SeeAlso"]}, Open]], Cell[CellGroupData[{Cell["Related Guides", "MoreAboutSection"], Cell[TextData[{ButtonBox["MagneticTB", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/guide/MagneticTB"]}], "MoreAbout"]}, Open]], Cell[CellGroupData[{Cell["Related Tutorials", "TutorialsSection"], Cell[TextData[{ButtonBox["Getting Started with MagneticTB", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/tutorial/GettingStarted"]}], "Tutorials"]}, Open]], Cell[CellGroupData[{Cell["History", "HistorySection"], Cell[TextData[{"New in: ", Cell["2.0.0", "HistoryData", CellTags -> "New"], " | Modified in: ", Cell[" ", "HistoryData", CellTags -> "Modified"], " | Obsolete in: ", Cell[" ", "HistoryData", CellTags -> "Obsolete"]}], "History"]}, Closed]], Cell[CellGroupData[{Cell["Categorization", "CategorizationSection"], Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], Cell["MagneticTB", "Categorization", CellLabel -> "Paclet Name"], Cell["MagneticTB`", "Categorization", CellLabel -> "Context"], Cell["MagneticTB/ref/msgop", "Categorization", CellLabel -> "URI"]}, Closed]], Cell[CellGroupData[{Cell["Keywords", "KeywordsSection"], Cell["magnetic space group", "Keywords"], Cell["symmetry operations", "Keywords"], Cell["BNS", "Keywords"], Cell["gray group", "Keywords"]}, Closed]]}, TaggingRules -> <|"Paclet" -> "MagneticTB"|>, WindowTitle -> "msgop", StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "FunctionPageStylesExt.nb", CharacterEncoding -> "UTF-8"]]