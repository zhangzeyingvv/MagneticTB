Notebook[{Cell[CellGroupData[{Cell["brokenSymmetryInitRules", "ObjectName"], Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["brokenSymmetryInitRules[generators]"], "InlineFormula"], " \:2028", "builds a new set of init rules for the subgroup generated by selected symmetry operations."}], "Usage"], Cell["Use this function when a term in the model preserves only part of the original symmetry. The selected operations generate the symmetry subgroup that is to remain, while all atoms are kept.", "Notes"], Cell["If the subgroup no longer relates all atoms of a Wyckoff orbit, that orbit is split into separate entries of the new wyckoffposition input.", "Notes"], Cell["The function only writes a new set of init rules; it does not change the model by itself. Check the new Wyckoff positions and symmetry operations, then evaluate init@@rules. Use {} when only the identity is to remain.", "Notes"]}, Open]], Cell[CellGroupData[{Cell["Examples Initialization", "ExamplesInitializationSection"], Cell[BoxData["Needs[\"MagneticTB`\"]"], "ExampleInitialization"]}, Open]], Cell[CellGroupData[{Cell["Basic Examples", "PrimaryExamplesSection"], Cell["Initialize graphene and return the initialization rules for the subgroup generated by operation 2:", "ExampleText"], Cell[BoxData["grapheneOperations = msgop[gray[191]];\ninit[\n  lattice -> {\n    {a, 0, 0},\n    {-a/2, Sqrt[3] a/2, 0},\n    {0, 0, c}\n  },\n  lattpar -> {a -> 1, c -> 3},\n  wyckoffposition -> {\n    {{1/3, 2/3, 0}, {0, 0, 0}}\n  },\n  symminformation -> grapheneOperations,\n  basisFunctions -> {{\"pz\"}}\n];\nbrokenRules = brokenSymmetryInitRules[{2}];\nbrokenRules"], "Input"], Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"lattice", "\:f522", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"a", ",", "0", ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{RowBox[{"-", FractionBox["a", "2"]}], ",", FractionBox[RowBox[{SqrtBox["3"], " ", "a"}], "2"], ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "0", ",", "c"}], "}"}]}], "}"}]}