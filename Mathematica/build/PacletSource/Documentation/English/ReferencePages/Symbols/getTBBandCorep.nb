Notebook[{Cell[CellGroupData[{Cell["getTBBandCorep", "ObjectName"], Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["getTBBandCorep[MSG,H,rules,kset]"], "InlineFormula"], " \:2028", "prints the MSGCorep band-corepresentation table at every supplied reciprocal-fractional k point."}], "Usage"], Cell["Call getMSGElemFromMSGCorep[MSG], then use exactly that ordered operation list in init. getTBBandCorep is supported only for this MSGCorep-generated route.", "Notes"], Cell["The basis selected by init fixes single- or double-valued treatment: a scalar basis such as s is single valued, while the explicit {sup,sdn} spinor basis is double valued.", "Notes"], Cell["kset is a nonempty list of three-component reciprocal-fractional points. The function returns Null and prints one k-name line and one Grid per point; the Grid, rather than an Association, is the public presentation result.", "Notes"], Cell["The optional MSGCorep and SpaceGroupIrep applications must be installed, and the user must execute Needs[\"MSGCorep`\"] before either MagneticTB wrapper is called. MagneticTB neither loads MSGCorep automatically nor replaces its calculation with an internal approximation.", "Notes"], Cell["getTBBandCorep returns $Failed and issues a message when the dependency is unavailable, the current init session is incompatible, H/rules/kset are malformed, or MSGCorep rejects the model. It does not repair the input or switch to an approximate fallback.", "Notes"]}, Open]], Cell[CellGroupData[{Cell["Examples Initialization", "ExamplesInitializationSection"], Cell[BoxData["Needs[\"MagneticTB`\"]"], "ExampleInitialization"]}, Open]], Cell[CellGroupData[{Cell["Basic Examples", "PrimaryExamplesSection"], Cell["For MSG {164,87}, initialize a double-valued spinor model and print corepresentations at Gamma, K, and A:", "ExampleText"], Cell[BoxData["Needs[\"MSGCorep`\"];\ncorepOperations = getMSGElemFromMSGCorep[{164, 87}];\ninit[\n  lattice -> {\n    {0, -a, 0},\n    {Sqrt[3] a/2, a/2, 0},\n    {0, 0, c}\n  },\n  lattpar -> {a -> 1, c -> 2},\n  wyckoffposition -> {{{0, 0, 0}, {0, 0, 0}}},\n  symminformation -> corepOperations,\n  basisFunctions -> {{\"sup\", \"sdn\"}},\n  InitialBondShells -> 1,\n  GenerateSymmetryGroup -> False\n];\ncorepHamiltonian = symham[1];\ngetTBBandCorep[\n  {164, 87}, corepHamiltonian, {e1 -> 0},\n  {{0, 0, 0}, {1/3, 1/3, 0}, {0, 0, 1/2}}\n]"], "Input"]}, Open]], Cell[CellGroupData[{Cell["More Examples", "ExtendedExamplesSection", CellTags -> "ExtendedExamples"], Cell[CellGroupData[{Cell["Applications", "ExampleSection"], Cell["The same nontrivial group with one scalar s orbital follows the single-valued MSGCorep route:", "ExampleText"], Cell[BoxData["Needs[\"MSGCorep`\"];\ncorepOperations = getMSGElemFromMSGCorep[{164, 87}];\ninit[\n  lattice -> {\n    {0, -a, 0},\n    {Sqrt[3] a/2, a/2, 0},\n    {0, 0, c}\n  },\n  lattpar -> {a -> 1, c -> 2},\n  wyckoffposition -> {{{0, 0, 0}, {0, 0, 0}}},\n  symminformation -> corepOperations,\n  basisFunctions -> {{\"s\"}},\n  InitialBondShells -> 1,\n  GenerateSymmetryGroup -> False\n];\ncorepHamiltonian = symham[1];\ngetTBBandCorep[\n  {164, 87}, corepHamiltonian, {e1 -> 0},\n  {{0, 0, 0}, {1/3, 1/3, 0}, {0, 0, 1/2}}\n]"], "Input"]}, Open]]}, Open]], Cell[CellGroupData[{Cell["Related Functions", "SeeAlsoSection"], Cell[TextData[{ButtonBox["getMSGElemFromMSGCorep", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/getMSGElemFromMSGCorep"], " \:25aa ", ButtonBox["orbitalTable", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/orbitalTable"]}], "SeeAlso"]}, Open]], Cell[CellGroupData[{Cell["Related Guides", "MoreAboutSection"], Cell[TextData[{ButtonBox["MagneticTB", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/guide/MagneticTB"]}], "MoreAbout"]}, Open]], Cell[CellGroupData[{Cell["Related Tutorials", "TutorialsSection"], Cell[TextData[{ButtonBox["Band corepresentations with MSGCorep", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/tutorial/Corepresentations"]}], "Tutorials"]}, Open]], Cell[CellGroupData[{Cell["History", "HistorySection"], Cell[TextData[{"New in: ", Cell["2.0.0", "HistoryData", CellTags -> "New"], " | Modified in: ", Cell[" ", "HistoryData", CellTags -> "Modified"], " | Obsolete in: ", Cell[" ", "HistoryData", CellTags -> "Obsolete"]}], "History"]}, Closed]], Cell[CellGroupData[{Cell["Categorization", "CategorizationSection"], Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], Cell["MagneticTB", "Categorization", CellLabel -> "Paclet Name"], Cell["MagneticTB`", "Categorization", CellLabel -> "Context"], Cell["MagneticTB/ref/getTBBandCorep", "Categorization", CellLabel -> "URI"]}, Closed]], Cell[CellGroupData[{Cell["Keywords", "KeywordsSection"], Cell["band corepresentation", "Keywords"], Cell["double group", "Keywords"], Cell["high-symmetry k point", "Keywords"]}, Closed]]}, TaggingRules -> <|"Paclet" -> "MagneticTB"|>, WindowTitle -> "getTBBandCorep", StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "FunctionPageStylesExt.nb", CharacterEncoding -> "UTF-8"]]