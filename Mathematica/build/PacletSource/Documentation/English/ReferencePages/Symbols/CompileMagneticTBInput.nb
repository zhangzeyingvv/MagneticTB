Notebook[{Cell[CellGroupData[{Cell["CompileMagneticTBInput", "ObjectName"], Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["CompileMagneticTBInput[input]"], "InlineFormula"], " \:2028", "checks and prepares program-generated MagneticTB input without making it the current model."}], "Usage"], Cell["Use this function when another program has already assembled the lattice, Wyckoff positions, symmetry operations, and local orbitals of a model. For an ordinary notebook calculation, init or initfromrep is simpler.", "Notes"], Cell["The string keys of input describe the same physical quantities used by init. The result lets the calling program inspect the generated sites, representation matrices, and bond geometry. It does not calculate any hopping parameter or replace the model currently used by symham.", "Notes"], Cell["When the program-generated input omits InitialBondShells, the testing-line default is 10 complete shells, matching init and initfromrep. An explicit value in the input Association always takes precedence.", "Notes"]}, Open]], Cell[CellGroupData[{Cell["Examples Initialization", "ExamplesInitializationSection"], Cell[BoxData["Needs[\"MagneticTB`\"]"], "ExampleInitialization"]}, Open]], Cell[CellGroupData[{Cell["Basic Examples", "PrimaryExamplesSection"], Cell["Here is a complete simple-cubic model in this input form. The output shows the lattice, generated sites, exact representation matrices, and first bond class:", "ExampleText"], Cell[BoxData["compilerInput = <|\n  \"Lattice\" -> {\n    {a, 0, 0},\n    {0, a, 0},\n    {0, 0, a}\n  },\n  \"LatticeParameters\" -> {a -> 1},\n  \"WyckoffPosition\" -> {\n    {{0, 0, 0}, {0, 0, 0}}\n  },\n  \"SymmetryInformation\" -> {\n    {\"E\", IdentityMatrix[3], {0, 0, 0}, \"F\"}\n  },\n  \"BasisFunctions\" -> {{\"s\"}},\n  \"Debug\" -> False,\n  \"InitialBondShells\" -> 2,\n  \"GenerateSymmetryGroup\" -> False,\n  \"RepresentationMode\" -> \"DirectProduct\",\n  \"SiteLocalData\" -> Automatic\n|>;\ncompiledModel = Co