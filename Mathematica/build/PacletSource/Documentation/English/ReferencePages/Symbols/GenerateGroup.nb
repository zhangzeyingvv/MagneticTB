Notebook[{Cell[CellGroupData[{Cell["GenerateGroup", "ObjectName"], Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["GenerateGroup[generators, identity, multiply]"], "InlineFormula"], " \:2028", "generates a complete finite group from its generators and an explicitly supplied multiplication law."}], "Usage"], Cell["For example, starting from one generator of C4, repeated multiplication produces its four elements. The returned list always begins with the identity; the trivial group is therefore {E}, not an empty list.", "Notes"], Cell["The caller supplies both multiplication and equality because magnetic-space-group and spin-space-group elements need not use the same concrete product.", "Notes"], Cell[BoxData[GridBox[{{Cell["      ", "TableRowIcon"], "SameTest", "SameQ", Cell["Binary predicate used to decide whether two generated concrete elements are equal. It must return True or False for every pair.", "TableText"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxDividers -> {"Rows" -> {{False}}}, GridBoxSpacings -> {"Columns" -> {Offset[0.27999999999999997], {Offset[0.7]}, Offset[0.27999999999999997]}, "Rows" -> {Offset[0.2], {Offset[0.8]}, Offset[0.2]}}]], "3ColumnTableMod"]}, Open]], Cell[CellGroupData[{Cell["Examples Initialization", "ExamplesInitializationSection"], Cell[BoxData["Needs[\"MagneticTB`\"]"], "ExampleInitialization"]}, Open]], Cell[CellGroupData[{Cell["Basic Examples", "PrimaryExamplesSection"], Cell["Generate the additive cyclic group C4 from the element 1:", "ExampleText"], Cell[BoxData["GenerateGroup[{1}, 0, Mod[#1 + #2, 4] &]"], "Input"], Cell[BoxData[RowBox[{"{", RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}]], "Output"]}, Open]], Cell[CellGroupData[{Cell["More Examples", "ExtendedExamplesSection", CellTags -> "ExtendedExamples"], Cell[CellGroupData[{Cell["Options", "ExampleSection"], Cell[CellGroupData[{Cell["SameTest", "ExampleSubsection"], Cell["SameTest can provide a domain-specific exact equality predicate; here it reproduces the same C4 ordering:", "ExampleText"], Cell[BoxData["GenerateGroup[{1}, 0, Mod[#1 + #2, 4] &, SameTest -> (#1 === #2 &)]"], "Input"], Cell[BoxData[RowBox[{"{", RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}]], "Output"]}, Open]]}, Open]]}, Open]], Cell[CellGroupData[{Cell["Related Functions", "SeeAlsoSection"], Cell[TextData[{ButtonBox["getGenerator", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/getGenerator"], " \:25aa ", ButtonBox["init", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/init"]}], "SeeAlso"]}, Open]], Cell[CellGroupData[{Cell["Related Guides", "MoreAboutSection"], Cell[TextData[{ButtonBox["MagneticTB", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/guide/MagneticTB"]}], "MoreAbout"]}, Open]], Cell[CellGroupData[{Cell["Related Tutorials", "TutorialsSection"], Cell[TextData[{ButtonBox["Getting Started with MagneticTB", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/tutorial/GettingStarted"]}], "Tutorials"]}, Open]], Cell[CellGroupData[{Cell["History", "HistorySection"], Cell[TextData[{"New in: ", Cell["2.0.0", "HistoryData", CellTags -> "New"], " | Modified in: ", Cell[" ", "HistoryData", CellTags -> "Modified"], " | Obsolete in: ", Cell[" ", "HistoryData", CellTags -> "Obsolete"]}], "History"]}, Closed]], Cell[CellGroupData[{Cell["Categorization", "CategorizationSection"], Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], Cell["MagneticTB", "Categorization", CellLabel -> "Paclet Name"], Cell["MagneticTB`", "Categorization", CellLabel -> "Context"], Cell["MagneticTB/ref/GenerateGroup", "Categorization", CellLabel -> "URI"]}, Closed]], Cell[CellGroupData[{Cell["Keywords", "KeywordsSection"], Cell["finite group", "Keywords"], Cell["generators", "Keywords"], Cell["closure", "Keywords"]}, Closed]]}, TaggingRules -> <|"Paclet" -> "MagneticTB"|>, WindowTitle -> "GenerateGroup", StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, "FunctionPageStylesExt.nb", CharacterEncoding -> "UTF-8"]]