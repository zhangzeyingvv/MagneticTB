3ba", "\:f3ba", "\:f3ba"}, {"\"H index\"", "\"Site\"", "\"Wyckoff orbit\"", "\"Atom\"", "\"Fractional position\"", "\"Cartesian position\"", "\"Local orbital\"", "\"Input basis\"", "\"Actual basis state\"", "\"Spin structure\"", "\"Spin state\"", "\"Transport operation\""}, {"1", "1", "1", "1", RowBox[{"{", RowBox[{FractionBox["1", "2"], ",", "0", ",", "0"}], "}"}], RowBox[{"{", RowBox[{FractionBox["1", "2"], ",", "0", ",", "0"}], "}"}], "1", "\"px\"", "x", "\"Spinless\"", "None", "None"}, {"2", "1", "1", "1", RowBox[{"{", RowBox[{FractionBox["1", "2"], ",", "0", ",", "0"}], "}"}], RowBox[{"{", RowBox[{FractionBox["1", "2"], ",", "0", ",", "0"}], "}"}], "2", "\"py\"", "y", "\"Spinless\"", "None", "None"}, {"3", "1", "1", "1", RowBox[{"{", RowBox[{FractionBox["1", "2"], ",", "0", ",", "0"}], "}"}], RowBox[{"{", RowBox[{FractionBox["1", "2"], ",", "0", ",", "0"}], "}"}], "3", "\"pz\"", "z", "\"Spinless\"", "None", "None"}, {"4", "2", "1", "2", RowBox[{"{", RowBox[{"0", ",", FractionBox["1", "2"], ",", "0"}], "}"}], RowBox[{"{", RowBox[{"0", ",", FractionBox["1", "2"], ",", "0"}], "}"}], "1", "\"px\"", "x", "\"Spinless\"", "None", "None"}, {"5", "2", "1", "2", RowBox[{"{", RowBox[{"0", ",", FractionBox["1", "2"], ",", "0"}], "}"}], RowBox[{"{", RowBox[{"0", ",", FractionBox["1", "2"], ",", "0"}], "}"}], "2", "\"py\"", "y", "\"Spinless\"", "None", "None"}, {"6", "2", "1", "2", RowBox[{"{", RowBox[{"0", ",", FractionBox["1", "2"], ",", "0"}], "}"}], RowBox[{"{", RowBox[{"0", ",", FractionBox["1", "2"], ",", "0"}], "}"}], "3", "\"pz\"", "z", "\"Spinless\"", "None", "None"}, {"7", "3", "1", "3", RowBox[{"{", RowBox[{"0", ",", "0", ",", FractionBox["1", "2"]}], "}"}], RowBox[{"{", RowBox[{"0", ",", "0", ",", FractionBox["1", "2"]}], "}"}], "1", "\"px\"", "x", "\"Spinless\"", "None", "None"}, {"8", "3", "1", "3", RowBox[{"{", RowBox[{"0", ",", "0", ",", FractionBox["1", "2"]}], "}"}], RowBox[{"{", RowBox[{"0", ",", "0", ",", FractionBox["1", "2"]}], "}"}], "2", "\"py\"", "y", "\"Spinless\"", "None", "None"}, {"9", "3", "1", "3", RowBox[{"{", RowBox[{"0", ",", "0", ",", FractionBox["1", "2"]}], "}"}], RowBox[{"{", RowBox[{"0", ",", "0", ",", FractionBox["1", "2"]}], "}"}], "3", "\"pz\"", "z", "\"Spinless\"", "None", "None"}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Grid"]], "Output"], Cell["For the same cubic Wyckoff orbit, RepresentationMode -> \"Induced\" needs only the reference px orbital at {1/2, 0, 0}. Cubic symmetry transports it to the corresponding py and pz states at the other equivalent sites, as the orbital table shows:", "ExampleText"], Cell[BoxData["cubicOperations = msgop[gray[221]];\ninit[\n  lattice -> {\n    {a, 0, 0},\n    {0, a, 0},\n    {0, 0, a}\n  },\n  lattpar -> {a -> 1},\n  wyckoffposition -> {\n    {{1/2, 0, 0}, {0, 0, 0}}\n  },\n  symminformation -> cubicOperations,\n  basisFunctions -> {{\"px\"}},\n  RepresentationMode -> \"Induced\"\n];\norbitalTable[]"], "Input"], Cell[BoxData[TagBox[GridBox[{{TemplateBox[{"\"Hamiltonian dimension = \"", "3", "\"; representation mode = \"", "\"Induced\""}, "RowDefault"], "\:f3ba", "\:f3ba", "\:f3ba", "\:f3ba", "\:f3ba", "\:f3ba", "\:f3ba", "\:f3ba", "\:f3ba", "\:f3ba", "\:f3ba"}, {"\"H index\"", "\"Site\"", "\"Wyckoff orbit\"", "\"Atom\"", "\"Fractional position\"", "\"Cartesian position\"", "\"Local orbital\"", "\"Input basis\"", "\"Actual basis state\"", "\"Spin structure\"", "\"Spin state\"", "\"Transport operation\""}, {"1", "1", "1", "1", RowBox[{"{", RowBox[{FractionBox["1", "2"], ",", "0", ",", "0"}], "}"}], RowBox[{"{", RowBox[{FractionBox["1", "2"], ",", "0", ",", "0"}], "}"}], "1", "\"px\"", "x", "\"Spinless\"", "None", TemplateBox[{"1", "\": \"", "\"\\\"1\\\"\""}, "RowDefault"]}, {"2", "2", "1", "2", RowBox[{"{", RowBox[{"0", ",", FractionBox["1", "2"], ",", "0"}], "}"}], RowBox[{"{", RowBox[{"0", ",",