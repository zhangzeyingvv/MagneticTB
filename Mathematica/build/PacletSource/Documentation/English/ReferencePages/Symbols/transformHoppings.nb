Notebook[{Cell[CellGroupData[{Cell["transformHoppings", "ObjectName"], Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["transformHoppings[data,T]"], "InlineFormula"], " \:2028", "rewrites complete numerical hopping blocks in the exact integer cell whose direct-lattice rows are T times the old rows."}], "Usage"], Cell["T must be a nonsingular 3 by 3 integer matrix. Exact Smith decomposition enumerates all cell representatives; no real-space cutoff is introduced.", "Notes"], Cell["The returned Association has Abs[Det[T]] times the original orbital dimension and, when available, transformed lattice vectors and Wannier centers.", "Notes"], Cell["transformHoppings returns $Failed and issues a message when the hopping Association/path is incomplete, T is not a nonsingular integer matrix, center/lattice metadata are malformed, or the Hermiticity residual exceeds the requested tolerance. It does not repair the input or switch to an approximate fallback.", "Notes"], Cell[BoxData[GridBox[{{Cell["      ", "TableRowIcon"], "\"WannierCenters\"", "Automatic", Cell["Automatic uses centers stored in data; None omits them; an explicit list supplies one fractional three-vector per input orbital.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"Lattice\"", "Automatic", Cell["Automatic uses the stored row-vector lattice; None omits it; an explicit real numerical 3 by 3 matrix replaces it.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"HermiticityTolerance\"", "10^-9", Cell["Nonnegative numerical tolerance for H(R)=H(-R)^dagger before the exact cell transform.", "TableText"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxDividers -> {"Rows" -> {{False}}}, GridBoxSpacings -> {"Columns" -> {Offset[0.27999999999999997], {Offset[0.7]}, Offset[0.27999999999999997]}, "Rows" -> {Offset[0.2], {Offset[0.8]}, Offset[0.2]}}]], "3ColumnTableMod"]}, Open]], Cell[CellGroupData[{Cell["Examples Initialization", "ExamplesInitializationSection"], Cell[BoxData["Needs[\"MagneticTB`\"]"], "ExampleInitialization"]}, Open]], Cell[CellGroupData[{Cell["Basic Examples", "PrimaryExamplesSection"], Cell["Build the tetragonal gray-group 75 hopping model used below:", "ExampleText"], Cell[BoxData["chainOperations = msgop[gray[75]];\ninit[\n  lattice -> {{a,0,0},{0,a,0},{0,0,c}},\n  lattpar -> {a -> 3,c -> 1},\n  wyckoffposition -> {{{0,0,0},{0,0,0}}},\n  symminformation -> chainOperations,\n  basisFunctions -> {{\"s\"}},\n  InitialBondShells -> 2,\n  GenerateSymmetryGroup -> False\n];\nchainHamiltonian = symham[1] + symham[2];\nchainData = hoppingData[\n  {1,2},\n  {e1 -> 0., t1 -> 1.}\n];"], "Input"], Cell["Double the chain cell along axis 3. The transformed model contains two orbitals per new cell:", "ExampleText"], Cell[BoxData["transformed = transformHoppings[chainData, DiagonalMatrix[{1, 1, 2}]];\nKeyTake[transformed, {\"NumWannier\", \"CellVolumeFactor\", \"Lattice\", \"WannierCenters\"}]"], "Input"], Cell[BoxData[RowBox[{"\:f113", RowBox[{RowBox[{"\"NumWannier\"", "\:f522", "2"}], ",", RowBox[{"\"CellVolumeFactor\"", "\:f522", "2"}], ",", RowBox[{"\"Lattice\"", "\:f522", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"3", ",", "0", ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "3", ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "0", ",", "2"}], "}"}]}], "}"}]}], ",", RowBox[{"\"WannierCenters\"", "\:f522", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "0", ",", FractionBox["1", "2"]}], "}"}]}], "}"}]}]}], "\:f114"}]], "Output"]}, Open]], Cell[CellGroupData[{Cell["More Examples", "ExtendedExamplesSection", CellTags -> "ExtendedExamples"], Cell[CellGroupData[{Cell["Options", "ExampleSection"], Cell[CellGroupData[{Cell["WannierCenters", "ExampleSubsection"], Cell["\"WannierCenters\" - uses explicit orbital centers instead of metadata stored in the input.", "ExampleText"], Cell[BoxData["KeyTake[transformHoppings[chainData, DiagonalMatrix[{1,1,2}], \"WannierCenters\" -> {{1/4,0,0}}], {\"NumWannier\", \"WannierCenters\"}]"], "Input"], Cell[BoxData[RowBox[{"\:f113", RowBox[{RowBox[{"\"NumWannier\"", "\:f522", "2"}], ",", RowBox[{"\"WannierCenters\"", "\:f522", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{FractionBox["1", "4"], ",", "0", ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{FractionBox["1", "4"], ",", "0", ",", FractionBox["1", "2"]}], "}"}]}], "}"}]}]}], "\:f114"}]], "Output"]}, Open]], Cell[CellGroupData[{Cell["Lattice", "ExampleSubsection"], Cell["\"Lattice\" - uses an explicit old direct lattice and returns the transformed row vectors.", "ExampleText"], Cell[BoxData["KeyTake[transformHoppings[chainData, DiagonalMatrix[{1,1,2}], \"Lattice\" -> DiagonalMatrix[{2,2,3}]], {\"Lattice\"}]"], "Input"], Cell[BoxData[RowBox[{"\:f113", RowBox[{"\"Lattice\"", "\:f522", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"2", ",", "0", ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "2", ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "0", ",", "6"}], "}"}]}], "}"}]}], "\:f114"}]], "Output"]}, Open]], Cell[CellGroupData[{Cell["HermiticityTolerance", "ExampleSubsection"], Cell["\"HermiticityTolerance\" - checks the input hopping table against the stated numerical tolerance.", "ExampleText"], Cell[BoxData["KeyTake[transformHoppings[chainData, IdentityMatrix[3], \"HermiticityTolerance\" -> 10^-12], {\"NumWannier\", \"HermitianResidual\"}]"], "Input"], Cell[BoxData[RowBox[{"\:f113", RowBox[{RowBox[{"\"NumWannier\"", "\:f522", "1"}], ",", RowBox[{"\"HermitianResidual\"", "\:f522", "0.`"}]}], "\:f114"}]], "Output"]}, Open]]}, Open]]}, Open]], Cell[CellGroupData[{Cell["Related Functions", "SeeAlsoSection"], Cell[TextData[{ButtonBox["hoppingData", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/hoppingData"], " \:25aa ", ButtonBox["buildBlochHamiltonian", BaseStyle -> "Link", ButtonData -> "paclet:MagneticTB/ref/buildBlochHamiltonian"]}], "SeeAlso"]}, Open]], Cell[CellGroupData[{Cell["Related Guides", "MoreAboutSection"], Cell[TextData[{